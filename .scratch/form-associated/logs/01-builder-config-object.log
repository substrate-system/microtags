{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PirZAfodZL4qox41v66wvV","type":"tool_result","content":"1\timport type { StandardSchemaV1 } from '@standard-schema/spec'\n2\timport type { Markup } from './htm.js'\n3\timport type { Markup as BrowserMarkup } from './htm.browser.js'\n4\timport type {\n5\t    PropDef,\n6\t    PropType,\n7\t    PropertyOnlyProp,\n8\t    SetupContext,\n9\t    Coercer,\n10\t    RefDef,\n11\t    SingleRefDef,\n12\t    MultipleRefDef,\n13\t    RefsMap,\n14\t    ContextToken,\n15\t    ContextsMap,\n16\t} from './types.js'\n17\timport {\n18\t    coerceNumber,\n19\t    coerceString,\n20\t    coerceBoolean,\n21\t    coerceJson,\n22\t} from './util.js'\n23\timport { factory } from './factory.js'\n24\t// The serializer kind is decided here, by coercer identity, so the\n25\t// server render support module never compares coercers from another\n26\t// copy of the package.\n27\texport type PropKind =\n28\t    'prop-only' | 'schema' | 'boolean' | 'json' | 'coercer'\n29\t\n30\texport interface PropMeta {\n31\t    kind:PropKind\n32\t    coercer:Coercer<unknown>\n33\t}\n34\t\n35\t/**\n36\t * What a `render` static hands the server render support module: tag,\n37\t * prop metadata, ref names and the render function. This shape is a\n38\t * contract between package copies; changing it needs a new symbol key.\n39\t */\n40\texport interface RenderRecord {\n41\t    t:string\n42\t    m:Record<string, PropMeta>\n43\t    r:Record<string, string>\n44\t    f:RenderFn<any, any>\n45\t}\n46\t\n47\t/** The DSL object passed to the withProps callback. */\n48\texport type PropDSL = {\n49\t    number():Coercer<number>\n50\t    string():Coercer<string>\n51\t    boolean():Coercer<boolean>\n52\t    json<T>():Coercer<T | undefined>\n53\t    schema<T>(validator:StandardSchemaV1<unknown, T>):StandardSchemaV1<unknown, T>\n54\t    prop<T>(initial:T):PropertyOnlyProp<T>\n55\t}\n56\t\n57\texport const propDSL:PropDSL = {\n58\t    number: () => coerceNumber,\n59\t    string: () => coerceString,\n60\t    boolean: () => coerceBoolean,\n61\t    json: <T>() => coerceJson as Coercer<T | undefined>,\n62\t    schema: <T>(v:StandardSchemaV1<unknown, T>) => v,\n63\t    prop: <T>(initial:T):PropertyOnlyProp<T> => (\n64\t        { _microtag: 'prop', initial }\n65\t    ),\n66\t}\n67\t\n68\t/**\n69\t * DSL object passed to the withRefs callback.\n70\t * Call `r.one()` for a single element or `r.all()` for multiple. Pass a\n71\t * CSS selector to query by it, or omit it to match `[data-ref=\"<key>\"]`.\n72\t *\n73\t * Element typing:\n74\t * - `r.one()` defaults to `HTMLElement`.\n75\t * - `r.one<T>()` sets the type and keeps the `[data-ref]` selector.\n76\t * - `r.one('button')` infers the type from the tag AND queries by that\n77\t *   tag, exactly like `document.querySelector('button')`.\n78\t */\n79\texport type RefsDSL = {\n80\t    one<K extends keyof HTMLElementTagNameMap>(\n81\t        selector:K\n82\t    ):SingleRefDef<HTMLElementTagNameMap[K]>\n83\t    one<T extends HTMLElement = HTMLElement>(selector?:string):SingleRefDef<T>\n84\t\n85\t    all<K extends keyof HTMLElementTagNameMap>(\n86\t        selector:K\n87\t    ):MultipleRefDef<HTMLElementTagNameMap[K]>\n88\t    all<T extends HTMLElement = HTMLElement>(selector?:string):MultipleRefDef<T>\n89\t}\n90\t\n91\texport const refsDSL:RefsDSL = {\n92\t    one: ((selector?:string):SingleRefDef => (\n93\t        { _microtag: 'ref:one', selector }\n94\t    )) as RefsDSL['one'],\n95\t    all: ((selector?:string):MultipleRefDef => (\n96\t        { _microtag: 'ref:all', selector }\n97\t    )) as RefsDSL['all'],\n98\t}\n99\t\n100\t/**\n101\t * DSL object passed to the withContexts callback.\n102\t * Currently a no-op placeholder; the user references imported\n103\t * context tokens directly in the returned record.\n104\t */\n105\texport type ContextDSL = Record<never, never>\n106\tconst contextDSL:ContextDSL = {}\n107\t\n108\t/**\n109\t * Maps each declared ref key to its own name as