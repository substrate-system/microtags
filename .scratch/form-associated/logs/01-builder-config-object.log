5\t> = (\n166\t    props:RenderProps<Props>,\n167\t    options?:{ children?:string; attrs?:Record<string, string> }\n168\t) => RenderParts\n169\t\n170\t/**\n171\t * A host element: an `HTMLElement` with a property accessor for each\n172\t * declared prop, typed as the prop's value. A signal bound with\n173\t * `bindProp` makes the prop read through to it.\n174\t */\n175\texport type MicrotagHost<\n176\t    Props extends Record<string, PropDef> = Record<never, never>,\n177\t> = HTMLElement & RenderProps<Props>\n178\t\n179\t/**\n180\t * A registered custom element class that also exposes, as static members,\n181\t * the tag name it was registered under (`TAG`) and the names of its\n182\t * declared refs (`refs`).\n183\t */\n184\texport type MicrotagElementClass<\n185\t    Props extends Record<string, PropDef> = Record<never, never>,\n186\t    RefDefs extends Record<string, RefDef> = Record<never, never>,\n187\t> = {\n188\t    new ():MicrotagHost<Props>\n189\t    readonly prototype:MicrotagHost<Props>\n190\t    /** The custom element tag name, e.g. 'my-counter'. */\n191\t    readonly TAG:string\n192\t    /**\n193\t     * The declared ref names, each mapping to its own `data-ref` string.\n194\t     * Lets server-rendered markup reference refs by key instead of a magic\n195\t     * string: `MyCounter.refs.dec`.\n196\t     */\n197\t    readonly refs:RefNames<RefDefs>\n198\t    readonly render:StaticRenderFn<Props>\n199\t    readonly renderParts:StaticRenderPartsFn<Props>\n200\t    readonly props:readonly (keyof Props & string)[]\n201\t}\n202\t\n203\t/**\n204\t * Fluent builder that accumulates props/refs/contexts config\n205\t * before registering a custom element via `.setup()`.\n206\t */\n207\texport class ComponentBuilder<\n208\t    Props extends Record<string, PropDef> = Record<never, never>,\n209\t    RefDefs extends Record<string, RefDef> = Record<never, never>,\n210\t    CtxDefs extends Record<string, ContextToken<unknown>> = Record<never, never>,\n211\t> {\n212\t    private readonly _coercers:Record<string, Coercer<unknown>>\n213\t    private readonly _observed:string[]\n214\t    private readonly _propNames:string[]\n215\t    private readonly _propMetas:Record<string, PropMeta>\n216\t    private readonly _refDefs:Record<string, RefDef>\n217\t    private readonly _ctxDefs:Record<string, ContextToken<unknown>>\n218\t    private readonly _renderFn?:RenderFn<Props, RefDefs>\n219\t\n220\t    constructor (\n221\t        readonly tagName:string,\n222\t        coercers:Record<string, Coercer<unknown>> = {},\n223\t        observed:string[] = [],\n224\t        refDefs:Record<string, RefDef> = {},\n225\t        ctxDefs:Record<string, ContextToken<unknown>> = {},\n226\t        propNames:string[] = [],\n227\t        propMetas:Record<string, PropMeta> = {},\n228\t        renderFn?:RenderFn<any, any>,\n229\t    ) {\n230\t        this._coercers = coercers\n231\t        this._observed = observed\n232\t        this._propNames = propNames\n233\t        this._propMetas = propMetas\n234\t        this._refDefs = refDefs\n235\t        this._ctxDefs = ctxDefs\n236\t        this._renderFn = renderFn as\n237\t            RenderFn<Props, RefDefs> | undefined\n238\t    }\n239\t\n240\t    /**\n241\t     * The custom element tag name, e.g. 'my-counter'. Available at every\n242\t     * point in the fluent chain since each builder method returns a new\n243\t     * builder carrying the same tag name.\n244\t     */\n245\t    get TAG ():string {\n246\t        return this.tagName\n247\t    }\n248\t\n249\t    withProps<P extends Record<string, PropDef>> (\n250\t        fn:(p:PropDSL) => P\n251\t    ):ComponentBuilder<P, RefDefs, CtxDefs> {\n252\t        const defs = fn(propDSL)\n253\t        const coercers:Record<string, Coercer<unknown>> = {}\n254\t        const observed:string[] = []\n255\t        const propNames:string[] = []\n256\t        const propMetas:Record<string, PropMeta> = {}\n257\t\n258\t        for (const [name, def] of Object.entries(defs)) {\n25