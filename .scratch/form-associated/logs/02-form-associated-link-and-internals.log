t loaded through the render link (amends ADR-005) | 2026-10-14 |\n| [ADR-010][adr-010] | Preact owns the host, the element owns its children | 2026-11-08 |\n| [ADR-011][adr-011] | Core renders an empty host with a kept render link (amends ADR-010) | 2026-11-10 |\n| [ADR-012][adr-012] | Form-associated custom elements | 2026-11-24 |\n\n[adr-006]: ADR-006-hono-html-scaffold.md\n[adr-007]: ADR-007-client-templater.md\n[adr-008]: ADR-008-serialized-server-state.md\n[adr-009]: ADR-009-server-render-support-through-render-link.md\n[adr-010]: ADR-010-preact-adapter-ownership-split.md\n[adr-011]: ADR-011-core-renders-empty-host.md\n","structuredPatch":[{"oldStart":25,"oldLines":3,"newStart":25,"newLines":4,"lines":[" [adr-009]: ADR-009-server-render-support-through-render-link.md"," [adr-010]: ADR-010-preact-adapter-ownership-split.md"," [adr-011]: ADR-011-core-renders-empty-host.md","+[adr-012]: ADR-012-form-associated-components.md"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01XiR8WCPBjPQPxpqhcSeUta","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
