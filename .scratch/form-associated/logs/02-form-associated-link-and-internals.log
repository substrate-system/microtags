pType<Defs[K]>>\n58\t}\n59\t\n60\t/** Opaque token identifying a context. */\n61\texport interface ContextToken<T> {\n62\t    readonly _type?:T\n63\t    readonly id:symbol\n64\t}\n65\t\n66\t/** Infer the value type from a ContextToken. */\n67\texport type ContextValue<Tok> =\n68\t    Tok extends ContextToken<infer T> ? T : never\n69\t\n70\t/** Map a record of ContextTokens to their resolved values. */\n71\texport type ContextsMap<Tokens extends Record<string, ContextToken<unknown>>> = {\n72\t    [K in keyof Tokens]: ContextValue<Tokens[K]> | undefined\n73\t}\n74\t\n75\t/**\n76\t * The shape every ref marker shares. Used as the constraint for `withRefs`\n77\t * and `RefsMap`. It deliberately omits the phantom `_type`, so it provides\n78\t * no inference site that could pin the element type during inference — this\n79\t * is what lets an un-annotated `r.one()` fall back to the `HTMLElement`\n80\t * default instead of collapsing to `Element`.\n81\t */\n82\texport interface RefDef {\n83\t    readonly _microtag:'ref:one' | 'ref:all'\n84\t    readonly selector?:string\n85\t}\n86\t\n87\t/**\n88\t * Marker: a single element. Resolved by the optional CSS `selector`,\n89\t * or by `[data-ref=\"<key>\"]` when no selector is given. The phantom `T`\n90\t * carries the resolved element type to `RefsMap`.\n91\t */\n92\texport interface SingleRefDef<T extends HTMLElement = HTMLElement>\n93\t    extends RefDef {\n94\t    readonly _microtag:'ref:one'\n95\t    /** Phantom only: carries the element type for RefsMap. Never set. */\n96\t    readonly _type?:T\n97\t}\n98\t\n99\t/**\n100\t * Marker: all matching elements. Resolved by the optional CSS `selector`,\n101\t * or by `[data-ref=\"<key>\"]` when no selector is given. The phantom `T`\n102\t * carries the resolved element type to `RefsMap`.\n103\t */\n104\texport interface MultipleRefDef<T extends HTMLElement = HTMLElement>\n105\t    extends RefDef {\n106\t    readonly _microtag:'ref:all'\n107\t    /** Phantom only: carries the eleme