{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015BmykV7PAcHvzN95Li32Ds","type":"tool_result","content":"1\timport type { StandardSchemaV1 } from '@standard-schema/spec'\n2\timport type { Markup } from './htm.js'\n3\timport type { Markup as BrowserMarkup } from './htm.browser.js'\n4\timport type {\n5\t    PropDef,\n6\t    PropType,\n7\t    PropertyOnlyProp,\n8\t    SetupContext,\n9\t    Coercer,\n10\t    RefDef,\n11\t    SingleRefDef,\n12\t    MultipleRefDef,\n13\t    RefsMap,\n14\t    ContextToken,\n15\t    ContextsMap,\n16\t} from './types.js'\n17\timport {\n18\t    coerceNumber,\n19\t    coerceString,\n20\t    coerceBoolean,\n21\t    coerceJson,\n22\t} from './util.js'\n23\timport { factory } from './factory.js'\n24\t// The serializer kind is decided here, by coercer identity, so the\n25\t// server render support module never compares coercers from another\n26\t// copy of the package.\n27\texport type PropKind =\n28\t    'prop-only' | 'schema' | 'boolean' | 'json' | 'coercer'\n29\t\n30\texport interface PropMeta {\n31\t    kind:PropKind\n32\t    coercer:Coercer<unknown>\n33\t}\n34\t\n35\t/**\n36\t * What a `render` static hands the server render support module: tag,\n37\t * prop metadata, ref names and the render function. This shape is a\n38\t * contract between package copies; changing it needs a new symbol key.\n39\t */\n40\texport interface RenderRecord {\n41\t    t:string\n42\t    m:Record<string, PropMeta>\n43\t    r:Record<string, string>\n44\t    f:RenderFn<any, any>\n45\t}\n46\t\n47\t/** The DSL object passed to the withProps callback. */\n48\texport type PropDSL = {\n49\t    number():Coercer<number>\n50\t    string():Coercer<string>\n51\t    boolean():Coercer<boolean>\n52\t    json<T>():Coercer<T | undefined>\n53\t    schema<T>(validator:StandardSchemaV1<unknown, T>):StandardSchemaV1<unknown, T>\n54\t    prop<T>(initial:T):PropertyOnlyProp<T>\n55\t}\n56\t\n57\texport const propDSL:PropDSL = {\n58\t    number: () => coerceNumber,\n59\t    string: () => coerceString,\n60\t    boolean: () => coerceBoolean,\n61\t    json: <T>() => coerceJson as Coercer<T | undefined>,\n62\t    schema: <T>(v:StandardSchemaV1<unknown, T>) => v,\n63\t    prop: <T>(initial:T):PropertyOnlyProp<T> => (\n64\t        { _microtag: 'prop', initial }\n65\t    ),\n66\t}\n67\t\n68\t/**\n69\t * DSL object passed to the withRefs callback.\n70\t * Call `r.one()` for a single element or `r.all()` for multiple. Pass a\n71\t * CSS selector to query by it, or omit it to match `[data-ref=\"<key>\"]`.\n72\t *\n73\t * Element typing:\n74\t * - `r.one()` defaults to `HTMLElement`.\n75\t * - `r.one<T>()` sets the type and keeps the `[data-ref]` selector.\n76\t * - `r.one('button')` infers the type from the tag AND queries by that\n77\t *   tag, exactly like `document.querySelector('button')`.\n78\t */\n79\texport type RefsDSL = {\n80\t    one<K extends keyof HTMLElementTagNameMap>(\n81\t        selector:K\n82\t    ):SingleRefDef<HTMLElementTagNameMap[K]>\n83\t    one<T extends HTMLElement = HTMLElement>(selector?:string):SingleRefDef<T>\n84\t\n85\t    all<K extends keyof HTMLElementTagNameMap>(\n86\t        selector:K\n87\t    ):MultipleRefDef<HTMLElementTagNameMap[K]>\n88\t    all<T extends HTMLElement = HTMLElement>(selector?:string):MultipleRefDef<T>\n89\t}\n90\t\n91\texport const refsDSL:RefsDSL = {\n92\t    one: ((selector?:string):SingleRefDef => (\n93\t        { _microtag: 'ref:one', selector }\n94\t    )) as RefsDSL['one'],\n95\t    all: ((selector?:string):MultipleRefDef => (\n96\t        { _microtag: 'ref:all', selector }\n97\t    )) as RefsDSL['all'],\n98\t}\n99\t\n100\t/**\n101\t * DSL object passed to the withContexts callback.\n102\t * Currently a no-op placeholder; the user references imported\n103\t * context tokens directly in the returned record.\n104\t */\n105\texport type ContextDSL = Record<never, never>\n106\tconst contextDSL:ContextDSL = {}\n107\t\n108\t/**\n109\t * Maps each declared ref key to its own name as a string literal. Exposed\n110\t * as the static `refs` on a registered element so server-rendered templates\n111\t * can fill in `data-ref` values without hardcoding the names, e.g.\n112\t * `data-ref=\"${MyCounter.refs.dec}\"`.\n113\t */\n114\texport type RefNames<RefDefs extends Record<string, RefDef>> = {\n115\t    readonly [K in keyof RefDefs]:K & string\n116\t}\n117\t\n118\t/** Plain values for props (not signals) in the render context. */\n119\texport type RenderProps<Defs extends Record<string, PropDef>> = {\n120\t    [K in keyof Defs]:PropType<Defs[K]>\n121\t}\n122\t\n123\texport interface RenderContext<\n124\t    Props extends Record<string, PropDef> = Record<never, never>,\n125\t    RefDefs extends Record<string, RefDef> = Record<never, never>,\n126\t> {\n127\t    props:RenderProps<Props>\n128\t    refs:RefNames<RefDefs>\n129\t    TAG:string\n130\t    children:string\n131\t    attrs:Record<string, string>\n132\t}\n133\t\n134\texport type RenderFn<\n135\t    Props extends Record<string, PropDef> = Record<never, never>,\n136\t    RefDefs extends Record<string, RefDef> = Record<never, never>,\n137\t> = (\n138\t    ctx:RenderContext<Props, RefDefs>\n139\t) => string | Markup | BrowserMarkup\n140\t\n141\texport interface RenderOptions {\n142\t    client?:boolean\n143\t}\n144\t\n145\texport type StaticRenderFn<\n146\t    Props extends Record<string, PropDef>,\n147\t> = (\n148\t    props:RenderProps<Props>,\n149\t    options?:{ children?:string; attrs?:Record<string, string> }\n150\t) => string\n151\t\n152\t/**\n153\t * A component's server render as parts: the host tag name, its\n154\t * serialized host attributes (declared props first, then extra attrs,\n155\t * unescaped; a true boolean is the empty string) and the inner HTML.\n156\t */\n157\texport interface RenderParts {\n158\t    tag:string\n159\t    attrs:Record<string, string>\n160\t    html:string\n161\t}\n162\t\n163\texport type StaticRenderPartsFn<\n164\t    Props extends Record<string, PropDef>,\n165\t> = (\n166\t    props:RenderProps<Props>,\n167\t    options?:{ children?:string; attrs?:Record<string, string> }\n168\t) => RenderParts\n169\t\n170\t/**\n171\t * A host element: an `HTMLElement` with a property accessor for each\n172\t * declared prop, typed as the prop's value. A signal bound with\n173\t * `bindProp` makes the prop read through to it.\n174\t */\n175\texport type MicrotagHost<\n176\t    Props extends Record<string, PropDef> = Record<never, never>,\n177\t> = HTMLElement & RenderProps<Props>\n178\t\n179\t/**\n180\t * A registered custom element class that also exposes, as static members,\n181\t * the tag name it was registered under (`TAG`) and the names of its\n182\t * declared refs (`refs`).\n183\t */\n184\texport type MicrotagElementClass<\n185\t    Props extends Record<string, PropDef> = Record<never, never>,\n186\t    RefDefs extends Record<string, RefDef> = Record<never, never>,\n187\t> = {\n188\t    new ():MicrotagHost<Props>\n189\t    readonly prototype:MicrotagHost<Props>\n190\t    /** The custom element tag name, e.g. 'my-counter'. */\n191\t    readonly TAG:string\n192\t    /**\n193\t     * The declared ref names, each mapping to its own `data-ref` string.\n194\t     * Lets server-rendered markup reference refs by key instead of a magic\n195\t     * string: `MyCounter.refs.dec`.\n196\t     */\n197\t    readonly refs:RefNames<RefDefs>\n198\t    readonly render:StaticRenderFn<Props>\n199\t    readonly renderParts:StaticRenderPartsFn<Props>\n200\t    readonly props:readonly (keyof Props & string)[]\n201\t}\n202\t\n203\t/**\n204\t * Fluent builder that accumulates props/refs/contexts config\n205\t * before registering a custom element via `.setup()`.\n206\t */\n207\tinterface BuilderConfig {\n208\t    tag:string\n209\t    coercers:Record<string, Coercer<unknown>>\n210\t    observed:string[]\n211\t    propNames:string[]\n212\t    propMetas:Record<string, PropMeta>\n213\t    refDefs:Record<string, RefDef>\n214\t    ctxDefs:Record<string, ContextToken<unknown>>\n215\t    renderFn?:RenderFn<any, any>\n216\t}\n217\t\n218\texport class ComponentBuilder<\n219\t    Props extends Record<string, PropDef> = Record<never, never>,\n220\t    RefDefs extends Record<string, RefDef> = Record<never, never>,\n221\t    CtxDefs extends Record<string, ContextToken<unknown>> = (\n222\t        Record<never, never>\n223\t    ),\n224\t> {\n225\t    private readonly _c:BuilderConfig\n226\t\n227\t    constructor (cfg:string | BuilderConfig) {\n228\t        this._c = typeof cfg === 'string' ?\n229\t            {\n230\t                tag: cfg,\n231\t                coercers: {},\n232\t                observed: [],\n233\t                propNames: [],\n234\t                propMetas: {},\n235\t                refDefs: {},\n236\t                ctxDefs: {},\n237\t            } :\n238\t            cfg\n239\t    }\n240\t\n241\t    get tagName ():string {\n242\t        return this._c.tag\n243\t    }\n244\t\n245\t    get TAG ():string {\n246\t        return this._c.tag\n247\t    }\n248\t\n249\t    withProps<P extends Record<string, PropDef>> (\n250\t        fn:(p:PropDSL) => P\n251\t    ):ComponentBuilder<P, RefDefs, CtxDefs> {\n252\t        const defs = fn(propDSL)\n253\t        const coercers:Record<string, Coercer<unknown>> = {}\n254\t        const observed:string[] = []\n255\t        const propNames:string[] = []\n256\t        const propMetas:Record<string, PropMeta> = {}\n257\t\n258\t        for (const [name, def] of Object.entries(defs)) {\n259\t            const coercer = normalizePropDef(\n260\t                name,\n261\t                def as PropDef<unknown>\n262\t            )\n263\t            coercers[name] = coercer\n264\t            propNames.push(name)\n265\t\n266\t            const kind = isPropOnly(def) ?\n267\t                'prop-only' as const :\n268\t                isStandardSchema(def) ?\n269\t                    'schema' as const :\n270\t                    coercer === coerceBoolean ?\n271\t                        'boolean' as const :\n272\t                        coercer === coerceJson ?\n273\t                            'json' as const :\n274\t                            'coercer' as const\n275\t\n276\t            propMetas[name] = { kind, coercer }\n277\t\n278\t            if (!isPropOnly(def)) {\n279\t                observed.push(name)\n280\t            }\n281\t        }\n282\t\n283\t        return new ComponentBuilder<P, RefDefs, CtxDefs>({\n284\t            ...this._c,\n285\t            coercers,\n286\t            observed,\n287\t            propNames,\n288\t            propMetas,\n289\t            renderFn: undefined,\n290\t        })\n291\t    }\n292\t\n293\t    withRefs<R extends Record<string, RefDef>> (\n294\t        fn:(r:RefsDSL) => R\n295\t    ):ComponentBuilder<Props, R, CtxDefs> {\n296\t        const defs = fn(refsDSL)\n297\t        return new ComponentBuilder<Props, R, CtxDefs>({\n298\t            ...this._c,\n299\t            refDefs: defs,\n300\t        })\n301\t    }\n302\t\n303\t    withContexts<C extends Record<string, ContextToken<unknown>>> (\n304\t        fn:(c:ContextDSL) => C\n305\t    ):ComponentBuilder<Props, RefDefs, C> {\n306\t        const defs = fn(contextDSL)\n307\t        return new ComponentBuilder<Props, RefDefs, C>({\n308\t            ...this._c,\n309\t            ctxDefs: defs,\n310\t        })\n311\t    }\n312\t\n313\t    render (\n314\t        fn:RenderFn<Props, RefDefs>,\n315\t        _options?:RenderOptions\n316\t    ):ComponentBuilder<Props, RefDefs, CtxDefs> {\n317\t        return new ComponentBuilder<Props, RefDefs, CtxDefs>({\n318\t            ...this._c,\n319\t            renderFn: fn,\n320\t        })\n321\t    }\n322\t\n323\t    setup (\n324\t        fn:(ctx:SetupContext<\n325\t            Props,\n326\t            RefsMap<RefDefs>,\n327\t            ContextsMap<CtxDefs>\n328\t        >) => void\n329\t    ):MicrotagElementClass<Props, RefDefs> {\n330\t        const c = this._c\n331\t        const El = factory({\n332\t            props: c.coercers,\n333\t            observedAttrNames: c.observed,\n334\t            refs: c.refDefs,\n335\t            contexts: c.ctxDefs,\n336\t            setup: fn as any,\n337\t        })\n338\t        Object.defineProperty(El, 'TAG', {\n339\t            value: c.tag,\n340\t            enumerable: true,\n341\t        })\n342\t\n343\t        const refNames:Record<string, string> = {}\n344\t        for (const key of Object.keys(c.refDefs)) {\n345\t            refNames[key] = key\n346\t        }\n347\t        Object.defineProperty(El, 'refs', {\n348\t            value: Object.freeze(refNames),\n349\t            enumerable: true,\n350\t        })\n351\t\n352\t        Object.defineProperty(El, 'props', {\n353\t            value: Object.freeze([...c.propNames]),\n354\t            enumerable: true,\n355\t        })\n356\t\n357\t        if (c.renderFn) {\n358\t            const rec:RenderRecord = {\n359\t                t: c.tag,\n360\t                m: c.propMetas,\n361\t                r: Object.freeze({ ...refNames }),\n362\t                f: c.renderFn,\n363\t            }\n364\t            // One helper per registry key, so both statics share the\n365\t            // lookup and the error.\n366\t            const link = (k:string) => (p:unknown, o:unknown) => {\n367\t                const f = (globalThis as any)[Symbol.for('microtags.' + k)]\n368\t                if (!f) {\n369\t                    throw new Error(\n370\t                        `microtags: ${k} needs \"microtags/render-support\"`\n371\t                    )\n372\t                }\n373\t                return f(rec, p, o)\n374\t            }\n375\t            Object.defineProperties(El, {\n376\t                render: { value: link('render'), enumerable: true },\n377\t                renderParts: {\n378\t                    value: link('renderParts'),\n379\t                    enumerable: true,\n380\t                },\n381\t            })\n382\t        }\n383\t\n384\t        // A tag th