eek<T>(sig:Signal<T>):T\n160\t\n161\t    /** Add a DOM event listener that is auto-removed on disconnect. */\n162\t    on<K extends keyof HTMLElementEventMap>(\n163\t        target:EventTarget,\n164\t        type:K,\n165\t        handler:(event:HTMLElementEventMap[K]) => void,\n166\t        options?:boolean | AddEventListenerOptions\n167\t    ):void\n168\t    on(\n169\t        target:EventTarget,\n170\t        type:string,\n171\t        handler:EventListener,\n172\t        options?:boolean | AddEventListenerOptions\n173\t    ):void\n174\t\n175\t    /**\n176\t     * Dispatch an event from the host. Pass a pre-built `Event` to\n177\t     * dispatch it as-is, or a name (plus optional `detail` and\n178\t     * `CustomEventInit` options) to construct and dispatch a\n179\t     * bubbling `CustomEvent`. Returns `dispatchEvent`'s result:\n180\t     * `false` when a cancelable event had `preventDefault()` called.\n181\t     */\n182\t    emit(event:Event):boolean\n183\t    emit<D>(\n184\t        name:string,\n185\t        detail?:D,\n186\t        options?:Omit<CustomEventInit<D>, 'detail'>\n187\t    ):boolean\n188\t\n189\t    /**\n190\t     * Run an alien-signals effect that auto-tracks the signals it reads.\n191\t     * The effect is auto-disposed on disconnect.\n192\t     */\n193\t    effect(fn:() => void|(() => void)):void\n194\t\n195\t    /**\n196\t     * Bind a signal to a DOM element. The signal is the source of\n197\t     * truth: the element property is set from the signal on bind and\n198\t     * on every change, auto-cleaned on disconnect.\n199\t     *\n200\t     * With no options the control type is auto-detected and the\n201\t     * binding is two-way (user input flows back into the signal).\n202\t     * With an options object, `prop` defaults to the auto-detected\n203\t     * property and `event` is the write-back event; omit `event` for\n204\t     * a one-way binding. A read-only getter (`() => T`) is also\n205\t     * accepted as the source for a one-way derived value — pass it\n206\t     * with options and omit `event`.\n207\t     */\n208\t    bind<T>(\n209\t        signal:Signal<T>,\n210\t        element:Element,\n211\t        options?:BindOptions\n212\t    ):void\n213\t\n214\t    /** Register custom teardown to run on disconnect. */\n215\t    onCleanup(fn:() => void):void\n216\t\n217\t    /** Read an optional context value. */\n218\t    consume<T>(token:ContextToken<T>):T | undefined\n219\t}\n220\t"}]},"parent_tool_use_id":null,"session_id":"3f913a53-0f10-4f84-aeba-59a85cf43fa6","uuid":"ffc0255a-43bf-4881-b31d-b9743db55497","timestamp":"2026-11-24T09:34:27.966Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/microtags.form-associated-02-form-associated-link-and-internals/src/types.ts","content":"import type { StandardSchemaV1 } from '@standard-schema/spec'\n\n/**\n * A callable alien-signals signal.\n * Call with no args to read (and subscribe in an effect).\n * Call with a value to write.\n */\nexport type Signal<T> = {\n    ():T\n    (value:T):void\n}\n\n/**\n * Shallow unwrap of signal-valued properties: each property that is a\n * signal becomes its value type, other properties pass through. Use it\n * to describe the plain data form of a state object.\n */\nexport type Serialized<T> = {\n    [K in keyof T]:T[K] extends Signal<infer V> ? V : T[K]\n}\n\n/** Converts a raw attribute string (or null) to T. */\nexport type Coercer<T> = (raw:string | null) => T\n\n/**\n * A property-only prop: not backed by an attribute.\n * The signal is initialised to `initial` and never updated\n * from an attribute string.\n */\nexport interface PropertyOnlyProp<T> {\n    readonly _microtag:'prop'\n    readonly initial:T\n}\n\n/**\n * A prop definition accepted by withProps.\n * Either a bare coercer function, a Standard Schema validator,\n * or a property-only marker.\n */\nexport type PropDef<T = unknown> =\n    | Coercer<T>\n    | StandardSchemaV1<unknown, T>\n    | PropertyOnlyProp<T>\n\n/** Infer T from a