{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01195ZHrDbCAdRX1YwsJ9xnZ","type":"tool_result","content":"  dist/cli.cjs.map  31.7kb\n\n⚡ Done in 4ms\nok 517 pending restore replayed\n# formLifecycle: early reset/disabled not replayed\nok 518 early reset not replayed\nok 519 early disabled not replayed\n\n1..519\n# tests 519\n# pass  519\n\n# ok","is_error":false}]},"parent_tool_use_id":null,"session_id":"b493dbd6-6389-478a-b86a-02c93f0db15a","uuid":"87ce0863-911e-4eb5-b417-cfda96cf2fb3","timestamp":"2026-11-24T09:56:05.330Z","tool_use_result":{"stdout":"  dist/cli.cjs.map  31.7kb\n\n⚡ Done in 4ms\nok 517 pending restore replayed\n# formLifecycle: early reset/disabled not replayed\nok 518 early reset not replayed\nok 519 early disabled not replayed\n\n1..519\n# tests 519\n# pass  519\n\n# ok","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01195ZHrDbCAdRX1YwsJ9xnZ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
