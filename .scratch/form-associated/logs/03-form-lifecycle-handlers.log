\nexport interface FactoryConfig<Props extends FactoryProps = FactoryProps> {\n    /** Coercer for each observed attribute / prop. */\n    props:Props\n    /** Attribute names to pass to observedAttributes. */\n    observedAttrNames:string[]\n    /** Ref definitions keyed by name. */\n    refs?:Record<string, RefDef>\n    /** Context tokens keyed by name. */\n    contexts?:Record<string, ContextToken<unknown>>\n    /** Make the host a form-associated custom element. */\n    formAssociated?:boolean\n    /** Setup callback receiving the component context. */\n    setup:(ctx:SetupContext<Props, any, any>) => void\n}\n\n/**\n * Collect resolved DOM refs from within a host element.\n * Throws if any single-ref element is missing.\n */\nfunction collectRefs (\n    host:HTMLElement,\n    defs:Record<string, RefDef>\n):Record<string, Element|Element[]> {\n    const result:Record<string, Element|Element[]> = {}\n    const missing:string[] = []\n    for (const [key, def] of Object.entries(defs)) {\n        const sel = def.selector ?? `[data-ref=\"${key}\"]`\n        if (def._microtag === 'ref:all') {\n            result[key] = Array.from(host.querySelectorAll(sel))\n        } else {\n            const el = host.querySelector(sel)\n            if (!el) {\n                missing.push(key)\n            } else {\n                result[key] = el\n            }\n        }\n    }\n    if (missing.length > 0) {\n        throw new Error(\n            `${host.tagName}: missing refs: ${missing.join(', ')}`\n        )\n    }\n    return result\n}\n\n/**\n * Create an HTMLElement subclass with the microtags lifecycle.\n * The returned class has no Shadow DOM, tracks its own prop signals,\n * and runs setup() on connect / cleanups a microtask after disconnect.\n */\nexport function factory<Props extends FactoryProps = FactoryProps> (\n    config:FactoryConfig<Props>\n):typeof HTMLElement {\n    const {\n        props: propDefs,\n        observedAttrNames,\n        setup,\n        refs: refDefs = {},\n        contexts: ctxDefs = {},\n        formAssociated: isFormAssociated,\n    } = config\n\n    class MicrotagElement extends HTMLElementBase {\n        static get observedAttributes () { return observedAttrNames }\n\n        _props:Record<string, Signal<unknown>> = {}\n        // Per prop: the external signal assigned to the accessor, if any.\n        _bound:Record<string, Signal<Signal<unknown>|undefined>> = {}\n        _cleanups:(() => void)[] = []\n        // Connected and set up, not yet torn down.\n        _live = false\n        _internals:ElementInternals|undefined\n\n        constructor () {\n            super()\n            if (isFormAssociated) {\n                this._internals = this.attachInternals()\n            }\n            for (const [name, coercer] of Object.entries(propDefs)) {\n                const own = signal(coercer(null))\n                const bound = signal<Signal<unknown>|undefined>(undefined)\n                this._bound[name] = bound\n                // Reads go through the bound signal when one is set,\n                // so setup's prop signal tracks it. A bound prop is\n                // owned by the parent, so writing it here throws.\n                this._props[name] = ((...args:unknown[]) => {\n                    const ext = bound()\n                    if (!args.length) return ext ? ext() : own()\n                    if (ext) {\n                        throw new Error(`${this.localName}: prop \"${name}\"` +\n                            ' is bound and read-only; emit an event instead')\n                    }\n                    own(args[0])\n                }) as Signal<unknown>\n                // Pick up a property set before the upgrade; it\n                // shadows the prototype accessor until removed.\n                if (Object.prototype.hasOwnProperty.call(this, name)) {\n                    const pre = (this as any)[name]\n                    delete (this as any)[name]\n                    ;(this as a