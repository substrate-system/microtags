MicrotagElement.prototype, name, {\n            get (this:MicrotagElement) { return this._props[name]() },\n            set (this:MicrotagElement, v:unknown) {\n                if (typeof v === 'function') {\n                    this._bound[name](v as Signal<unknown>)\n                } else {\n                    this._bound[name](undefined)\n                    this._props[name](v)\n                }\n            },\n            configurable: true,\n        })\n    }\n\n    return MicrotagElement\n}\n\n/**\n * Bind a signal (or computed) to a declared prop of a host, so the prop\n * reads through to it. Same as assigning the signal to the accessor,\n * but typed: the signal's value must match the prop's type.\n */\nexport const bindProp = <\n    H extends HTMLElement,\n    K extends Exclude<keyof H, keyof HTMLElement>,\n> (host:H, name:K, source:() => H[K]):void => {\n    (host as any)[name] = source\n}\n","structuredPatch":[{"oldStart":273,"oldLines":33,"newStart":273,"newLines":31,"lines":["         Object.defineProperty(MicrotagElement, 'formAssociated', {","             value: true,","         })","-        const proto = MicrotagElement.prototype as any","+        const p = MicrotagElement.prototype as any","         const fm = _fm!","-        proto.formResetCallback = function (this:any) {","+        p.formResetCallback = function () {","             fm.get(this)?.h?.reset?.()","         }","-        proto.formDisabledCallback = function (","-            this:any, d:boolean","-        ) {","+        p.formDisabledCallback = function (d:boolean) {","             fm.get(this)?.h?.disabled?.(d)","         }","-        proto.formStateRestoreCallback = function (","-            this:any, s:unknown, m:string","+        p.formAssociatedCallback = function (","+            f:HTMLFormElement|null","         ) {","+            fm.get(this)?.h?.associated?.(f)","+        }","+        p.formStateRestoreCallback = function (","+            s:unknown, m:string","+        )