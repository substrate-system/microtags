50\t/**\n51\t * Collect resolved DOM refs from within a host element.\n52\t * Throws if any single-ref element is missing.\n53\t */\n54\tfunction collectRefs (\n55\t    host:HTMLElement,\n56\t    defs:Record<string, RefDef>\n57\t):Record<string, Element|Element[]> {\n58\t    const result:Record<string, Element|Element[]> = {}\n59\t    const missing:string[] = []\n60\t    for (const [key, def] of Object.entries(defs)) {\n61\t        const sel = def.selector ?? `[data-ref=\"${key}\"]`\n62\t        if (def._microtag === 'ref:all') {\n63\t            result[key] = Array.from(host.querySelectorAll(sel))\n64\t        } else {\n65\t            const el = host.querySelector(sel)\n66\t            if (!el) {\n67\t                missing.push(key)\n68\t            } else {\n69\t                result[key] = el\n70\t            }\n71\t        }\n72\t    }\n73\t    if (missing.length > 0) {\n74\t        throw new Error(\n75\t            `${host.tagName}: missing refs: ${missing.join(', ')}`\n76\t        )\n77\t    }\n78\t    return result\n79\t}\n80\t\n81\t/**\n82\t * Create an HTMLElement subclass with the microtags lifecycle.\n83\t * The returned class has no Shadow DOM, tracks its own prop signals,\n84\t * and runs setup() on connect / cleanups a microtask after disconnect.\n85\t */\n86\texport function factory<Props extends FactoryProps = FactoryProps> (\n87\t    config:FactoryConfig<Props>\n88\t):typeof HTMLElement {\n89\t    const {\n90\t        props: propDefs,\n91\t        observedAttrNames,\n92\t        setup,\n93\t        refs: refDefs = {},\n94\t        contexts: ctxDefs = {},\n95\t        formAssociated: isFormAssociated,\n96\t    } = config\n97\t\n98\t    class MicrotagElement extends HTMLElementBase {\n99\t        static get observedAttributes () { return observedAttrNames }\n100\t\n101\t        _props:Record<string, Signal<unknown>> = {}\n102\t        // Per prop: the external signal assigned to the accessor, if any.\n103\t        _bound:Record<string, Signal<Signal<unknown>|undefined>> = {}\n104\t        _cleanups:(() => void)[] = []\n105\t        // Connected and set up, not yet torn down.\n106\t        _live = false\n107\t        _internals:ElementInternals|undefined\n108\t\n109\t        constructor () {\n110\t            super()\n111\t            if (isFormAssociated) {\n112\t                this._internals = this.attachInternals()\n113\t            }\n114\t            for (const [name, coercer] of Object.entries(propDefs)) {\n115\t                const own = signal(coercer(null))\n116\t                const bound = signal<Signal<unknown>|undefined>(undefined)\n117\t                this._bound[name] = bound\n118\t                // Reads go through the bound signal when one is set,\n119\t                // so setup's prop signal tracks it. A bound prop is\n120\t                // owned by the parent, so writing it here throws.\n121\t                this._props[name] = ((...args:unknown[]) => {\n122\t                    const ext = bound()\n123\t                    if (!args.length) return ext ? ext() : own()\n124\t                    if (ext) {\n125\t                        throw new Error(`${this.localName}: prop \"${name}\"` +\n126\t                            ' is bound and read-only; emit an event instead')\n127\t                    }\n128\t                    own(args[0])\n129\t                }) as Signal<unknown>\n130\t                // Pick up a property set before the upgrade; it\n131\t                // shadows the prototype accessor until removed.\n132\t                if (Object.prototype.hasOwnProperty.call(this, name)) {\n133\t                    const pre = (this as any)[name]\n134\t                    delete (this as any)[name]\n135\t                    ;(this as any)[name] = pre\n136\t                }\n137\t            }\n138\t        }\n139\t\n140\t        connectedCallback () {\n141\t            // Back before the queued teardown ran: this was a move.\n142\t            if (this._live) return\n143\t            this._live = true\n144\t            // Start a fresh cleanup scope for each connection cycle.\n145\t            this._cleanups = []\n146\t\n147\t            // Hydrate prop signals from attributes; preserve any\n148\t            // programmatically-set value when the attribute is absent.\n149\t            for (const [name, coercer] of Object.entries(propDefs)) {\n150\t                const attrVal = this.getAttribute(name)\n151\t                if (attrVal !== null && !this._bound[name]()) {\n152\t                    (this._props[name] as Signal<unknown>)(coercer(attrVal))\n153\t                }\n154\t            }\n155\t\n156\t            const cleanups = this._cleanups\n157\t            const props = this._props as PropsSignals<Props>\n158\t\n159\t            // Reactive Proxy: reading a key inside a ctx.effect creates\n160\t            // a subscription to the provider's alien-signals signal.\n161\t            const contexts = new Proxy({} as Record<string, unknown>, {\n162\t                get: (_target, key) => {\n163\t                    if (typeof key !== 'string') return undefined\n164\t                    const token = ctxDefs[key]\n165\t                    if (!token) return undefined\n166\t                    const sig = resolveContextSignal(this, token)\n167\t                    return sig ? sig() : undefined\n168\t                },\n169\t                has: (_target, key) => {\n170\t                    if (typeof key !== 'string') return false\n171\t                    return key in ctxDefs\n172\t                },\n173\t            })\n174\t\n175\t            let setupRan = false\n176\t            // Tracks pending-context cancel functions so they are\n177\t            // removed from the global registry when setup runs or\n178\t            // when the element disconnects.\n179\t            const cancelCallbacks:(() => void)[] = []\n180\t\n181\t            const tryRunSetup = ():void => {\n182\t                if (setupRan) return\n183\t                for (const token of Object.values(ctxDefs)) {\n184\t                    if (!resolveContextSignal(this, token)) return\n185\t                }\n186\t                setupRan = true\n187\t                for (const cancel of cancelCallbacks) cancel()\n188\t                cancelCallbacks.length = 0\n189\t\n190\t                // An empty host with a kept render link is filled from\n191\t                // its current props before refs resolve (ADR-011).\n192\t                // Comments count as content: region markers from a\n193\t                // templater or the server must survive.\n194\t                const rp = (this.constructor as any).renderParts\n195\t                if (rp && !this.innerHTML.trim()) {\n196\t                    const v:any = {}\n197\t                    for (const k in propDefs) v[k] = (this as any)[k]\n198\t                    this.innerHTML = rp(v).html\n199\t                }\n200\t\n201\t                const refs = collectRefs(this, refDefs)\n202\t                const ctx = makeSetupContext(\n203\t                    this, props, refs, contexts, cleanups,\n204\t                    this._internals\n205\t                )\n206\t                setup(ctx)\n207\t            }\n208\t\n209\t            // Deferred variant: skip if element was disconnected before\n210\t            // the context became available.\n211\t            const tryRunSetupIfConnected = ():void => {\n212\t                if (!this.isConnected) return\n213\t                tryRunSetup()\n214\t            }\n215\t\n216\t            // Register pending listeners for any missing contexts.\n217\t            for (const token of Object.values(ctxDefs)) {\n218\t                if (!resolveContextSignal(this, token)) {\n219\t                    const cancel = onContextAvailable(\n220\t                        token.id, tryRunSetupIfConnected\n221\t                    )\n222\t                    cancelCallbacks.push(cancel)\n223\t                    // Also can