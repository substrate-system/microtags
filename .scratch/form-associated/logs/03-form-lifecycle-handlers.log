:Record<string, unknown>,\n    cleanups:(() => void)[],\n    internals?:ElementInternals,\n    fm?:WeakMap<HTMLElement, {\n        h?:FormLifecycleHandlers; p?:[unknown, string]\n    }>\n):SetupContext<Props, any, any> {\n    const ctx:SetupContext<Props, any, any> = {\n        host,\n        props,\n        refs,\n        contexts,\n\n        peek,\n\n        on (target, type, handler, options?) {\n            target.addEventListener(\n                type as string,\n                handler as EventListener,\n                options\n            )\n            cleanups.push(() => {\n                target.removeEventListener(\n                    type as string,\n                    handler as EventListener,\n                    options\n                )\n            })\n        },\n\n        emit (\n            nameOrEvent:Event | string,\n            detail?:unknown,\n            options?:Omit<CustomEventInit, 'detail'>\n        ):boolean {\n            const event = nameOrEvent instanceof Event ?\n                nameOrEvent :\n                new CustomEvent(nameOrEvent, {\n                    bubbles: true,\n                    ...options,\n                    detail,\n                })\n            return host.dispatchEvent(event)\n        },\n\n        effect (fn) {\n            const dispose = effect(fn)\n            cleanups.push(dispose)\n        },\n\n        bind<T> (\n            source:Signal<T>,\n            control:Element,\n            opts?:BindOptions\n        ) {\n            const input = control instanceof HTMLInputElement ?\n                control :\n                undefined\n            let prop = 'value'\n            let autoEvent = 'change'\n            if (input?.type === 'checkbox') {\n                prop = 'checked'\n            } else if (input?.type === 'number' ||\n                input?.type === 'range') {\n                prop = 'valueAsNumber'\n                autoEvent = 'input'\n            } else if (input || control instanceof HTMLTextAreaElement) {\n                autoEvent = 'input'\n            }\n\n            const boundProp = opts?.prop ?? prop\n            const event = opts ? opts.event : autoEvent\n            const el = control as unknown as Record<string, unknown>\n\n            if (event) {\n                const handler = () => {\n                    const writable = source as Signal<unknown>\n                    writable(el[boundProp])\n                }\n                control.addEventListener(event, handler)\n                cleanups.push(() => {\n                    control.removeEventListener(event, handler)\n                })\n            }\n\n            const dispose = effect(() => {\n                el[boundProp] = source()\n            })\n            cleanups.push(dispose)\n        },\n\n        onCleanup (fn) {\n            cleanups.push(fn)\n        },\n\n        consume<T> (token:ContextToken<T>):T | undefined {\n            const sig = resolveContextSignal(host, token)\n            return sig ? sig() : undefined\n        },\n    }\n    if (internals) {\n        (ctx as any).internals = internals\n        ;(ctx as any).form = (h:FormLifecycleHandlers) => {\n            if (formReg) formReg(h)\n        }\n    }\n    return ctx\n}\n","structuredPatch":[{"oldStart":124,"oldLines":7,"newStart":124,"newLines":15,"lines":["     if (internals) {","         (ctx as any).internals = internals","         ;(ctx as any).form = (h:FormLifecycleHandlers) => {","-            if (formReg) formReg(h)","+            if (!fm) return","+            const rec = fm.get(host) ?? {}","+            rec.h = h","+            fm.set(host, rec)","+            if (rec.p && h.restore) {","+                const [s, m] = rec.p","+                delete rec.p","+                h.restore(s as FormData|string|null, m)","+            }","         }","     }","     return ctx"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01Q8jQqJGos5He8Wv1oy837W","permissi