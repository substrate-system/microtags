ontextSignal,\n    onContextAvailable,\n} from './context.js'\nimport type {\n    PropsSignals,\n    Signal,\n    SetupContext,\n    Coercer,\n    ContextToken,\n    RefDef,\n    FormLifecycleHandlers,\n} from './types.js'\n\n/**\n * Map of prop name to coercer function.\n * The factory accepts coercers exclusively; Standard Schema support is\n * layered on top in the withProps builder (US-005).\n */\nexport type FactoryProps = Record<string, Coercer<unknown>>\n\n/**\n * The class to extend for custom elements. In the browser this is the\n * real HTMLElement; in Node (e.g. reading `.TAG` for SSR) it falls back\n * to an empty stub so the class can be defined without a DOM. The stub\n * is never instantiated or registered outside the browser.\n */\nconst HTMLElementBase = typeof HTMLElement !== 'undefined' ?\n    HTMLElement :\n    (class {} as unknown as typeof HTMLElement)\n\n/** Configuration passed to factory(). */\nexport interface FactoryConfig<Props extends FactoryProps = FactoryProps> {\n    /** Coercer for each observed attribute / prop. */\n    props:Props\n    /** Attribute names to pass to observedAttributes. */\n    observedAttrNames:string[]\n    /** Ref definitions keyed by name. */\n    refs?:Record<string, RefDef>\n    /** Context tokens keyed by name. */\n    contexts?:Record<string, ContextToken<unknown>>\n    /** Make the host a form-associated custom element. */\n    formAssociated?:boolean\n    /** Setup callback receiving the component context. */\n    setup:(ctx:SetupContext<Props, any, any>) => void\n}\n\n/**\n * Collect resolved DOM refs from within a host element.\n * Throws if any single-ref element is missing.\n */\nfunction collectRefs (\n    host:HTMLElement,\n    defs:Record<string, RefDef>\n):Record<string, Element|Element[]> {\n    const result:Record<string, Element|Element[]> = {}\n    const missing:string[] = []\n    for (const [key, def] of Object.entries(defs)) {\n        const sel = def.selector ?? `[data-ref=\"${key}\"]`\n        if (def._microtag === 'ref:all') {\n            result[key] = Array.from(host.querySelectorAll(sel))\n        } else {\n            const el = host.querySelector(sel)\n            if (!el) {\n                missing.push(key)\n            } else {\n                result[key] = el\n            }\n        }\n    }\n    if (missing.length > 0) {\n        throw new Error(\n            `${host.tagName}: missing refs: ${missing.join(', ')}`\n        )\n    }\n    return result\n}\n\n/**\n * Create an HTMLElement subclass with the microtags lifecycle.\n * The returned class has no Shadow DOM, tracks its own prop signals,\n * and runs setup() on connect / cleanups a microtask after disconnect.\n */\nexport function factory<Props extends FactoryProps = FactoryProps> (\n    config:FactoryConfig<Props>\n):typeof HTMLElement {\n    const {\n        props: propDefs,\n        observedAttrNames,\n        setup,\n        refs: refDefs = {},\n        contexts: ctxDefs = {},\n        formAssociated: isFormAssociated,\n    } = config\n\n    const _handlers = isFormAssociated ?\n        new WeakMap<HTMLElement, FormLifecycleHandlers>() :\n        undefined\n    const _pendingRestore = isFormAssociated ?\n        new WeakMap<HTMLElement, [unknown, string]>() :\n        undefined\n\n    class MicrotagElement extends HTMLElementBase {\n        static get observedAttributes () { return observedAttrNames }\n\n        _props:Record<string, Signal<unknown>> = {}\n        // Per prop: the external signal assigned to the accessor, if any.\n        _bound:Record<string, Signal<Signal<unknown>|undefined>> = {}\n        _cleanups:(() => void)[] = []\n        // Connected and set up, not yet torn down.\n        _live = false\n        _internals:ElementInternals|undefined\n\n        constructor () {\n            super()\n            if (isFormAssociated) {\n                this._internals = this.attachInternals()\n            }\n            for (const [name, coercer] of Object.entries(propDefs)) {\n                const own = signal(coercer(null))\n                const bound = signal<Signal<unknown>|undefined>(undefined)\n                this._bound[name] = bound\n                // Reads go through the bound signal when one is set,\n                // so setup's prop signal tracks it. A bound prop is\n                // owned by the parent, so writing it here throws.\n                this._props[name] = ((...args:unknown[]) => {\n                    const ext = bound()\n                    if (!args.length) return ext ? ext() : own()\n                    if (ext) {\n                        throw new Error(`${this.localName}: prop \"${name}\"` +\n                            ' is bound and read-only; emit an event instead')\n                    }\n                    own(args[0])\n                }) as Signal<unknown>\n                // Pick up a property set before the upgrade; it\n                // shadows the prototype accessor until removed.\n                if (Object.prototype.hasOwnProperty.call(this, name)) {\n                    const pre = (this as any)[name]\n                    delete (this as any)[name]\n                    ;(this as any)[name] = pre\n                }\n            }\n        }\n\n        connectedCallback () {\n            // Back before the queued teardown ran: this was a move.\n            if (this._live) return\n            this._live = true\n            // Start a fresh cleanup scope for each connection cycle.\n            this._cleanups = []\n\n            // Hydrate prop signals from attributes; preserve any\n            // programmatically-set value when the attribute is absent.\n            for (const [name, coercer] of Object.entries(propDefs)) {\n                const attrVal = this.getAttribute(name)\n                if (attrVal !== null && !this._bound[name]()) {\n                    (this._props[name] as Signal<unknown>)(coercer(attrVal))\n                }\n            }\n\n            const cleanups = this._cleanups\n            const props = this._props as PropsSignals<Props>\n\n            // Reactive Proxy: reading a key inside a ctx.effect creates\n            // a subscription to the provider's alien-signals signal.\n            const contexts = new Proxy({} as Record<string, unknown>, {\n                get: (_target, key) => {\n                    if (typeof key !== 'string') return undefined\n                    const token = ctxDefs[key]\n                    if (!token) return undefined\n                    const sig = resolveContextSignal(this, token)\n                    return sig ? sig() : undefined\n                },\n                has: (_target, key) => {\n                    if (typeof key !== 'string') return false\n                    return key in ctxDefs\n                },\n            })\n\n            let setupRan = false\n            // Tracks pending-context cancel functions so they are\n            // removed from the global registry when setup runs or\n            // when the element disconnects.\n            const cancelCallbacks:(() => void)[] = []\n\n            const tryRunSetup = ():void => {\n                if (setupRan) return\n                for (const token of Object.values(ctxDefs)) {\n                    if (!resolveContextSignal(this, token)) return\n                }\n                setupRan = true\n                for (const cancel of cancelCallbacks) cancel()\n                cancelCallbacks.length = 0\n\n                // An empty host with a kept render link is filled from\n                // its current props before refs resolve (ADR-011).\n                // Comments count as content: region markers from a\n                // templater or the server must survive.\n                const rp = (this.constructor as any).renderParts\n                if (rp && !this.innerHTML.trim()) {\n                    const v:any = {}\n                    for (const k in propDefs) v[k] = (this as any)[k]\n                    this.innerHTML = rp(v).html\n                }\n\n                const refs = collectRefs(this, refDefs)\n                const el:MicrotagElement = this\n                const formReg = _handlers ?\n                    (h:FormLifecycleHandlers) => {\n                        _handlers.set(el, h)\n                        const p = _pendingRestore!.get(el)\n                        if (p && h.restore) {\n                            _pendingRestore!.delete(el)\n                            h.restore(\n                                p[0] as FormData|string|null,\n                                p[1]\n                            )\n                        }\n                    } :\n                    undefined\n                const ctx = makeSetupContext(\n                    this, props, refs, contexts, cleanups,\n                    this._internals, formReg\n                )\n                setup(ctx)\n            }\n\n            // Deferred variant: skip if element was disconnected before\n            // the context became available.\n            const tryRunSetupIfConnected = ():void => {\n                if (!this.isConnected) return\n                tryRunSetup()\n            }\n\n            // Register pending listeners for any missing contexts.\n            for (const token of Object.values(ctxDefs)) {\n                if (!resolveContextSignal(this, token)) {\n                    const cancel = onContextAvailable(\n                        token.id, tryRunSetupIfConnected\n                    )\n                    cancelCallbacks.push(cancel)\n                    // Also cancel on disconnect so we don't leak.\n                    cleanups.push(cancel)\n                }\n            }\n\n            tryRunSetup()\n        }\n\n        attributeChangedCallback (\n            name:string,\n            _old:string|null,\n            next:string|null\n        ) {\n            const coercer = propDefs[name]\n            if (\n                coercer !== undefined &&\n                this._props[name] !== undefined &&\n                !this._bound[name]()\n            ) {\n                (this._props[name] as Signal<unknown>)(coercer(next))\n            }\n        }\n\n        // A DOM move (`moveBefore`) keeps the host set up\n        connectedMoveCallback () {}\n\n        // Teardown waits a microtask, so a host removed and re-inserted\n        // in the same tick (`insertBefore` without `moveBefore`) keeps\n        // its setup.\n        disconnectedCallback () {\n            queueMicrotask(() => {\n                if (this.isConnected || !this._live) return\n                this._live = false\n                if (_handlers) _handlers.delete(this)\n                if (_pendingRestore) _pendingRestore.delete(this)\n                // Snapshot and clear BEFORE running so re-entrant calls\n                // are safe and the array is empty after this throws.\n                const fns = this._cleanups\n                this._cleanups = []\n                runAll(fns)\n            })\n        }\n    }\n\n    if (isFormAssociated) {\n        Object.defineProperty(MicrotagElement, 'formAssociated', {\n            value: true,\n        })\n        const proto = MicrotagElement.prototype as any\n        proto.formResetCallback = function (this:any) {\n            _handlers!.get(this)?.reset?.()\n        }\n        proto.formDisabledCallback = function (\n            this:any, d:boolean\n        ) {\n            _handlers!.get(this)?.disabled?.(d)\n        }\n        proto.formStateRestoreCallback = function (\n            this:any, s:unknown, m:string\n        ) {\n            const h = _handlers!.get(this)\n            if (h?.restore) {\n                h.restore(s as FormData|string|null, m)\n            } else {\n                _pendingRestore!.set(this, [s, m])\n            }\n        }\n        proto.formAssociatedCallback = function (\n            this:any, f:HTMLFormElement|null\n        ) {\n            _handlers!.get(this)?.associated?.(f)\n        }\n    }\n\n    // One accessor per prop. A function value is taken to be a signal\n    // and bound; anything else unbinds and writes the prop.\n    for (const name of Object.keys(propDefs)) {\n        Object.defineProperty(MicrotagElement.prototype, name, {\n            get (this:MicrotagElement) { return this._props[name]() },\n            set (this:MicrotagElement, v:unknown) {\n                if (typeof v === 'function') {\n                    this._bound[name](v as Signal<unknown>)\n                } else {\n                    this._bound[name](undefined)\n                    this._props[name](v)\n                }\n            },\n            configurable: true,\n        })\n    }\n\n    return MicrotagElement\n}\n\n/**\n * Bind a signal (or computed) to a declared prop of a host, so the prop\n * reads through to it. Same as assigning the signal to the accessor,\n * but typed: the signal's value must match the prop's type.\n */\nexport const bindProp = <\n    H extends HTMLElement,\n    K extends Exclude<keyof H, keyof HTMLElement>,\n> (host:H, name:K, source:() => H[K]):void => {\n    (host as any)[name] = source\n}\n","structuredPatch":[{"oldStart":207,"oldLines":19,"newStart":207,"newLines":10,"lines":["                 }"," ","                 const refs = collectRefs(this, refDefs)","-                const el:MicrotagElement = this","                 const formReg = _handlers ?","-                    (h:FormLifecycleHandlers) => {","-                        _handlers.set(el, h)","-                        const p = _pendingRestore!.get(el)","-                        if (p && h.restore) {","-                            _pendingRestore!.delete(el)","-                            h.restore(","-                                p[0] as FormData|string|null,","-                                p[1]","-                            )","-                        }","-                    } :","+                    makeFormReg(","+              