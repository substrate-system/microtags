xt)\n513\t        }\n514\t        ts.forEachChild(node, visitRefs)\n515\t    }\n516\t\n517\t    ts.forEachChild(sf, node => {\n518\t        if (ts.isImportDeclaration(node)) return\n519\t        visitRefs(node)\n520\t    })\n521\t\n522\t    return refs\n523\t}\n524\t\n525\tfunction isExportedNode (\n526\t    node:TypeScript.Node\n527\t):boolean {\n528\t    if (!ts.canHaveModifiers(node)) return false\n529\t    const mods = ts.getModifiers(node)\n530\t    if (!mods) return false\n531\t    return mods.some(\n532\t        m => m.kind === ts.SyntaxKind.ExportKeyword\n533\t    )\n534\t}\n535\t\n536\tfunction findStrippedStaticCalls (\n537\t    sf:TypeScript.SourceFile,\n538\t    bindings:Set<string>,\n539\t    warnings:TransformWarning[],\n540\t    filename?:string\n541\t) {\n542\t    function visit (node:TypeScript.Node) {\n543\t        if (\n544\t            ts.isCallExpression(node) &&\n545\t            ts.isPropertyAccessExpression(\n546\t                node.expression\n547\t            ) &&\n548\t            node.expression.name.text === 'render' &&\n549\t            ts.isIdentifier(\n550\t                node.expression.expression\n551\t            ) &&\n552\t            bindings.has(\n553\t                node.expression.expression.text\n554\t            )\n555\t        ) {\n556\t            const line = sf.getLineAndCharacterOfPosition(\n557\t                node.getStart()\n558\t            ).line + 1\n559\t            warnings.push({\n560\t                kind: 'stripped-static',\n561\t                file: filename,\n562\t                line,\n563\t                message:\n564\t                    `${node.expression.expression.text}` +\n565\t                    '.render() called but render ' +\n566\t                    'was stripped',\n567\t            })\n568\t        }\n569\t        ts.forEachChild(node, visit)\n570\t    }\n571\t    ts.forEachChild(sf, visit)\n572\t}\n573\t"}]},"parent_tool_use_id":"toolu_014UPCKmnimWAFbXhXsD2n9Y","agent_id":"a58061a4bd10