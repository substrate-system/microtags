{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012jzoEZtCFeeq5LnWDjrkgR","type":"tool_result","content":"1\timport { test } from '@substrate-system/tapzero'\n2\timport { h, hydrate, render } from 'preact'\n3\timport { define } from '../src/index.js'\n4\timport { html } from '../src/htm.js'\n5\timport { toPreact } from '../src/preact.browser.js'\n6\t\n7\t// Browser tests for the `microtags/preact` browser build. Hydrate\n8\t// fixtures are the component's `render` static output, placed with\n9\t// `innerHTML` (`test/index.ts` imports the server templater, so render\n10\t// support is registered).\n11\t\n12\tconst inner = (count:number, label:string) => html`\n13\t    <input class=\"field\" data-ref=\"field\" value=${label} />\n14\t    <output data-ref=\"out\">${String(count)}</output>\n15\t    <button data-ref=\"bump\">+</button>`\n16\t\n17\t/**\n18\t * The full variant: it keeps its render link. Like a real component,\n19\t * its setup only reads its refs (collected before setup) and never\n20\t * renders markup itself.\n21\t */\n22\tconst PEl = define('preact-browser-el')\n23\t    .withProps(p => ({ count: p.number(), label: p.string() }))\n24\t    .withRefs(r => ({\n25\t        field: r.one<HTMLInputElement>(),\n26\t        out: r.one<HTMLOutputElement>(),\n27\t        bump: r.one<HTMLButtonElement>(),\n28\t    }))\n29\t    .render(({ props }) => inner(props.count, props.label))\n30\t    .setup(ctx => {\n31\t        const { out, bump } = ctx.refs\n32\t        ctx.effect(() => { out.textContent = String(ctx.props.count()) })\n33\t        ctx.on(bump, 'click', () => {\n34\t            ctx.emit('preact-browser-el:bump')\n35\t        })\n36\t    })\n37\t\n38\tconst PC = toPreact(PEl, { events: { onBump: 'preact-browser-el:bump' } })\n39\t\n40\tfunction container ():HTMLElement {\n41\t    const div = document.createElement('div')\n42\t    document.body.appendChild(div)\n43\t    return div\n44\t}\n45\t\n46\t/** A container holding the server render of the component. */\n47\tfunction serverRendered (count:number, label:string):HTMLElement {\n48\t    const div = container()\n49\t    div.innerHTML = PEl.render({ count, label })\n50\t    return div\n51\t}\n52\t\n53\ttest('preact browser: hydrate keeps the inner nodes', t => {\n54\t    const div = serverRendered(1, 'a')\n55\t    const input = div.querySelector('input')!\n56\t    hydrate(h(PC, { count: 1, label: 'a' }), div)\n57\t    t.equal(div.querySelector('input'), input, 'same inner node')\n58\t    t.ok(input.isConnected, 'inner node is still connected')\n59\t    render(null, div)\n60\t    div.remove()\n61\t})\n62\t\n63\ttest('preact browser: re-render after hydrate sets the prop', t => {\n64\t    const div = serverRendered(1, 'a')\n65\t    const input = div.querySelector('input')!\n66\t    hydrate(h(PC, { count: 1, label: 'a' }), div)\n67\t    render(h(PC, { count: 5, label: 'a' }), div)\n68\t    const el = div.firstElementChild as InstanceType<typeof PEl>\n69\t    t.equal(div.querySelector('input'), input, 'same inner node')\n70\t    t.equal(el.count, 5, 'the property returns the new value')\n71\t    t.equal(div.querySelector('output')!.textContent, '5',\n72\t        'the element reacted to the new value')\n73\t    render(null, div)\n74\t    div.remove()\n75\t})\n76\t\n77\ttest('preact browser: a value typed before hydrate survives', t => {\n78\t    const div = serverRendered(1, 'a')\n79\t    const input = div.querySelector('input')!\n80\t    input.value = 'typed'\n81\t    hydrate(h(PC, { count: 1, label: 'a' }), div)\n82\t    t.equal(div.querySelector('input')!.value, 'typed', 'value kept')\n83\t    render(null, div)\n84\t    div.remove()\n85\t})\n86\t\n87\ttest('preact browser: client-only render', t => {\n88\t    const div = container()\n89\t    render(h(PC, { count: 2, label: 'b' }), div)\n90\t    const input = div.querySelector('input')\n91\t    t.ok(input, 'the element rendered its inner markup')\n92\t    t.equal(input?.value, 'b', 'from the declared props')\n93\t    t.equal(div.querySelector('output')?.textContent, '2', 'count shown')\n94\t    render(h(PC, { count: 3, label: 'b' }), div)\n95\t    t.equal(div.querySelector('input'), input, 'same inner node')\n96\t    t.equal(div.querySelector('output')?.textContent, '3', 'count updated')\n97\t    render(null, div)\n98\t    div.remove()\n99\t})\n100\t\n101\ttest('preact browser: a mapped callback is called on the event', t => {\n102\t    let calls = 0\n103\t    const onBump = () => { calls++ }\n104\t\n105\t    const hydrated = serverRendered(1, 'a')\n106\t    hydrate(h(PC, { count: 1, label: 'a', onBump }), hydrated)\n107\t    hydrated.querySelector('button')!.click()\n108\t    t.equal(calls, 1, 'called after hydrate')\n109\t    render(null, hydrated)\n110\t    hydrated.remove()\n111\t\n112\t    const client = container()\n113\t    render(h(PC, { count: 1, label: 'a', onBump }), client)\n114\t    client.querySelector('button')!.click()\n115\t    t.equal(calls, 2, 'called after a client-only render')\n116\t    render(null, client)\n117\t    client.remove()\n118\t})\n119\t\n120\ttest('preact browser: children throw, naming the tag', t => {\n121\t    const div = container()\n122\t    let err:Error|null = null\n123\t    try {\n124\t        render(h(PC as any, { count: 1 }, 'kid'), div)\n125\t    } catch (e) {\n126\t        err = e as Error\n127\t    }\n128\t    t.ok(err?.message.includes('preact-browser-el'), 'names the tag')\n129\t    div.remove()\n130\t})\n131\t\n132\t/** A prop-only declared prop: never serialized, never an attribute. */\n133\tconst PListEl = define('preact-browser-list')\n134\t    .withProps(p => ({ items: p.prop<string[]>([]) }))\n135\t    .render(() => html`<ul></ul>`)\n136\t    .setup(ctx => {\n137\t        const ul = ctx.host.querySelector('ul')!\n138\t        ctx.effect(() => {\n139\t            ul.textContent = ctx.props.items().join(',')\n140\t        })\n141\t    })\n142\t\n143\tconst PList = toPreact(PListEl)\n144\t\n145\ttest('preact browser: hydrate assigns a prop-only declared prop', t => {\n146\t    const div = container()\n147\t    div.innerHTML = PListEl.render({ items: ['a', 'b'] })\n148\t    const list = ['a', 'b']\n149\t    hydrate(h(PList, { items: list }), div)\n150\t    const el = div.firstElementChild as InstanceType<typeof PListEl>\n151\t    t.equal(el.items, list, 'the property holds the passed value')\n152\t    t.equal(div.querySelector('ul')!.textContent, 'a,b',\n153\t        'the element reacted to it')\n154\t    render(h(PList, { items: list }), div)\n155\t    t.equal(el.items, list, 'a re-render with the same value keeps it')\n156\t    const next = ['c']\n157\t    render(h(PList, { items: next }), div)\n158\t    t.equal(el.items, next, 'a new value is assigned')\n159\t    render(null, div)\n160\t    div.remove()\n161\t})\n162\t"}]},"parent_tool_use_id":null,"session_id":"6cc07e3d-f14d-4f74-8232-b688abdf9fde","uuid":"6f25093d-ffe0-47e5-9b05-fdb48e991bd6","timestamp":"2026-11-24T09:59:31.926Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/microtags.form-associated-04-server-render-and-hydration/test/preact-browser.ts","content":"import { test } from '@substrate-system/tapzero'\nimport { h, hydrate, render } from 'preact'\nimport { define } from '../src/index.js'\nimport { html } from '../src/htm.js'\nimport { toPreact } from '../src/preact.browser.js'\n\n// Browser tests for the `microtags/preact` browser build. Hydrate\n// fixtures are the component's `render` static output, placed with\n// `innerHTML` (`test/index.ts` imports the server templater, so render\n// support is registered).\n\nconst inner = (count:number, label:string) => html`\n    <input class=\"field\" data-ref=\"field\" value=${label} />\n    <output data-ref=\"out\">${String(count)}</output>\n    <button data-ref=\"bump\">+</button>`\n\n/**\n * The full variant: it keeps its render link. Like a real component,\n * its setup only reads its refs (collected before setup) and never\n * renders markup itself.\n */\nconst PEl = define('preact-browser-el')\n    .withProps(p => ({ count: p.number(), label: p.string() }))\n    .withRefs(r => ({\n        field: r.one<HTMLInputElement>(),\n        out: r.one<HTMLOutputElement>(),\n        bump: r.one<HTMLButtonElement>(),\n    }))\n    .render(({ props }) => inner(props.count, props.label))\n    .setup(ctx => {\n        const { out, bump } = ctx.refs\n        ctx.effect(() => { out.textContent = String(ctx.props.count()) })\n        ctx.on(bump, 'click', () => {\n            ctx.emit('preact-browser-el:bump')\n        })\n    })\n\nconst PC = toPreact(PEl, { events: { onBump: 'preact-browser-el:bump' } })\n\nfunction container ():HTMLElement {\n    const div = document.createElement('div')\n    document.body.appendChild(div)\n    return div\n}\n\n/** A container holding the server render of the component. */\nfunction serverRendered (count:number, label:string):HTMLElement {\n    const div = container()\n    div.innerHTML = PEl.render({ count, label })\n    return div\n}\n\ntest('preact browser: hydrate keeps the inner nodes', t => {\n    const div = serverRendered(1, 'a')\n    const input = div.querySelector('input')!\n    hydrate(h(PC, { count: 1, label: 'a' }), div)\n    t.equal(div.querySelector('input'), input, 'same inner node')\n    t.ok(input.isConnected, 'inner node is still connected')\n    render(null, div)\n    div.remove()\n})\n\ntest('preact browser: re-render after hydrate sets the prop', t => {\n    const div = serverRendered(1, 'a')\n    const input = div.querySelector('input')!\n    hydrate(h(PC, { count: 1, label: 'a' }), div)\n    render(h(PC, { count: 5, label: 'a' }), div)\n    const el = div.firstElementChild as InstanceType<typeof PEl>\n    t.equal(div.querySelector('input'), input, 'same inner node')\n    t.equal(el.count, 5, 'the property returns the new value')\n    t.equal(div.querySelector('output')!.textContent, '5',\n        'the element reacted to the new value')\n    render(null, div)\n    div.remove()\n})\n\ntest('preact browser: a value typed before hydrate survives', t => {\n    const div = serverRendered(1, 'a')\n    const input = div.querySelector('input')!\n    input.value = 'typed'\n    hydrate(h(PC, { count: 1, label: 'a' }), div)\n    t.equal(div.querySelector('input')!.value, 'typed', 'value kept')\n    render(null, div)\n    div.remove()\n})\n\ntest('preact browser: client-only render', t => {\n    const div = container()\n    render(h(PC, { count: 2, label: 'b' }), div)\n    const input = div.querySelector('input')\n    t.ok(input, 'the element rendered its inner markup')\n    t.equal(input?.value, 'b', 'from the declared props')\n    t.equal(div.querySelector('output')?.textContent, '2', 'count shown')\n    render(h(PC, { count: 3, label: 'b' }), div)\n    t.equal(div.querySelector('input'), input, 'same inner node')\n    t.equal(div.querySelector('output')?.textContent, '3', 'count updated')\n    render(null, div)\n    div.remove()\n})\n\ntest('preact browser: a mapped callback is called on the event', t => {\n    let calls = 0\n    const onBump = () => { calls++ }\n\n    const hydrated = serverRendered(1, 'a')\n    hydrate(h(PC, { count: 1, label: 'a', onBump }), hydrated)\n    hydrated.querySelector('button')!.click()\n    t.equal(calls, 1, 'called after hydrate')\n    render(null, hydrated)\n    hydrated.remove()\n\n    const client = container()\n    render(h(PC, { count: 1, label: 'a', onBump }), client)\n    client.querySelector('button')!.click()\n    t.equal(calls, 2, 'called after a client-only render')\n    render(null, client)\n    client.remove()\n})\n\ntest('preact browser: children throw, naming the tag', t => {\n    const div = container()\n    let err:Error|null = null\n    try {\n        render(h(PC as any, { count: 1 }, 'kid'), div)\n    } catch (e) {\n        err = e as Error\n    }\n    t.ok(err?.message.includes('preact-browser-el'), 'names the tag')\n    div.remove()\n})\n\n/** A prop-only declared prop: never serialized, never an attribute. */\nconst PListEl = define('preact-browser-list')\n    .withProps(p => ({ items: p.prop<string[]>([]) }))\n    .render(() => html`<ul></ul>`)\n    .setup(ctx => {\n        const ul = ctx.host.querySelector('ul')!\n        ctx.effect(() => {\n            ul.textContent = ctx.props.items().join(',')\n        })\n    })\n\nconst PList = toPreact(PListEl)\n\ntest('preact browser: hydrate assigns a prop-only declared prop', t => {\n    const div = container()\n    div.innerHTML = PListEl.render({ items: ['a', 'b'] })\n    const list = ['a', 'b']\n    hydrate(h(PList, { items: list }), div)\n    const el = div.firstElementChild as InstanceType<typeof PListEl>\n    t.equal(el.items, list, 'the property holds the passed value')\n    t.equal(div.querySelector('ul')!.textContent, 'a,b',\n        'the element reacted to it')\n    render(h(PList, { items: list }), div)\n    t.equal(el.items, list, 'a re-render with the same value keeps it')\n    const next = ['c']\n    render(h(PList, { items: next }), div)\n    t.equal(el.items, next, 'a new value is assigned')\n    render(null, div)\n    div.remove()\n})\n","numLines":162,"startLine":1,"totalLines":162}},"tool_result_meta":[{"id":"toolu_012jzoEZtCFeeq5LnWDjrkgR","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
