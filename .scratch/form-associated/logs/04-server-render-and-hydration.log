{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_011ChMZcbXVRn295VwEz4rzJ","type":"message","role":"assistant","content":[{"type":"text","text":"The passthrough pattern only allows `class`, `id`, `aria-*`, `data-*`. `name` is not a passthrough. The simplest fix: set `name` directly on the DOM element after render, or just render the host directly without Preact managing the `name`. Actually, the simplest approach is to render the preact component inside a form, then set `name` on the host element manually."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":526,"cache_read_input_tokens":85515,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":526},"output_tokens":1,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6cc07e3d-f14d-4f74-8232-b688abdf9fde","uuid":"9aa9b87e-34f1-446f-914e-63d247e6357a","timestamp":"2026-11-24T10:03:58.743Z","request_id":"req_011ChMZcbRn7vzSGwwgQuUED"}
