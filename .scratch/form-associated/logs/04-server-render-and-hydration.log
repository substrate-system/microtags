{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VtR7ZafKQU8UUVPQ6MtrN4","type":"tool_result","content":"1\timport type TypeScript from 'typescript'\n2\t\n3\tdeclare const require:(id:string) => unknown\n4\t\n5\tlet ts:typeof TypeScript\n6\ttry {\n7\t    ts = require('typescript') as typeof TypeScript\n8\t} catch (err) {\n9\t    // Only a failure to resolve the bare name means typescript is\n10\t    // missing. Anything else is a context that cannot `require` it:\n11\t    // an ESM bundle without `require`, or a Vite config bundle, which\n12\t    // hands `require` a file URL.\n13\t    const { code, message } = err as { code?:string, message?:string }\n14\t    if (\n15\t        code === 'MODULE_NOT_FOUND' &&\n16\t        message?.includes(\"'typescript'\")\n17\t    ) {\n18\t        throw new Error(\n19\t            'microtags/build requires \"typescript\" as a peer dependency. ' +\n20\t            'Install it with: npm install --save-dev typescript'\n21\t        )\n22\t    }\n23\t    throw new Error(\n24\t        'microtags/build could not load \"typescript\" because `require` ' +\n25\t        'is unavailable or unusable here. Load the entry from its ' +\n26\t        'built form (microtags/build, or dist/ in this repo) instead ' +\n27\t        'of from source.',\n28\t        { cause: err }\n29\t    )\n30\t}\n31\t\n32\texport interface TransformWarning {\n33\t    kind:'outside-chain'|'stripped-static'|'non-literal-tag'\n34\t    file?:string\n35\t    line:number\n36\t    message:string\n37\t}\n38\t\n39\texport interface TransformOptions {\n40\t    cascade?:boolean\n41\t    keep?:string[]\n42\t    filename?:string\n43\t}\n44\t\n45\texport interface TransformResult {\n46\t    code:string\n47\t    warnings:TransformWarning[]\n48\t}\n49\t\n50\texport function transform (\n51\t    code:string,\n52\t    options?:TransformOptions\n53\t):TransformResult {\n54\t    const keep = options?.keep ?? []\n55\t    const filename = options?.filename\n56\t\n57\t    const sf = ts.createSourceFile(\n58\t        filename ?? 'input.ts',\n59\t        code,\n60\t        ts.ScriptTarget.Latest,\n61\t        true\n62\t    )\n63\t\n64\t    const defineAliases = findDefineAliases(sf)\n65\t    const spans:{ start:number, end:number }[] = []\n66\t    const strippedBindings:Set<string> = new Set()\n67\t    const warnings:TransformWarning[] = []\n68\t    let keptLink = false\n69\t\n70\t    function visit (node:TypeScript.Node) {\n71\t        if (!ts.isCallExpression(node)) {\n72\t            ts.forEachChild(node, visit)\n73\t            return\n74\t        }\n75\t\n76\t        if (\n77\t            ts.isPropertyAccessExpression(node.expression) &&\n78\t            node.expression.name.text === 'render'\n79\t        ) {\n80\t            const receiver = node.expression.expression\n81\t            const chainRoot = findChainRoot(receiver)\n82\t\n83\t            if (\n84\t                chainRoot &&\n85\t                isDefineCall(chainRoot, defineAliases)\n86\t            ) {\n87\t                const tagName = getDefineLiteralTag(chainRoot)\n88\t\n89\t                if (tagName === null && keep.length > 0) {\n90\t                    const line = sf.getLineAndCharacterOfPosition(\n91\t                        chainRoot.getStart()\n92\t                    ).line + 1\n93\t                    warnings.push({\n94\t                        kind: 'non-literal-tag',\n95\t                        file: filename,\n96\t                        line,\n97\t                        message:\n98\t                            'define() call with non-literal ' +\n99\t                            'tag name cannot be matched ' +\n100\t                            'by --keep',\n101\t                    })\n102\t                }\n103\t\n104\t                if (shouldKeep(node, tagName, keep)) {\n105\t                    keptLink = true\n106\t                    ts.forEachChild(node, visit)\n107\t                    return\n108\t                }\n109\t\n110\t                const binding = findBindingName(node)\n111\t                if (binding) strippedBindings.add(binding)\n112\t\n113\t                spans.push({\n114\t                    start: dotPosition(node),\n115\t                    end: node.getEnd(),\n116\t                })\n117\t                return\n118\t            }\n119\t\n120\t            const line = sf.getLineAndCharacterOfPosition(\n121\t                node.getStart()\n122\t            ).line + 1\n123\t            warnings.push({\n124\t                kind: 'outside-chain',\n125\t                file: filename,\n126\t                line,\n127\t                message:\n128\t                    '.render() call outside a define chain',\n129\t            })\n130\t        }\n131\t\n132\t        ts.forEachChild(node, visit)\n133\t    }\n134\t\n135\t    ts.forEachChild(sf, visit)\n136\t\n137\t    spans.sort((a, b) => b.start - a.start)\n138\t\n139\t    let result = code\n140\t    for (const span of spans) {\n141\t        const removed = result.slice(span.start, span.end)\n142\t        const newlines = removed.split('\\n').length - 1\n143\t        result = result.slice(0, span.start) +\n144\t            '\\n'.repeat(newlines) +\n145\t            result.slice(span.end)\n146\t    }\n147\t\n148\t    if (options?.cascade) {\n149\t        result = cascadeRemove(result, filename)\n150\t    }\n151\t\n152\t    if (strippedBindings.size > 0) {\n153\t        const resultSf = ts.createSourceFile(\n154\t            filename ?? 'input.ts',\n155\t            result,\n156\t            ts.ScriptTarget.Latest,\n157\t            true\n158\t        )\n159\t        findStrippedStaticCalls(\n160\t            resultSf, strippedBindings, warnings, filename\n161\t        )\n162\t    }\n163\t\n164\t    // A kept render link needs the server render support module at\n165\t    // runtime (ADR-009). Appended so no existing line moves; imports\n166\t    // are hoisted, so its position does not matter.\n167\t    if (keptLink && !importsSupport(sf)) {\n168\t        result += `\\nimport '${SUPPORT}'\\n`\n169\t    }\n170\t\n171\t    return { code: result, warnings }\n172\t}\n173\t\n174\tconst SUPPORT = 'microtags/render-support'\n175\t\n176\tfunction importsSupport (sf:TypeScript.SourceFile):boolean {\n177\t    return sf.statements.some(node =>\n178\t        ts.isImportDeclaration(node) &&\n179\t        ts.isStringLiteral(node.moduleSpecifier) &&\n180\t        node.moduleSpecifier.text === SUPPORT\n181\t    )\n182\t}\n183\t\n184\tfunction findDefineAliases (\n185\t    sf:TypeScript.SourceFile\n186\t):Set<string> {\n187\t    const aliases = new Set<string>()\n188\t    ts.forEachChild(sf, node => {\n189\t        if (\n190\t            ts.isImportDeclaration(node) &&\n191\t            ts.isStringLiteral(node.moduleSpecifier) &&\n192\t            node.moduleSpecifier.text === 'microtags' &&\n193\t            node.importClause?.namedBindings &&\n194\t            ts.isNamedImports(\n195\t                node.importClause.namedBindings\n196\t            )\n197\t        ) {\n198\t            for (const spec of\n199\t                node.importClause.namedBindings.elements\n200\t            ) {\n201\t                const origName =\n202\t                    spec.propertyName?.text ??\n203\t                    spec.name.text\n204\t                if (origName === 'define') {\n205\t                    aliases.add(spec.name.text)\n206\t                }\n207\t            }\n208\t        }\n209\t    })\n210\t    return aliases\n211\t}\n212\t\n213\tfunction findChainRoot (\n214\t    node:TypeScript.Node\n215\t):TypeScript.CallExpression | null {\n216\t    if (ts.isCallExpression(node)) {\n217\t        if (ts.isIdentifier(node.expression)) {\n218\t            return node\n219\t        }\n220\t        if (\n221\t            ts.isPropertyAccessExpression(node.expression)\n222\t        ) {\n223\t            return findChainRoot(\n224\t                node.expression.expression\n225\t            )\n226\t       