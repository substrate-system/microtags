{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PzJKAB4aYZT6LojFFXvfkJ","type":"tool_result","content":"1\timport { test } from '@substrate-system/tapzero'\n2\timport ts from 'typescript'\n3\timport { spawnSync } from 'node:child_process'\n4\timport { mkdtempSync } from 'node:fs'\n5\timport { resolve } from 'node:path'\n6\timport { tmpdir } from 'node:os'\n7\t\n8\t// Will import from src once it exists\n9\timport { transform } from '../src/build.js'\n10\t\n11\t/**\n12\t * Parse source and return whether any `.render(` call exists\n13\t * in a define chain (a call chain rooted at a `define(...)` call).\n14\t */\n15\tfunction hasRenderInDefineChain (code:string):boolean {\n16\t    const sf = ts.createSourceFile(\n17\t        'test.ts', code, ts.ScriptTarget.Latest, true\n18\t    )\n19\t    let found = false\n20\t    function visit (node:ts.Node) {\n21\t        if (\n22\t            ts.isCallExpression(node) &&\n23\t            ts.isPropertyAccessExpression(node.expression) &&\n24\t            node.expression.name.text === 'render'\n25\t        ) {\n26\t            if (isDefineChainRoot(node.expression.expression)) {\n27\t                found = true\n28\t            }\n29\t        }\n30\t        ts.forEachChild(node, visit)\n31\t    }\n32\t    ts.forEachChild(sf, visit)\n33\t    return found\n34\t}\n35\t\n36\tfunction isDefineChainRoot (node:ts.Node):boolean {\n37\t    if (\n38\t        ts.isCallExpression(node) &&\n39\t        ts.isIdentifier(node.expression)\n40\t    ) {\n41\t        return node.expression.text === 'define' ||\n42\t            node.expression.text === 'd'\n43\t    }\n44\t    if (\n45\t        ts.isCallExpression(node) &&\n46\t        ts.isPropertyAccessExpression(node.expression)\n47\t    ) {\n48\t        return isDefineChainRoot(node.expression.expression)\n49\t    }\n50\t    return false\n51\t}\n52\t\n53\ttest('strip: define chain .render() is removed', t => {\n54\t    const input = `\n55\timport { define } from 'microtags'\n56\tconst El = define('my-el')\n57\t    .render(() => '<p>hi</p>')\n58\t    .setup(() => {})\n59\t`\n60\t    const result = transform(input)\n61\t    t.ok(!hasRenderInDefineChain(result.code),\n62\t        'no .render() call in define chain after transform')\n63\t    t.ok(result.code.includes('.setup('),\n64\t        'setup call is preserved')\n65\t})\n66\t\n67\ttest('strip: works with aliased import', t => {\n68\t    const input = `\n69\timport { define as d } from 'microtags'\n70\tconst El = d('my-el')\n71\t    .render(() => '<p>hi</p>')\n72\t    .setup(() => {})\n73\t`\n74\t    const result = transform(input)\n75\t    t.ok(!hasRenderInDefineChain(result.code),\n76\t        'no .render() call with aliased define')\n77\t})\n78\t\n79\ttest('keep: client:true preserves .render()', t => {\n80\t    const input = `\n81\timport { define } from 'microtags'\n82\tconst El = define('my-el')\n83\t    .render(() => '<p>hi</p>', { client: true })\n84\t    .setup(() => {})\n85\t`\n86\t    const result = transform(input)\n87\t    t.ok(hasRenderInDefineChain(result.code),\n88\t        '.render() with client:true is kept')\n89\t})\n90\t\n91\ttest('keep: keep option preserves .render() by tag name', t => {\n92\t    const input = `\n93\timport { define } from 'microtags'\n94\tconst El = define('my-tag')\n95\t    .render(() => '<p>hi</p>')\n96\t    .setup(() => {})\n97\t`\n98\t    const result = transform(input, { keep: ['my-tag'] })\n99\t    t.ok(hasRenderInDefineChain(result.code),\n100\t        '.render() kept when tag in keep list')\n101\t})\n102\t\n103\ttest('keep: different tag name still strips', t => {\n104\t    const input = `\n105\timport { define } from 'microtags'\n106\tconst El = define('my-tag')\n107\t    .render(() => '<p>hi</p>')\n108\t    .setup(() => {})\n109\t`\n110\t    const result = transform(input, { keep: ['other-tag'] })\n111\t    t.ok(!hasRenderInDefineChain(result.code),\n112\t        '.render() stripped when tag not in keep list')\n113\t})\n114\t\n115\ttest('warning: .render() outside define chain', t => {\n116\t    const input = `\n117\timport { define } from 'microtags'\n118\tconst other = { render: (x:any) => x }\n119\tother.render(123)\n120\t`\n121\t    const result = transform(input)\n122\t    t.ok(result.code.includes('other.render('),\n123\t        'non-define .render() call is unchanged')\n124\t    const w = result.warnings.find(\n125\t        w => w.kind === 'outside-chain'\n126\t    )\n127\t    t.ok(w, 'warning of outside-chain kind is emitted')\n128\t    t.ok(typeof w!.line === 'number', 'warning has a line number')\n129\t})\n130\t\n131\ttest('warning: stripped static still referenced', t => {\n132\t    const input = `\n133\timport { define } from 'microtags'\n134\tconst Foo = define('my-foo')\n135\t    .render(() => '<p>hi</p>')\n136\t    .setup(() => {})\n137\t\n138\tFoo.render('test')\n139\t`\n140\t    const result = transform(input)\n141\t    const w = result.warnings.find(\n142\t        w => w.kind === 'stripped-static'\n143\t    )\n144\t    t.ok(w, 'stripped-static warning is emitted')\n145\t})\n146\t\n147\ttest('warning: non-literal tag with keep set', t => {\n148\t    const input = `\n149\timport { define } from 'microtags'\n150\tconst tagVar = 'my-el'\n151\tconst El = define(tagVar)\n152\t    .render(() => '<p>hi</p>')\n153\t    .setup(() => {})\n154\t`\n155\t    const result = transform(input, { keep: ['my-el'] })\n156\t    const w = result.warnings.find(\n157\t        w => w.kind === 'non-literal-tag'\n158\t    )\n159\t    t.ok(w, 'non-literal-tag warning when keep is set')\n160\t})\n161\t\n162\ttest('no warning: non-literal tag without keep', t => {\n163\t    const input = `\n164\timport { define } from 'microtags'\n165\tconst tagVar = 'my-el'\n166\tconst El = define(tagVar)\n167\t    .render(() => '<p>hi</p>')\n168\t    .setup(() => {})\n169\t`\n170\t    const result = transform(input)\n171\t    const w = result.warnings.find(\n172\t        w => w.kind === 'non-literal-tag'\n173\t    )\n174\t    t.ok(!w, 'no non-literal-tag warning without keep')\n175\t})\n176\t\n177\ttest('line count preserved', t => {\n178\t    const input = `import { define } from 'microtags'\n179\tconst El = define('my-el')\n180\t    .render(() => {\n181\t        return '<p>hello</p>'\n182\t    })\n183\t    .setup(() => {})\n184\t`\n185\t    const result = transform(input)\n186\t    const inputLines = input.split('\\n').length\n187\t    const outputLines = result.code.split('\\n').length\n188\t    t.equal(outputLines, inputLines,\n189\t        'output line count equals input line count')\n190\t})\n191\t\n192\ttest('untouched lines are byte-identical', t => {\n193\t    const input = `import { define } from 'microtags'\n194\tconst x = 42\n195\tconst El = define('my-el')\n196\t    .render(() => '<p>hi</p>')\n197\t    .setup(() => {})\n198\tconst y = 'hello'\n199\t`\n200\t    const result = transform(input)\n201\t    const inputLines = input.split('\\n')\n202\t    const outputLines = result.code.split('\\n')\n203\t    // Lines 1 (import), 2 (const x), and last (const y) should\n204\t    // be preserved. We check non-blank output lines match input.\n205\t    t.equal(outputLines[0], inputLines[0], 'import line preserved')\n206\t    t.equal(outputLines[1], inputLines[1], 'const x line preserved')\n207\t    t.equal(\n208\t        outputLines[outputLines.length - 1],\n209\t        inputLines[inputLines.length - 1],\n210\t        'last line preserved'\n211\t    )\n212\t})\n213\t\n214\ttest('non-chained define is left unchanged', t => {\n215\t    const input = `\n216\timport { define } from 'microtags'\n217\tconst b = define('x')\n218\tb.render(() => '<p>hi</p>')\n219\t`\n220\t    const result = transform(input)\n221\t    t.ok(result.code.includes('b.render('),\n222\t        'non-chained .render() is left untouched')\n223\t})\n224\t\n225\tfunction hasImportSpecifier (\n226\t    code:string, specifier:string\n227\t):boolean {\n228\t    const sf = ts.createSourceFile(\n229\t        'test.ts', code, ts.ScriptTarget.Latest, true\n230\t    )\n231\t    let found = false\n232\t    ts.forEachChild(sf, node => {\n233\t        if (\n234\t            ts.isImportDeclaration(node) &&\n235\t            node.importClause?.namedBindings &&\n236\t            ts.isNamedImports(\n237\t                node.importClause.namedBindings\n238\t            )\n239\t        ) {\n240\t            for (const el of\n241\t                node.importClause.namedBindings.elements\n242\t            ) {\n243\t                if (el.name.text === specifier) found = true\n244\t            }\n245\t        }\n246\t    })\n247\t    return found\n248\t}\n249\t\n250\tfunction hasImportFrom (\n251\t    code:string, moduleSpecifier:string\n252\t):boolean {\n253\t    const sf = ts.createSourceFile(\n254\t        'test.ts', code, ts.ScriptTarget.Latest, true\n255\t    )\n256\t    let found = false\n257\t    ts.forEachChild(sf, node => {\n258\t        if (\n259\t            ts.isImportDeclaration(node) &&\n260\t            ts.isStringLiteral(node.moduleSpecifier) &&\n261\t            node.moduleSpecifier.text === moduleSpecifier\n262\t        ) {\n263\t            found = true\n264\t        }\n265\t    })\n266\t    return found\n267\t}\n268\t\n269\tfunction hasTopLevelDeclaration (\n270\t    code:string, name:string\n271\t):boolean {\n272\t    const sf = ts.createSourceFile(\n273\t        'test.ts', code, ts.ScriptTarget.Latest, true\n274\t    )\n275\t    let found = false\n276\t    ts.forEachChild(sf, node => {\n277\t        if (\n278\t            ts.isVariableStatement(node)\n279\t        ) {\n280\t            for (const decl of\n281\t                node.declarationList.declarations\n282\t            ) {\n283\t                if (\n284\t                    ts.isIdentifier(decl.name) &&\n285\t                    decl.name.text === name\n286\t                ) {\n287\t                    found = true\n288\t                }\n289\t            }\n290\t        }\n291\t        if (\n292\t            ts.isFunctionDeclaration(node) &&\n293\t            node.name?.text === name\n294\t        ) {\n295\t            found = true\n296\t        }\n297\t        if (\n298\t            ts.isClassDeclaration(node) &&\n299\t            node.name?.text === name\n300\t        ) {\n301\t            found = true\n302\t        }\n303\t    })\n304\t    return found\n305\t}\n306\t\n307\ttest('cascade: import used only in render is removed', t => {\n308\t    const input = `\n309\timport { define } from 'microtags'\n310\timport { html } from 'microtags/htm'\n311\tconst El = define('my-el')\n312\t    .render(() => html\\`<p>hi</p>\\`)\n313\t    .setup(() => {})\n314\tconsole.log(El)\n315\t`\n316\t    const result = transform(input, { cascade: true })\n317\t    t.ok(!hasImportFrom(result.code, 'microtags/htm'),\n318\t        'import from microtags/htm is removed')\n319\t    t.ok(hasImportFrom(result.code, 'microtags'),\n320\t        'import from microtags remains')\n321\t})\n322\t\n323\ttest('cascade: mixed import keeps live specifier', t => {\n324\t    const input = `\n325\timport { define } from 'microtags'\n326\timport { html, raw } from 'microtags/htm'\n327\tconst El = define('my-el')\n328\t    .render(() => html\\`<p>hi</p>\\`)\n329\t    .setup(() => {})\n330\tconsole.log(El, raw('x'))\n331\t`\n332\t    const result = transform(input, { cascade: true })\n333\t    t.ok(!hasImportSpecifier(result.code, 'html'),\n334\t        'dead specifier html is removed')\n335\t    t.ok(hasImportSpecifier(result.code, 'raw'),\n336\t        'live specifier raw remains')\n337\t})\n338\t\n339\ttest('cascade: top-level const removed', t => {\n340\t    const input = `\n341\timport { define } from 'microtags'\n342\tconst tpl = '<p>hi</p>'\n343\tconst El = define('my-el')\n344\t    .render(() => tpl)\n345\t    .setup(() => {})\n346\tconsole.log(El)\n347\t`\n348\t    const result = transform(input, { cascade: true })\n349\t    t.ok(!hasTopLevelDeclaration(result.code, 'tpl'),\n350\t        'const used only in render is removed')\n351\t    t.ok(hasTopLevelDeclaration(result.code, 'El'),\n352\t        'El remains (still referenced)')\n353\t})\n354\t\n355\ttest('cascade: top-level let removed', t => {\n356\t    const input = `\n357\timport { define } from 'microtags'\n358\tlet tpl = '<p>hi</p>'\n359\tconst El = define('my-el')\n360\t    .render(() => tpl)\n361\t    .setup(() => {})\n362\tconsole.log(El)\n363\t`\n364\t    const result = transform(input, { cascade: true })\n365\t    t.ok(!hasTopLevelDeclaration(result.code, 'tpl'),\n366\t        'let used only in render is removed')\n367\t})\n368\t\n369\ttest('cascade: top-level function removed', t => {\n370\t    const input = `\n371\timport { define } from 'microtags'\n372\tfunction renderEl () { return '<p>hi</p>' }\n373\tconst El = define('my-el')\n374\t    .render(() => renderEl())\n375\t    .setup(() => {})\n376\tconsole.log(El)\n377\t`\n378\t    const result = transform(input, { cascade: true })\n379\t    t.ok(!hasTopLevelDeclaration(result.code, 'renderEl'),\n380\t        'function used only in render is removed')\n381\t})\n382\t\n383\ttest('cascade: top-level class removed', t => {\n384\t    const input = `\n385\timport { define } from 'microtags'\n386\tclass Tpl { run () { return '<p>hi</p>' } }\n387\tconst El = define('my-el')\n388\t    .render(() => new Tpl().run())\n389\t    .setup(() => {})\n390\tconsole.log(El)\n391\t`\n392\t    const result = transform(input, { cascade: true })\n393\t    t.ok(!hasTopLevelDeclaration(result.code, 'Tpl'),\n394\t        'class used only in render is removed')\n395\t})\n396\t\n397\ttest('cascade: transitive dead declaration removed', t => {\n398\t    const input = `\n399\timport { define } from 'microtags'\n400\tconst helper = () => 'hi'\n401\tconst tpl = helper()\n402\tconst El = define('my-el')\n403\t    .render(() => tpl)\n404\t    .setup(() => {})\n405\tconsole.log(El)\n406\t`\n407\t    const result = transform(input, { cascade: true })\n408\t    t.ok(!hasTopLevelDeclaration(result.code, 'tpl'),\n409\t        'tpl removed on first pass')\n410\t    t.ok(!hasTopLevelDeclaration(result.code, 'helper'),\n411\t        'helper removed on second pass (cascade)')\n412\t})\n413\t\n414\ttest('cascade: side-effect import preserved', t => {\n415\t    const input = `\n416\timport { define } from 'microtags'\n417\timport './side-effect.js'\n418\tconst tpl = '<p>hi</p>'\n419\tconst El = define('my-el')\n420\t    .render(() => tpl)\n421\t    .setup(() => {})\n422\tconsole.log(El)\n423\t`\n424\t    const result = transform(input, { cascade: true })\n425\t    t.ok(hasImportFrom(result.code, './side-effect.js'),\n426\t        'side-effect import remains')\n427\t})\n428\t\n429\ttest('cascade: exported declaration preserved', t => {\n430\t    const input = `\n431\timport { define } from 'microtags'\n432\texport const tpl = '<p>hi</p>'\n433\tconst El = define('my-el')\n434\t    .render(() => tpl)\n435\t    .setup(() => {})\n436\tconsole.log(El)\n437\t`\n438\t    const result = transform(input, { cascade: true })\n439\t    t.ok(hasTopLevelDeclaration(result.code, 'tpl'),\n440\t        'exported const remains even with no refs')\n441\t})\n442\t\n443\ttest('cascade: declaration used by setup remains', t => {\n444\t    const input = `\n445\timport { define } from 'microtags'\n446\tconst shared = 'hello'\n447\tconst El = define('my-el')\n448\t    .render(() => shared)\n449\t    .setup(() => { console.log(shared) })\n450\tconsole.log(El)\n451\t`\n452\t    const result = transform(input, { cascade: true })\n453\t    t.ok(hasTopLevelDeclaration(result.code, 'shared'),\n454\t        'declaration used in setup remains')\n455\t})\n456\t\n457\ttest('cascade: line count preserved', t => {\n458\t    const input = `import { define } from 'microtags'\n459\timport { html } from 'microtags/htm'\n460\tconst helper = () => 'hi'\n461\tconst tpl = helper()\n462\tconst El = define('my-el')\n463\t    .render(() => {\n464\t        return html\\`<p>\\${tpl}</p>\\`\n465\t    })\n466\t    .setup(() => {})\n467\tconsole.log(El)\n468\t`\n469\t    const result = transform(input, { cascade: true })\n470\t    const inputLines = input.split('\\n').length\n471\t    const outputLines = result.code.split('\\n').length\n472\t    t.equal(outputLines, inputLines,\n473\t        'line count preserved after cascade')\n474\t})\n475\t\n476\ttest('cascade off: dead imports remain', t => {\n477\t    const input = `\n478\timport { define } from 'microtags'\n479\timport { html } from 'microtags/htm'\n480\tconst El = define('my-el')\n481\t    .render(() => html\\`<p>hi</p>\\`)\n482\t    .setup(() => {})\n483\tconsole.log(El)\n484\t`\n485\t    const result = transform(input)\n486\t    t.ok(hasImportFrom(result.code, 'microtags/htm'),\n487\t        'import remains without cascade')\n488\t})\n489\t\n490\tconst SUPPORT = 'microtags/render-support'\n491\t\n492\tfunction countImportsFrom (code:string, moduleSpecifier:string):number {\n493\t    const sf = ts.createSourceFile(\n494\t        'test.ts', code, ts.ScriptTarget.Latest, true\n495\t    )\n496\t    return sf.statements.filter(node =>\n497\t        ts.isImportDeclaration(node) &&\n498\t        ts.isStringLiteral(node.moduleSpecifier) &&\n499\t        node.moduleSpecifier.text === moduleSpecifier\n500\t    ).length\n501\t}\n502\t\n503\tconst keptInput = `import { define } from 'microtags'\n504\timport { html } from 'microtags/htm'\n505\tconst tpl = '<p>hi</p>'\n506\tconst El = define('my-el')\n507\t    .render(() => html\\`\\${tpl}\\`, { client: true })\n508\t    .setup(() => {})\n509\tconsole.log(El)\n510\t`\n511\t\n512\tconst strippedInput = `import { define } from 'microtags'\n513\timport { html } from 'microtags/htm'\n514\tconst tpl = '<p>hi</p>'\n515\tconst El = define('my-el')\n516\t    .render(() => html\\`\\${tpl}\\`)\n517\t    .setup(() => {})\n518\tconsole.log(El)\n519\t`\n520\t\n521\ttest('support: a kept render link adds one support import', t => {\n522\t    const once = transform(keptInput).code\n523\t    t.equal(countImportsFrom(once, SUPPORT), 1,\n524\t        'one support import after the first transform')\n525\t    const twice = transform(once).code\n526\t    t.equal(countImportsFrom(twice, SUPPORT), 1,\n527\t        'still one support import after a second transform')\n528\t})\n529\t\n530\ttest('support: a link kept by tag name adds the import', t => {\n531\t    const code = transform(strippedInput, { keep: ['my-el'] }).code\n532\t    t.equal(countImportsFrom(code, SUPPORT), 1, 'support import added')\n533\t})\n534\t\n535\ttest('support: kept link under cascade keeps the import', t => {\n536\t    const code = transform(keptInput, { cascade: true }).code\n537\t    t.equal(countImportsFrom(code, SUPPORT), 1, 'support import added')\n538\t    const again = transform(code, { cascade: true }).code\n539\t    t.equal(countImportsFrom(again, SUPPORT), 1, 'no second import')\n540\t})\n541\t\n542\ttest('support: the import does not shift existing lines', t => {\n543\t    const code = transform(keptInput).code\n544\t    const inLines = keptInput.split('\\n')\n545\t    const outLines = code.split('\\n')\n546\t    t.deepEqual(outLines.slice(0, inLines.length - 1),\n547\t        inLines.slice(0, -1), 'original lines are unchanged')\n548\t})\n549\t\n550\ttest('support: all links stripped adds no support import', t => {\n551\t    const code = transform(strippedInput).code\n552\t    t.equal(countImportsFrom(code, SUPPORT), 0, 'no support import')\n553\t    const cascaded = transform(strippedInput, { cascade: true }).code\n554\t    t.equal(countImportsFrom(cascaded, SUPPORT), 0,\n555\t        'no support import after cascade')\n556\t})\n557\t\n558\ttest('support: a module with no define adds no import', t => {\n559\t    const code = transform('export const x = 1\\n').code\n560\t    t.equal(countImportsFrom(code, SUPPORT), 0, 'no support import')\n561\t})\n562\t\n563\t/**\n564\t * Bundle the build entry from source in the given format, with\n565\t * typescript left external, and run it with node in `cwd`.\n566\t * Returns stderr.\n567\t */\n568\tfunction loadEntry (format:'esm'|'cjs', cwd:string):string {\n569\t    const code = spawnSync('npx', [\n570\t        'esbuild', 'src/build.ts', '--bundle', '--platform=node',\n571\t        '--packages=external', `--format=${format}`,\n572\t    ], { encoding: 'utf8' }).stdout\n573\t    const args = format === 'esm' ? ['--input-type=module'] : []\n574\t    const result = spawnSync('node', args, {\n575\t        input: code,\n576\t        cwd,\n577\t        encoding: 'utf8',\n578\t    })\n579\t    return result.stderr\n580\t}\n581\t\n582\ttest('loading without require explains the built form', t => {\n583\t    const stderr = loadEntry('esm', process.cwd())\n584\t    t.ok(/require/.test(stderr) && /built/.test(stderr),\n585\t        'error mentions require and the built form')\n586\t    t.ok(!/peer dependency/.test(stderr),\n587\t        'error does not claim typescript is missing')\n588\t})\n589\t\n590\ttest('typescript that does not resolve gives the peer message', t => {\n591\t    const stderr = loadEntry('cjs', mkdtempSync(resolve(tmpdir(), 'mt-')))\n592\t    t.ok(/peer dependency/.test(stderr),\n593\t        'error says typescript is a missing peer dependency')\n594\t})\n595\t\n596\ttest('a vite config importing source does not blame typescript', t => {\n597\t    const result = spawnSync('npx', [\n598\t        'vite', 'build', '--config',\n599\t        'test/fixtures/vite-config-src/vite.config.ts',\n600\t    ], { encoding: 'utf8' })\n601\t    const output = result.stdout + result.stderr\n602\t    t.ok(result.status !== 0, 'the config fails to load')\n603\t    t.ok(/built form/.test(output), 'error points at the built form')\n604\t    t.ok(!/peer dependency/.test(output),\n605\t        'error does not claim typescript is missing')\n606\t})\n607\t"}]},"parent_tool_use_id":"toolu_014UPCKmnimWAFbXhXsD2n9Y","agent_id":"a58061a4bd1065694","session_id":"6cc07e3d-f14d-4f74-8232-b688abdf9fde","uuid":"312bdc24-10d6-46f2-8be8-330928ec7d48","timestamp":"2026-11-24T09:58:09.860Z","tool_result_meta":[{"id":"toolu_01PzJKAB4aYZT6LojFFXvfkJ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"fork","task_description":"Read key source files"}
