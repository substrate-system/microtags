before reset')\n3439\t    form.reset()\n3440\t    t.equal(resetCalled, true, 'reset handler called')\n3441\t    const after = new FormData(form)\n3442\t    t.equal(after.get('v'), 'default',\n3443\t        'FormData shows default after reset')\n3444\t    form.remove()\n3445\t})\n3446\t\n3447\ttest('formLifecycle: fieldset disabled calls disabled handler',\n3448\t    t => {\n3449\t        const form = document.createElement('form')\n3450\t        const tag = 'fl-dis-' +\n3451\t            Math.random().toString(36).slice(2, 8)\n3452\t        form.innerHTML = `<fieldset><${tag} name=\"d\"></${tag}>`\n3453\t            + '</fieldset>'\n3454\t        document.body.appendChild(form)\n3455\t\n3456\t        const calls:boolean[] = []\n3457\t        define(tag)\n3458\t            .formAssociated()\n3459\t            .setup(ctx => {\n3460\t                ctx.form({\n3461\t                    disabled: (d) => { calls.push(d) },\n3462\t                })\n3463\t            })\n3464\t\n3465\t        const fs = form.querySelector('fieldset')!\n3466\t        fs.disabled = true\n3467\t        t.deepEqual(calls, [true], 'disabled(true) called')\n3468\t        fs.disabled = false\n3469\t        t.deepEqual(calls, [true, false],\n3470\t            'disabled(false) called')\n3471\t        form.remove()\n3472\t    })\n3473\t\n3474\ttest('formLifecycle: associated handler on form move', t => {\n3475\t    const form = document.createElement('form')\n3476\t    const tag = 'fl-assoc-' +\n3477\t        Math.random().toString(36).slice(2, 8)\n3478\t    const host = document.createElement(tag)\n3479\t    host.setAttribute('name', 'a')\n3480\t    document.body.appendChild(host)\n3481\t    document.body.appendChild(form)\n3482\t\n3483\t    const calls:(HTMLFormElement|null)[] = []\n3484\t    define(tag)\n3485\t        .formAssociated()\n3486\t        .setup(ctx => {\n3487\t            ctx.form({\n3488\t                associated: (f) => { calls.push(f) },\n3489\t            })\n3490\t        })\n3491\t\n3492\t    // The host is already in the DOM when defined, so the browser\n3493\t    // may fire formAssociatedCallback with null during setup (not\n3494\t    // in a form). Then moving it into a form fires with that form.\n3495\t    form.appendChild(host)\n3496\t    t.equal(calls[calls.length - 1], form,\n3497\t        'associated called with form')\n3498\t    document.body.appendChild(host)\n3499\t    t.equal(calls[calls.length - 1], null,\n3500\t        'associated called with null')\n3501\t    host.remove()\n3502\t    form.remove()\n3503\t})\n3504\t\n3505\ttest('formLifecycle: restore callback via direct call', t => {\n3506\t    const form = document.createElement('form')\n3507\t    const tag = 'fl-rest-' +\n3508\t        Math.random().toString(36).slice(2, 8)\n3509\t    form.innerHTML = `<${tag} name=\"r\"></${tag}>`\n3510\t    document.body.appendChild(form)\n3511\t\n3512\t    let restored:[unknown, string]|null = null\n3513\t    define(tag)\n3514\t        .formAssociated()\n3515\t        .setup(ctx => {\n3516\t            ctx.form({\n3517\t                restore: (state, mode) => {\n3518\t                    restored = [state, mode]\n3519\t                },\n3520\t            })\n3521\t        })\n3522\t\n3523\t    const host = form.querySelector(tag)! as any\n3524\t    host.formStateRestoreCallback('saved', 'restore')\n3525\t    t.deepEqual(restored, ['saved', 'restore'],\n3526\t        'restore handler received state and mode')\n3527\t    form.remove()\n3528\t})\n3529\t\n3530\ttest('formLifecycle: second ctx.form() replaces first', t => {\n3531\t    const form = document.createElement('form')\n3532\t    const tag = 'fl-repl-' +\n3533\t        Math.random().toString(36).slice(2, 8)\n3534\t    form.innerHTML = `<${tag} name=\"rp\"></${tag}>`\n3535\t    document.body.appendChild(form)\n3536\t\n3537\t    let first = 0\n3538\t    let second = 0\n3539\t    define(tag)\n3540\t        .formAssociated()\n3541\t        .setup(ctx => {\n3542\t            ctx.form({ reset: () => { first++ } })\n3543\t            ctx.form({ reset: () => { second++ } })\n3544\t        })\n3545\t\n3546\t    form.reset()\n3547\t    t.equal(first, 0, 'first handler not called')\n3548\t    t.equal(second, 1, 'second handler called')\n3549\t    form.remove()\n3550\t})\n3551\t\n3552\ttest('formLifecycle: handlers dropped after teardown',\n3553\t    async t => {\n3554\t        const form = document.createElement('form')\n3555\t        const tag = 'fl-tear-' +\n3556\t            Math.random().toString(36).slice(2, 8)\n3557\t        form.innerHTML = `<${tag} name=\"td\"></${tag}>`\n3558\t        document.body.appendChild(form)\n3559\t\n3560\t        let resets = 0\n3561\t        define(tag)\n3562\t            .formAssociated()\n3563\t            .setup(ctx => {\n3564\t                ctx.form({ reset: () => { resets++ } })\n3565\t            })\n3566\t\n3567\t        form.reset()\n3568\t        t.equal(resets, 1, 'handler called while connected')\n3569\t\n3570\t        const host = form.querySelector(tag)!\n3571\t        host.remove()\n3572\t        await Promise.resolve()\n3573\t\n3574\t        // The host's teardown ran; calling the callback directly\n3575\t        // should not call the old handler.\n3576\t        ;(host as any).formResetCallback?.()\n3577\t        t.equal(resets, 1, 'handler not called after teardown')\n3578\t        form.remove()\n3579\t    })\n3580\t\n3581\ttest('formLifecycle: restore replayed when handler registers' +\n3582\t    ' late', t => {\n3583\t    const form = document.createElement('form')\n3584\t    const tag = 'fl-replay-' +\n3585\t        Math.random().toString(36).slice(2, 8)\n3586\t    form.innerHTML = `<${tag} name=\"rpl\"></${tag}>`\n3587\t    document.body.appendChild(form)\n3588\t\n3589\t    let restored:[unknown, string]|null = null\n3590\t    const host = form.querySelector(tag)! as any\n3591\t\n3592\t    const token = createContext<number>()\n3593\t\n3594\t    define(tag)\n3595\t        .formAssociated()\n3596\t        .withContexts(() => ({ c: token }))\n3597\t        .setup(ctx => {\n3598\t            ctx.form({\n3599\t                restore: (state, mode) => {\n3600\t                    restored = [state, mode]\n3601\t                },\n3602\t            })\n3603\t        })\n3604\t\n3605\t    // Setup has not run because the context is missing.\n3606\t    host.formStateRestoreCallback('early', 'restore')\n3607\t    t.equal(restored, null,\n3608\t        'restore not delivered before setup')\n3609\t\n3610\t    // Provide the context so setup runs.\n3611\t    provide(form, token, 42)\n3612\t    t.deepEqual(restored, ['early', 'restore'],\n3613\t        'pending restore replayed')\n3614\t    form.remove()\n3615\t})\n3616\t\n3617\ttest('formLifecycle: early reset/disabled not replayed', t => {\n3618\t    const form = document.createElement('form')\n3619\t    const tag = 'fl-norepl-' +\n3620\t        Math.random().toString(36).slice(2, 8)\n3621\t    form.innerHTML = `<${tag} name=\"nr\"></${tag}>`\n3622\t    document.body.appendChild(form)\n3623\t\n3624\t    const host = form.querySelector(tag)! as any\n3625\t    const token = createContext<number>()\n3626\t\n3627\t    let resets = 0\n3628\t    const disabledCalls:boolean[] = []\n3629\t\n3630\t    define(tag)\n3631\t        .formAssociated()\n3632\t        .withContexts(() => ({ c: token }))\n3633\t        .setup(ctx => {\n3634\t            ctx.form({\n3635\t                reset: () => { resets++ },\n3636\t                disabled: (d) => { disabledCalls.push(d) },\n3637\t            })\n3638\t        })\n3639\t\n3640\t    // Setup has not run (context missing). Fire callbacks early.\n3641\t    host.formResetCallback()\n3642\t    host.formDisabledCallback(true)\n3643\t\n3644\t    // Now provide the context so setup runs.\n3645\t    provide(form, token, 1)\n3646\t\n3647\t    // The early reset and disabled should NOT have been replayed.\n3648\t    t.equal(resets, 0,\n3649\t        'early reset not replayed')\n