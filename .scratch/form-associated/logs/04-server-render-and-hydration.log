{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WR8tLyQg3aADpuppywuebu","type":"tool_result","content":"1\timport { spawnSync } from 'node:child_process'\n2\timport {\n3\t    mkdtempSync,\n4\t    readFileSync,\n5\t    rmSync,\n6\t    writeFileSync,\n7\t} from 'node:fs'\n8\timport { tmpdir } from 'node:os'\n9\timport { join, resolve } from 'node:path'\n10\timport { test } from '@substrate-system/tapzero'\n11\timport { signal, effect } from 'alien-signals'\n12\timport { define } from '../src/index.js'\n13\timport { transform } from '../src/build.js'\n14\timport {\n15\t    coerceNumber,\n16\t    coerceString,\n17\t    coerceBoolean,\n18\t    coerceJson,\n19\t} from '../src/util.js'\n20\t\n21\t// These tests run under Node with no DOM (see `npm run test:ssr`).\n22\t// They verify the server-side-rendering contract: microtags can define\n23\t// components and expose the statics needed to build markup without a\n24\t// browser. The component lifecycle (connect/setup/refs) is exercised by\n25\t// the browser suite in test/index.ts.\n26\t\n27\ttest('SSR environment has no DOM globals', t => {\n28\t    t.equal(typeof document, 'undefined', 'document is not defined')\n29\t    t.equal(typeof HTMLElement, 'undefined', 'HTMLElement is not defined')\n30\t    t.equal(\n31\t        typeof customElements,\n32\t        'undefined',\n33\t        'customElements is not defined'\n34\t    )\n35\t})\n36\t\n37\ttest('define().setup() works without a DOM', t => {\n38\t    // A throw here (e.g. touching HTMLElement/customElements) fails the\n39\t    // test. setup never runs server-side (nothing connects), but its body\n40\t    // must still load at define time without a browser.\n41\t    const El = define('ssr-widget')\n42\t        .withProps(p => ({ start: p.number() }))\n43\t        .withRefs(r => ({ display: r.one(), inc: r.one() }))\n44\t        .setup(ctx => {\n45\t            const count = signal(ctx.props.start())\n46\t            effect(() => { count() })  // track the signal\n47\t        })\n48\t\n49\t    t.ok(El, 'defining a component returns the element class')\n50\t})\n51\t\n52\ttest('element class exposes TAG and refs as statics', t => {\n53\t    const El = define('ssr-counter')\n54\t        .withProps(p => ({ start: p.number() }))\n55\t        .withRefs(r => ({ display: r.one(), inc: r.one(), dec: r.one() }))\n56\t        .setup(() => {})\n57\t\n58\t    t.equal(El.TAG, 'ssr-counter', 'TAG is the registered tag name')\n59\t    t.deepEqual(\n60\t        { ...El.refs },\n61\t        { display: 'display', inc: 'inc', dec: 'dec' },\n62\t        'refs maps each declared key to its own data-ref name'\n63\t    )\n64\t})\n65\t\n66\ttest('render link: class exposes render function and props list', t => {\n67\t    const El = define('ssr-render-basic')\n68\t        .withProps(p => ({\n69\t            count: p.number(),\n70\t            label: p.string(),\n71\t        }))\n72\t        .withRefs(r => ({ display: r.one() }))\n73\t        .render(({ refs, children }) => {\n74\t            return `<span data-ref=\"${refs.display}\">${children}</span>`\n75\t        })\n76\t        .setup(() => {})\n77\t\n78\t    t.equal(\n79\t        typeof El.render,\n80\t        'function',\n81\t        'static render is a function'\n82\t    )\n83\t    t.deepEqual(\n84\t        El.props,\n85\t        ['count', 'label'],\n86\t        'static props lists declared prop names in order'\n87\t    )\n88\t})\n89\t\n90\ttest('render: without the support module, both statics throw naming it', t => {\n91\t    // A separate process, because this suite imports the templater,\n92\t    // which registers the server render support module.\n93\t    const code = spawnSync('npx', [\n94\t        'esbuild', 'test/fixtures/render-unregistered.ts', '--bundle',\n95\t        '--platform=node', '--format=cjs',\n96\t    ], { encoding: 'utf8' }).stdout\n97\t    const out = spawnSync('node', [], { input: code, encoding: 'utf8' })\n98\t        .stdout\n99\t    const [render, parts] = out.split('\\n')\n100\t    t.ok(render.startsWith('threw: '), 'render throws')\n101\t    t.ok(render.includes('microtags/render-support'),\n102\t        'the error names the support module')\n103\t    t.ok(parts.startsWith('threw: '), 'renderParts throws')\n104\t    t.ok(parts.includes('microtags/render-support'),\n105\t        'the renderParts error names the support module')\n106\t})\n107\t\n108\ttest('render: static render returns host tag wrapping inner content', t => {\n109\t    const El = define('ssr-render-output')\n110\t        .withProps(p => ({ count: p.number() }))\n111\t        .render(({ props }) => {\n112\t            return `<span>${props.count}</span>`\n113\t        })\n114\t        .setup(() => {})\n115\t\n116\t    const result = El.render({ count: 5 })\n117\t\n118\t    // Parse the output structurally\n119\t    const match = result.match(\n120\t        /^<([a-z-]+)[^>]*>([\\s\\S]*)<\\/([a-z-]+)>$/\n121\t    )\n122\t    t.ok(match, 'output is a complete HTML element')\n123\t    t.equal(match![1], 'ssr-render-output', 'root tag is the host')\n124\t    t.equal(match![3], 'ssr-render-output', 'closing tag matches')\n125\t    t.ok(\n126\t        match![2].includes('<span>5</span>'),\n127\t        'inner content from render function is present'\n128\t    )\n129\t})\n130\t\n131\ttest('render: fn receives props, refs, TAG, children, attrs', t => {\n132\t    let captured:Record<string, unknown> = {}\n133\t\n134\t    const El = define('ssr-render-ctx')\n135\t        .withProps(p => ({ label: p.string() }))\n136\t        .withRefs(r => ({ slot: r.one() }))\n137\t        .render((ctx) => {\n138\t            captured = {\n139\t                propsLabel: ctx.props.label,\n140\t                refsSlot: ctx.refs.slot,\n141\t                TAG: ctx.TAG,\n142\t                children: ctx.children,\n143\t                attrsClass: ctx.attrs.class,\n144\t            }\n145\t            return '<div></div>'\n146\t        })\n147\t        .setup(() => {})\n148\t\n149\t    El.render(\n150\t        { label: 'hello' },\n151\t        {\n152\t            children: '<em>child</em>',\n153\t            attrs: { class: 'big' },\n154\t        }\n155\t    )\n156\t\n157\t    t.equal(\n158\t        captured.propsLabel, 'hello',\n159\t        'props are plain values'\n160\t    )\n161\t    t.equal(\n162\t        captured.refsSlot, 'slot',\n163\t        'refs matches static refs'\n164\t    )\n165\t    t.equal(\n166\t        captured.TAG, 'ssr-render-ctx',\n167\t        'TAG matches'\n168\t    )\n169\t    t.equal(\n170\t        captured.children, '<em>child</em>',\n171\t        'children passed through'\n172\t    )\n173\t    t.equal(\n174\t        captured.attrsClass, 'big',\n175\t        'attrs passed through'\n176\t    )\n177\t})\n178\t\n179\ttest('render: coercer round-trip for number, string, boolean, json', t => {\n180\t    const El = define('ssr-roundtrip')\n181\t        .withProps(p => ({\n182\t            n: p.number(),\n183\t            s: p.string(),\n184\t            b: p.boolean(),\n185\t            j: p.json<{ x:number }>(),\n186\t        }))\n187\t        .render(() => '')\n188\t        .setup(() => {})\n189\t\n190\t    const html = El.render({\n191\t        n: 42,\n192\t        s: 'hello',\n193\t        b: true,\n194\t        j: { x: 99 },\n195\t    })\n196\t\n197\t    // Extract attributes from the host tag\n198\t    const nMatch = html.match(/\\bn=\"([^\"]*)\"/)\n199\t    const sMatch = html.match(/\\bs=\"([^\"]*)\"/)\n200\t    const bMatch = html.match(/\\bb(?:=\"[^\"]*\"|\\s|>)/)\n201\t    const jMatch = html.match(/\\bj=\"([^\"]*)\"/)\n202\t\n203\t    // Verify round-trip: parse back with coercers\n204\t    t.equal(\n205\t        coerceNumber(nMatch![1]),\n206\t        42,\n207\t        'number round-trips'\n208\t    )\n209\t    t.equal(\n210\t        coerceString(sMatch![1]),\n211\t        'hello',\n212\t        'string round-trips'\n213\t    )\n214\t    // boolean: bare attribute means present\n215\t    t.ok(bMatch, 'boolean true emits attribute')\n216\t    t.equal(\n217\t        coerceBoolean(''),\n218\t        true,\n219\t        'boolean round-trips'\n220\t    )\n221\t    // json: decode the HTML entities first\n222\t    const jRaw = jMatch![1]\n223\t        .replace(/&quot;/g, '\"')\n224\t        .replace(/&amp;/g, '&')\n225\t        .replace(/&lt;/g, '<')\n226\t        .replace(/&gt;/g, '>')\n227\t        .replace(/&#39;/g, \"'\")\n228\t    t.deepEqual(\n229\t        coerceJson(jRaw),\n230\t        { x: 99 },\n231\t        'json round-trips'\n232\t    )\n233\t})\n234\t\n235\ttest('render: boolean true is bare, false/null/undefined omit, prop-only omits, schema uses String', t => {\n236\t    const El = define('ssr-attr-rules')\n237\t        .withProps(p => ({\n238\t            on: p.boolean(),\n239\t            off: p.boolean(),\n240\t            missing: p.string(),\n241\t            internal: p.prop(42),\n242\t            count: p.number(),\n243\t        }))\n244\t        .render(() => '')\n245\t        .setup(() => {})\n246\t\n247\t    const html = El.render({\n248\t        on: true,\n249\t        off: false,\n250\t        missing: undefined as unknown as string,\n251\t        internal: 42,\n252\t        count: null as unknown as number,\n253\t    })\n254\t\n255\t    // bare attribute for true\n256\t    t.ok(\n257\t        /\\bon(?:\\s|>)/.test(html),\n258\t        'true emits bare attribute'\n259\t    )\n260\t    // false omits\n261\t    t.ok(\n262\t        !html.includes('off'),\n263\t        'false omits attribute'\n264\t    )\n265\t    // undefined omits\n266\t    t.ok(\n267\t        !html.includes('missing'),\n268\t        'undefined omits attribute'\n269\t    )\n270\t    // prop-only never emits\n271\t    t.ok(\n272\t        !html.includes('internal'),\n273\t        'prop-only never emits attribute'\n274\t    )\n275\t    // null omits\n276\t    t.ok(\n277\t        !html.includes('count'),\n278\t        'null omits attribute'\n279\t    )\n280\t})\n281\t\n282\ttest('render: schema prop emits String(value)', t => {\n283\t    const numSchema = {\n284\t        '~standard': {\n285\t            version: 1 as const,\n286\t            vendor: 'test',\n287\t            validate: (value:unknown) => {\n288\t                const n = Number(value)\n289\t                return isNaN(n) ?\n290\t                    { issues: [{ message: 'bad' }] } :\n291\t                    { value: n }\n292\t            },\n293\t        },\n294\t    }\n295\t\n296\t    const El = define('ssr-schema-attr')\n297\t        .withProps(p => ({ val: p.schema(numSchema) }))\n298\t        .render(() => '')\n299\t        .setup(() => {})\n300\t\n301\t    const html = El.render({ val: 123 })\n302\t    t.ok(\n303\t        html.includes('val=\"123\"'),\n304\t        'schema prop serialized with String()'\n305\t    )\n306\t})\n307\t\n308\ttest('render: attribute values with special chars are escaped', t => {\n309\t    const El = define('ssr-escape')\n310\t        .withProps(p => ({ label: p.string() }))\n311\t        .render(() => '')\n312\t        .setup(() => {})\n313\t\n314\t    const special = '<script>\"alert(\\'xss\\')&</script>'\n315\t    const html = El.render({ label: special })\n316\t\n317\t    // The attribute value should not contain raw special chars\n318\t    const attrMatch = html.match(/label=\"([^\"]*)\"/)\n319\t    t.ok(attrMatch, 'label attribute present')\n320\t    const escaped = attrMatch![1]\n321\t    t.ok(!escaped.includes('<'), 'no raw <')\n322\t    t.ok(!escaped.includes('>'), 'no raw >')\n323\t    t.ok(!escaped.includes('\"'), 'no raw \"')\n324\t    t.ok(!escaped.includes(\"'\"), \"no raw '\")\n325\t    // & should only appear as entity prefix\n326\t    t.ok(\n327\t        !escaped.match(/&(?!amp;|lt;|gt;|quot;|#39;)/),\n328\t        'no raw & (only escaped entities)'\n329\t    )\n330\t\n331\t    // Round-trip: unescape and compare\n332\t    const unescaped = escaped\n333\t        .replace(/&lt;/g, '<')\n334\t        .replace(/&gt;/g, '>')\n335\t        .replace(/&quot;/g, '\"')\n336\t        .replace(/&#39;/g, \"'\")\n337\t        .replace(/&amp;/g, '&')\n338\t    t.equal(unescaped, special, 'round-trips after unescaping')\n339\t})\n340\t\n341\ttest('render: client:true option changes nothing', t => {\n342\t    const El = define('ssr-client-true')\n343\t        .withProps(p => ({ n: p.number() }))\n344\t        .render(() => '<b>hi</b>', { client: true })\n345\t        .setup(() => {})\n346\t\n347\t    t.equal(typeof El.render, 'function', 'render is a function')\n348\t    t.deepEqual(El.props, ['n'], 'props list present')\n349\t    const html = El.render({ n: 5 })\n350\t    t.ok(\n351\t        html.includes('<b>hi</b>'),\n352\t        'output contains render content'\n353\t    )\n354\t    t.ok(\n355\t        html.includes('n=\"5\"'),\n356\t        'attribute serialized normally'\n357\t    )\n358\t})\n359\t\n360\t// Attribute names on the opening host tag, in order.\n361\tfunction hostAttrNames (out:string):string[] {\n362\t    const open = out.slice(0, out.indexOf('>') + 1)\n363\t    const names:string[] = []\n364\t    const re = /\\s([^\\s=>]+)(?:=\"[^\"]*\")?/g\n365\t    let m:RegExpExecArray | null\n366\t    while ((m = re.exec(open))) names.push(m[1])\n367\t    return names\n368\t}\n369\t\n370\ttest('render: host tag skips extra attributes with invalid names', t => {\n371\t    const El = define('ssr-bad-attr-name')\n372\t        .withProps(p => ({ n: p.number() }))\n373\t        .render(() => '')\n374\t        .setup(() => {})\n375\t\n376\t    const out = El.render({ n: 1 }, {\n377\t        attrs: {\n378\t            'data-ok': 'yes',\n379\t            'x\" onload=\"alert(1)': 'bad',\n380\t            'a b': 'bad',\n381\t            '1st': 'bad',\n382\t            '': 'bad',\n383\t            'x:y.z_w': 'ok',\n384\t        },\n385\t    })\n386\t\n387\t    t.deepEqual(\n388\t        hostAttrNames(out),\n389\t        ['n', 'data-ok', 'x:y.z_w'],\n390\t        'only valid extra attribute names reach the host tag'\n391\t    )\n392\t    t.ok(!out.includes('onload'), 'hostile key does not break out')\n393\t})\n394\t\n395\ttest('render: declared props serialize unchanged, names unvalidated', t => {\n396\t    // `$odd` is outside the attribute grammar, but declared prop names\n397\t    // come from the builder chain, not data, so they are not checked.\n398\t    const El = define('ssr-declared-names')\n399\t        .withProps(p => ({\n400\t            n: p.number(),\n401\t            on: p.boolean(),\n402\t            s: p.string(),\n403\t            j: p.json<{ a:string }>(),\n404\t            $odd: p.string(),\n405\t        }))\n406\t        .render(() => '')\n407\t        .setup(() => {})\n408\t\n409\t    const out = El.render(\n410\t        { n: 3, on: true, s: 'a\"b', j: { a: '<' }, $odd: 'v' },\n411\t        { attrs: { 'data-x': '1' } }\n412\t    )\n413\t\n414\t    t.equal(\n415\t        out,\n416\t        '<ssr-declared-names n=\"3\" on s=\"a&quot;b\"' +\n417\t            ' j=\"{&quot;a&quot;:&quot;&lt;&quot;}\" $odd=\"v\"' +\n418\t            ' data-x=\"1\"></ssr-declared-names>',\n419\t        'declared props serialize exactly as before'\n420\t    )\n421\t})\n422\t\n423\ttest('render: a declared prop wins over an extra attr of its name', t => {\n424\t    // Changed in 0.1.0: the host used to repeat the name\n425\t    // (`n=\"1\" n=\"2\"`). An HTML parser keeps the first, so the declared\n426\t    // value is the one that counts; now it is the only one emitted.\n427\t    const El = define('ssr-dup-attr')\n428\t        .withProps(p => ({ n: p.number(), m: p.prop(0) }))\n429\t        .render(() => '')\n430\t        .setup(() => {})\n431\t\n432\t    t.equal(\n433\t        El.render({ n: 1, m: 5 }, { attrs: { n: '2' } }),\n434\t        '<ssr-dup-attr n=\"1\"></ssr-dup-attr>',\n435\t        'one attribute, the declared value'\n436\t    )\n437\t    t.equal(\n438\t        El.render({ n: 1, m: 5 }, { attrs: { m: '2' } }),\n439\t        '<ssr-dup-attr n=\"1\" m=\"2\"></ssr-dup-attr>',\n440\t        'a prop-only prop leaves the extra attr in place'\n441\t    )\n442\t})\n443\t\n444\t// html templater SSR tests (no DOM)\n445\timport { html, h, raw, Markup } from '../src/htm.js'\n446\timport { parityCases, stripMarkers } from './parity.js'\n447\t\n448\t// Render parts: the same render as `render`, split into tag, serialized\n449\t// (unescaped) host attributes and inner HTML.\n450\tconst _partsEsc:Record<string, string> = {\n451\t    '&': '&amp;', '\"': '&quot;', \"'\": '&#39;', '<': '&lt;', '>': '&gt;',\n452\t}\n453\t\n454\tfunction assembleParts (p:{\n455\t    tag:string\n456\t    attrs:Record<string, string>\n457\t    html:string\n458\t}):string {\n459\t    let a = ''\n460\t    for (const [k, v] of Object.entries(p.attrs)) {\n461\t        a += v === '' ?\n462\t            ` ${k}` :\n463\t            ` ${k}=\"${v.replace(/[&\"'<>]/g, c => _partsEsc[c])}\"`\n464\t    }\n465\t    return `<${p.tag}${a}>${p.html}</${p.tag}>`\n466\t}\n467\t\n468\tconst _partsSchema = {\n469\t    '~standard': {\n470\t        version: 1 as const,\n471\t        vendor: 'test',\n472\t        validate: (v:unknown) => ({ value: Number(v) }),\n473\t    },\n474\t}\n475\t\n476\tconst PartsEl = define('ssr-parts')\n477\t    .withProps(p => ({\n478\t        n: p.number(),\n479\t        s: p.string(),\n480\t        on: p.boolean(),\n481\t        off: p.boolean(),\n482\t        j: p.json<{ a:string }>(),\n483\t        sch: p.schema(_partsSchema),\n484\t        internal: p.prop(7),\n485\t        gone: p.string(),\n486\t    }))\n487\t    .render(({ props, children }) => {\n488\t        return html`<b>${props.n}</b><i>${raw(children)}</i>`\n489\t    })\n490\t    .setup(() => {})\n491\t\n492\tconst partsProps = {\n493\t    n: 3,\n494\t    s: 'a\"b<c',\n495\t    on: true,\n496\t    off: false,\n497\t    j: { a: '<&>' },\n498\t    sch: 12,\n499\t    internal: 7,\n500\t    gone: null as unknown as string,\n501\t}\n502\t\n503\tconst partsOpts = {\n504\t    children: '<em>kid</em>',\n505\t    attrs: {\n506\t        'data-x': '1 & 2',\n507\t        class: 'big',\n508\t        'x\" onload=\"alert(1)': 'bad',\n509\t        'a b': 'bad',\n510\t    },\n511\t}\n512\t\n513\ttest('renderParts: assembled parts equal render byte for byte', t => {\n514\t    const parts = PartsEl.renderParts(partsProps, partsOpts)\n515\t    t.equal(parts.tag, 'ssr-parts', 'tag is the host tag name')\n516\t    t.equal(\n517\t        assembleParts(parts),\n518\t        PartsEl.render(partsProps, partsOpts),\n519\t        'the host string built from the parts is the render output'\n520\t    )\n521\t    t.equal(\n522\t        assembleParts(PartsEl.renderParts({ n: 1 } as typeof partsProps)),\n523\t        PartsEl.render({ n: 1 } as typeof partsProps),\n524\t        'the same with no options and missing props'\n525\t    )\n526\t})\n527\t\n528\ttest('renderParts: attrs hold declared props, then valid extra attrs', t => {\n529\t    const { attrs } = PartsEl.renderParts(partsProps, partsOpts)\n530\t    t.deepEqual(\n531\t        Object.keys(attrs),\n532\t        ['n', 's', 'on', 'j', 'sch', 'data-x', 'class'],\n533\t        'declared props first, then extra attrs; no prop-only, null,' +\n534\t            ' false or invalid names'\n535\t    )\n536\t    t.equal(attrs.s, 'a\"b<c', 'values are serialized, not escaped')\n537\t    t.equal(attrs.j, '{\"a\":\"<&>\"}', 'json is serialized')\n538\t    t.equal(attrs.sch, '12', 'schema uses String')\n539\t    t.equal(attrs['data-x'], '1 & 2', 'extra attr value is kept')\n540\t})\n541\t\n542\ttest('renderParts: a true boolean is the empty string', t => {\n543\t    const { attrs } = PartsEl.renderParts(partsProps, partsOpts)\n544\t    t.equal(attrs.on, '', 'true boolean serializes to the empty string')\n545\t})\n546\t\n547\ttest('renderParts: a class with no render link has no renderParts', t => {\n548\t    const Plain = define('ssr-parts-none')\n549\t        .withProps(p => ({ n: p.number() }))\n550\t        .setup(() => {})\n551\t    t.ok(!('renderParts' in Plain), 'defined without a render link')\n552\t\n553\t    // The build transform strips the render link from this source.\n554\t    const src = readFileSync('test/fixtures/strip-render.ts', 'utf8')\n555\t    const out = transform(src).code\n556\t    t.ok(!out.includes('.render('), 'the transform stripped the link')\n557\t    // Run the stripped module in its own process, with `microtags`\n558\t    // pointed at the source.\n559\t    const dir = mkdtempSync(join(tmpdir(), 'mt-parts-'))\n560\t    const file = join(dir, 'stripped.ts')\n561\t    writeFileSync(file, out + '\\nconsole.log(' +\n562\t        'typeof Counter.renderParts, typeof Counter.render, Counter.TAG)')\n563\t    const code = spawnSync('npx', [\n564\t        'esbuild', file, '--bundle', '--platform=node', '--format=cjs',\n565\t        '--alias:microtags=' + resolve('src/index.ts'),\n566\t    ], { encoding: 'utf8' }).stdout\n567\t    const ran = spawnSync('node', [], { input: code, encoding: 'utf8' })\n568\t        .stdout.trim()\n569\t    rmSync(dir, { recursive: true })\n570\t    t.equal(ran, 'undefined undefined test-counter',\n571\t        'the stripped class has neither renderParts nor render')\n572\t})\n573\t\n574\ttest('html SSR: html, h, raw return markup with no DOM', t => {\n575\t    const result = html`<div class=\"box\">hello</div>`\n576\t    t.ok(result instanceof Markup, 'html returns markup')\n577\t    t.equal(\n578\t        String(result), '<div class=\"box\">hello</div>',\n579\t        'markup stringifies to the same HTML as before'\n580\t    )\n581\t    t.equal(result.toString(), String(result), 'toString matches')\n582\t\n583\t    const hResult = h('span', { id: 'x' }, 'text')\n584\t    t.equal(\n585\t        typeof String(hResult), 'string',\n586\t        'h result stringifies'\n587\t    )\n588\t\n589\t    const rResult = raw('<em>hi</em>')\n590\t    t.equal(\n591\t        typeof String(rResult), 'string',\n592\t        'raw result stringifies'\n593\t    )\n594\t})\n595\t\n596\ttest('html SSR: element class renders in Node', t => {\n597\t    const El = define('ssr-html-comp')\n598\t        .withProps(p => ({ n: p.number() }))\n599\t        .render(({ props }) => `<b>${props.n}</b>`)\n600\t        .setup(() => {})\n601\t\n602\t    const result = String(html`<${El} n=${7} />`)\n603\t    t.ok(\n604\t        result.includes('ssr-html-comp'),\n605\t        'contains host tag'\n606\t    )\n607\t})\n608\t\n609\ttest('html SSR: escaping works without DOM', t => {\n610\t    const danger = '<img onerror=alert(1)>'\n611\t    const result = String(html`<div>${danger}</div>`)\n612\t    t.ok(\n613\t        !result.includes('<img'),\n614\t        'dangerous markup escaped'\n615\t    )\n616\t})\n617\t\n618\ttest('html SSR: nested markup is not escaped again', t => {\n619\t    const inner = html`<em>${'a&b'}</em>`\n620\t    const outer = String(html`<p>${inner}</p>`)\n621\t    t.equal(outer, '<p><em>a&amp;b</em></p>', 'inner escaped once')\n622\t    const viaRaw = String(html`<p>${raw('<i>x</i>')}</p>`)\n623\t    t.equal(viaRaw, '<p><i>x</i></p>', 'raw passes through')\n624\t})\n625\t\n626\ttest('html SSR: array of markup in child position flattens', t => {\n627\t    const items = ['a', 'b'].map(x => html`<li>${x}</li>`)\n628\t    t.equal(\n629\t        String(html`<ul>${items}</ul>`),\n630\t        '<ul><li>a</li><li>b</li></ul>',\n631\t        'array flattens'\n632\t    )\n633\t    t.equal(\n634\t        String(html`<li>a</li><li>b</li>`),\n635\t        '<li>a</li><li>b</li>',\n636\t        'top-level fragment flattens'\n637\t    )\n638\t})\n639\t\n640\ttest('html SSR: render returning markup matches render returning string',\n641\t    t => {\n642\t        const A = define('ssr-markup-a')\n643\t            .withProps(p => ({ n: p.number() }))\n644\t            .render(({ props }) => html`<b>${props.n}</b>`)\n645\t            .setup(() => {})\n646\t        const B = define('ssr-markup-b')\n647\t            .withProps(p => ({ n: p.number() }))\n648\t            .render(({ props }) => `<b>${props.n}</b>`)\n649\t            .setup(() => {})\n650\t        const a = String(html`<${A} n=${3} />`)\n651\t        const b = String(html`<${B} n=${3} />`)\n652\t        t.equal(\n653\t            a.replace(/ssr-markup-a/g, 'X'),\n654\t            b.replace(/ssr-markup-b/g, 'X'),\n655\t            'same host HTML'\n656\t        )\n657\t        t.equal(A.render({ n: 3 }), html`<${A} n=${3} />`.toString(),\n658\t            'static render returns the host string')\n659\t    })\n660\t\n661\ttest('html SSR: declared string prop is escaped exactly once', t => {\n662\t    const El = define('ssr-markup-esc')\n663\t        .withProps(p => ({ label: p.string() }))\n664\t        .render(({ props }) => html`<span>${props.label}</span>`)\n665\t        .setup(() => {})\n666\t    const out = String(html`<${El} label=${'a&b'} />`)\n667\t    t.ok(out.includes('label=\"a&amp;b\"'), 'attribute escaped once')\n668\t    t.ok(out.includes('<span>a&amp;b</span>'), 'child escaped once')\n669\t    t.ok(!out.includes('&amp;amp;'), 'never double escaped')\n670\t})\n671\t\n672\ttest('TAG and refs build server-rendered markup', t => {\n673\t    const El = define('ssr-list')\n674\t        .withRefs(r => ({ items: r.all() }))\n675\t        .setup(() => {})\n676\t\n677\t    const html = `<${El.TAG} data-ref=\"${El.refs.items}\"></${El.TAG}>`\n678\t\n679\t    t.equal(typeof El.TAG, 'string', 'TAG stringifies for interpolation')\n680\t    t.equal(typeof El.refs.items, 'string', 'ref name stringifies')\n681\t    t.ok(html.length > 0, 'produces non-empty markup')\n682\t    t.ok(\n683\t        !html.includes('undefined'),\n684\t        'no undefined values leak into the markup'\n685\t    )\n686\t    t.ok(\n687\t        !html.includes('[object'),\n688\t        'statics stringify cleanly (not as objects)'\n689\t    )\n690\t})\n691\t\n692\t// Reactive holes on the server: evaluated once, child holes marked.\n693\ttest('html SSR: signal in child position is wrapped in markers', t => {\n694\t    const s = signal('hi')\n695\t    t.equal(\n696\t        String(html`<p>${s}</p>`),\n697\t        '<p><!--[-->hi<!--]--></p>',\n698\t        'signal value between one marker pair'\n699\t    )\n700\t})\n701\t\n702\ttest('html SSR: function child is called once and wrapped', t => {\n703\t    let calls = 0\n704\t    const f = () => { calls++; return html`<b>x</b>` }\n705\t    t.equal(String(html`<p>${f}</p>`), '<p><!--[--><b>x</b><!--]--></p>',\n706\t        'markup result wrapped')\n707\t    t.equal(calls, 1, 'called once')\n708\t    t.equal(\n709\t        String(html`<p>${() => [html`<i>a</i>`, 'b&']}</p>`),\n710\t        '<p><!--[--><i>a</i>b&amp;<!--]--></p>',\n711\t        'array result flattened and strings escaped'\n712\t    )\n713\t    t.equal(String(html`<p>${() => null}</p>`), '<p><!--[--><!--]--></p>',\n714\t        'null result leaves an empty region')\n715\t    t.equal(String(html`<p>${() => false}</p>`), '<p><!--[--><!--]--></p>',\n716\t        'false result leaves an empty region')\n717\t})\n718\t\n719\ttest('html SSR: reactive attribute on a plain element', t => {\n720\t    t.equal(String(html`<a href=${signal('/x')}>a</a>`),\n721\t        '<a href=\"/x\">a</a>', 'signal attribute evaluated')\n722\t    t.equal(String(html`<a title=${() => 'a\"b'}>a</a>`),\n723\t        '<a title=\"a&quot;b\">a</a>', 'function attribute evaluated')\n724\t    for (const v of [false, null, undefined]) {\n725\t        t.equal(String(html`<a title=${() => v}>a</a>`), '<a>a</a>',\n726\t            `${v} omits the attribute`)\n727\t    }\n728\t})\n729\t\n730\ttest('html SSR: signal component prop reaches render as a value', t => {\n731\t    let seen:unknown\n732\t    const El = define('ssr-reactive-prop')\n733\t        .withProps(p => ({ n: p.number() }))\n734\t        .render(({ props }) => { seen = props.n; return '' })\n735\t        .setup(() => {})\n736\t    const out = String(html`<${El} n=${signal(4)} />`)\n737\t    t.equal(seen, 4, 'render saw the plain value')\n738\t    t.ok(out.includes('n=\"4\"'), 'attribute serialized from the value')\n739\t})\n740\t\n741\ttest('html SSR: component children wrapped in a children marker', t => {\n742\t    let got = ''\n743\t    const Keep = define('ssr-children-keep')\n744\t        .render(({ children }) => { got = String(children); return got })\n745\t        .setup(() => {})\n746\t    html`<${Keep}><i>a</i></${Keep}>`\n747\t    t.equal(got, '<!--[c--><i>a</i><!--]-->', 'children arrive wrapped')\n748\t    html`<${Keep} />`\n749\t    t.equal(got, '', 'no children, no markers')\n750\t\n751\t    const Drop = define('ssr-children-drop')\n752\t        .render(() => '<b>x</b>')\n753\t        .setup(() => {})\n754\t    const out = String(html`<${Drop}><i>a</i></${Drop}>`)\n755\t    t.ok(!out.includes('<!--['), 'dropping children emits no markers')\n756\t})\n757\t\n758\ttest('html SSR: function-valued on<event> props are omitted', t => {\n759\t    const El = define('ssr-onevent')\n760\t        .render(() => '')\n761\t        .setup(() => {})\n762\t    const fn = () => {}\n763\t    t.equal(String(html`<button onclick=${fn}>b</button>`),\n764\t        '<button>b</button>', 'omitted on plain element')\n765\t    t.ok(!String(html`<${El} onfoo=${fn} />`).includes('onfoo'),\n766\t        'omitted on host')\n767\t})\n768\t\n769\ttest('html SSR: static page output is unchanged', t => {\n770\t    const El = define('ssr-static-page')\n771\t        .withProps(p => ({ n: p.number() }))\n772\t        .render(({ props }) => html`<b>${props.n}</b>`)\n773\t        .setup(() => {})\n774\t    t.equal(\n775\t        String(html`<main id=\"m\"><h1 class=${'t'}>${'a&b'}</h1></main>`),\n776\t        '<main id=\"m\"><h1 class=\"t\">a&amp;b</h1></main>',\n777\t        'plain elements'\n778\t    )\n779\t    t.equal(String(html`<div>${[html`<${El} n=${2} />`]}</div>`),\n780\t        '<div><ssr-static-page n=\"2\"><b>2</b></ssr-static-page></div>',\n781\t        'component without children')\n782\t})\n783\t\n784\t// A spread of untrusted keys must not break out of the tag.\n785\tconst BAD_KEY = 'x\" onload=\"alert(1)'\n786\t\n787\ttest('html SSR: a spread skips an invalid attribute name', t => {\n788\t    const attrs = { [BAD_KEY]: 'v', 'data-ok': 'yes' }\n789\t    t.equal(String(html`<div ...${attrs}></div>`),\n790\t        '<div data-ok=\"yes\"></div>',\n791\t        'invalid key omitted, valid key emitted')\n792\t})\n793\t\n794\ttest('html SSR: a component skips an invalid extra attribute name', t => {\n795\t    let seen:Record<string, string> | undefined\n796\t    const El = define('ssr-bad-attr')\n797\t        .render(({ attrs }) => { seen = attrs; return '' })\n798\t        .setup(() => {})\n799\t    const attrs = { [BAD_KEY]: 'v', 'data-ok': 'yes' }\n800\t    const out = String(html`<${El} ...${attrs} />`)\n801\t    t.equal(out, '<ssr-bad-attr data-ok=\"yes\"></ssr-bad-attr>',\n802\t        'host tag has only the valid attribute')\n803\t    t.ok(seen && !(BAD_KEY in seen), 'render was not given the key')\n804\t})\n805\t\n806\ttest('html SSR: an unclosed void element with children throws', async t => {\n807\t    await t.throws(\n808\t        () => html`<form><input type=\"text\"><button>go</button></form>`,\n809\t        /input/,\n810\t        'error names the tag'\n811\t    )\n812\t    await t.throws(() => html`<div><br> </div>`, /br/,\n813\t        'whitespace text counts as a child')\n814\t})\n815\t\n816\ttest('html SSR: a self-closed void element does not throw', t => {\n817\t    const out = String(html`<form><input type=\"text\" /><b>go</b></form>`)\n818\t    t.ok(!out.includes('</input>'), 'no closing tag')\n819\t    t.ok(out.includes('<b>go</b>'), 'following content kept')\n820\t})\n821\t\n822\t// The browser templater has its own `Markup` class, so it stands in\n823\t// for a second copy of the package.\n824\timport { html as bhtml, raw as braw } from '../src/htm.browser.js'\n825\t\n826\ttest('html SSR: markup from another copy is not escaped', t => {\n827\t    const Keep = define('ssr-other-copy')\n828\t        .render(({ children }) => html`<p>${raw(String(children))}</p>`)\n829\t        .setup(() => {})\n830\t    const cases:[string, unknown, unknown][] = [\n831\t        ['child', bhtml`<i>a</i>`, html`<i>a</i>`],\n832\t        ['raw child', braw('<b>x</b>'), raw('<b>x</b>')],\n833\t        ['region', () => bhtml`<i>a</i>`, () => html`<i>a</i>`],\n834\t        ['list', [bhtml`<i>a</i>`], [html`<i>a</i>`]],\n835\t    ]\n836\t    for (const [name, other, same] of cases) {\n837\t        t.equal(\n838\t            String(html`<div>${other}</div>`),\n839\t            String(html`<div>${same}</div>`),\n840\t            `${name} renders as with one copy`\n841\t        )\n842\t    }\n843\t    t.equal(\n844\t        String(html`<${Keep}>${bhtml`<i>a</i>`}</${Keep}>`),\n845\t        String(html`<${Keep}>${html`<i>a</i>`}</${Keep}>`),\n846\t        'component children render as with one copy'\n847\t    )\n848\t    t.equal(\n849\t        String(html`${bhtml`<i>a</i>`}`),\n850\t        String(html`<i>a</i>`),\n851\t        'a lone hole renders as with one copy'\n852\t    )\n853\t})\n854\t\n855\ttest('html SSR: server markup in the other copy is not escaped', t => {\n856\t    t.equal(\n857\t        String(bhtml`<div>${html`<i>a</i>`}</div>`),\n858\t        String(bhtml`<div>${bhtml`<i>a</i>`}</div>`),\n859\t        'nested server markup is HTML'\n860\t    )\n861\t})\n862\t\n863\ttest('parity table: server output matches the expected HTML', t => {\n864\t    for (const c of parityCases) {\n865\t        t.equal(\n866\t            stripMarkers(String(c.input(html))),\n867\t            c.expected,\n868\t            c.name\n869\t        )\n870\t    }\n871\t})\n872\t"}]},"parent_tool_use_id":"toolu_014UPCKmnimWAFbXhXsD2n9Y","agent_id":"a58061a4bd1065694","session_id":"6cc07e3d-f14d-4f74-8232-b688abdf9fde","uuid":"2ef055e5-4718-4a41-b35a-b27b2565b3c3","timestamp":"2026-11-24T09:58:03.881Z","tool_result_meta":[{"id":"toolu_01WR8tLyQg3aADpuppywuebu","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"fork","task_description":"Read key source files"}
