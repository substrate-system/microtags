 current.parent\n294\t        if (\n295\t            ts.isVariableDeclaration(current) &&\n296\t            ts.isIdentifier(current.name)\n297\t        ) {\n298\t            return current.name.text\n299\t        }\n300\t    }\n301\t    return null\n302\t}\n303\t\n304\tfunction cascadeRemove (\n305\t    code:string,\n306\t    filename?:string\n307\t):string {\n308\t    let changed = true\n309\t    let result = code\n310\t    while (changed) {\n311\t        changed = false\n312\t        const sf = ts.createSourceFile(\n313\t            filename ?? 'input.ts',\n314\t            result,\n315\t            ts.ScriptTarget.Latest,\n316\t            true\n317\t        )\n318\t\n319\t        const refs = collectReferences(sf)\n320\t        const removeSpans:{\n321\t            start:number, end:number\n322\t        }[] = []\n323\t\n324\t        ts.forEachChild(sf, node => {\n325\t            if (\n326\t                ts.isImportDeclaration(node) &&\n327\t                node.importClause\n328\t            ) {\n329\t                if (isExportedNode(node)) return\n330\t                const nb = node.importClause.namedBindings\n331\t                if (!nb) return\n332\t                if (!ts.isNamedImports(nb)) {\n333\t                    const name = node.importClause.name\n334\t                    if (\n335\t                        name &&\n336\t                        !refs.has(name.text)\n337\t                    ) {\n338\t                        removeSpans.push({\n339\t                            start: node.getStart(),\n340\t                            end: node.getEnd(),\n341\t                        })\n342\t                    }\n343\t                    return\n344\t                }\n345\t                const dead:TypeScript.ImportSpecifier[] = []\n346\t                const live:TypeScript.ImportSpecifier[] = []\n347\t                for (const el of nb.elements) {\n348\t                    if (refs.has(el.name.text)) {\n349\t                        live.push(el)\n350\t                    } else {\n351\t                        dead.push(el)\n352\t                    }\n353\t                }\n354\t                if (dead.length === 0) return\n355\t                if (live.length === 0) {\n356\t                    removeSpans.push({\n357\t                        start: node.getStart(),\n358\t                        end: node.getEnd(),\n359\t                    })\n360\t                } else {\n361\t                    for (const d of dead) {\n362\t                        let start = d.getStart()\n363\t                        let end = d.getEnd()\n364\t                        const text = result\n365\t                        const after = text.slice(end)\n366\t                        const before = text.slice(0, start)\n367\t                        if (/^\\s*,/.test(after)) {\n368\t                            end += after.match(\n369\t                                /^\\s*,/\n370\t                            )![0].length\n371\t                        } else if (/,\\s*$/.test(before)) {\n372\t                            start = before.lastIndexOf(',')\n373\t                        }\n374\t                        removeSpans.push({ start, end })\n375\t                    }\n376\t                }\n377\t                return\n378\t            }\n379\t\n380\t            if (ts.isVariableStatement(node)) {\n381\t                if (isExportedNode(node)) return\n382\t                const allDead = node\n383\t                    .declarationList\n384\t                    .declarations\n385\t                    .every(d =>\n386\t                        ts.isIdentifier(d.name) &&\n387\t                        !refs.has(d.name.text)\n388\t                    )\n389\t                if (allDead) {\n390\t                    removeSpans.push({\n391\t                        start: node.getStart(),\n392\t                        end: node.getEnd(),\n393\t                    })\n394\t                }\n395\t                return\n3