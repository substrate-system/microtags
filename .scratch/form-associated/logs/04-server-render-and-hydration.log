{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PLZUSagXro4A9UVYbKK7oa","type":"tool_result","content":"1\timport { signal } from './reactivity.js'\n2\timport { runAll } from './util.js'\n3\timport { makeSetupContext } from './setup-context.js'\n4\timport {\n5\t    resolveContextSignal,\n6\t    onContextAvailable,\n7\t} from './context.js'\n8\timport type {\n9\t    PropsSignals,\n10\t    Signal,\n11\t    SetupContext,\n12\t    Coercer,\n13\t    ContextToken,\n14\t    RefDef,\n15\t    FormLifecycleHandlers,\n16\t} from './types.js'\n17\t\n18\t/**\n19\t * Map of prop name to coercer function.\n20\t * The factory accepts coercers exclusively; Standard Schema support is\n21\t * layered on top in the withProps builder (US-005).\n22\t */\n23\texport type FactoryProps = Record<string, Coercer<unknown>>\n24\t\n25\t/**\n26\t * The class to extend for custom elements. In the browser this is the\n27\t * real HTMLElement; in Node (e.g. reading `.TAG` for SSR) it falls back\n28\t * to an empty stub so the class can be defined without a DOM. The stub\n29\t * is never instantiated or registered outside the browser.\n30\t */\n31\tconst HTMLElementBase = typeof HTMLElement !== 'undefined' ?\n32\t    HTMLElement :\n33\t    (class {} as unknown as typeof HTMLElement)\n34\t\n35\t/** Configuration passed to factory(). */\n36\texport interface FactoryConfig<Props extends FactoryProps = FactoryProps> {\n37\t    /** Coercer for each observed attribute / prop. */\n38\t    props:Props\n39\t    /** Attribute names to pass to observedAttributes. */\n40\t    observedAttrNames:string[]\n41\t    /** Ref definitions keyed by name. */\n42\t    refs?:Record<string, RefDef>\n43\t    /** Context tokens keyed by name. */\n44\t    contexts?:Record<string, ContextToken<unknown>>\n45\t    /** Make the host a form-associated custom element. */\n46\t    formAssociated?:boolean\n47\t    /** Setup callback receiving the component context. */\n48\t    setup:(ctx:SetupContext<Props, any, any>) => void\n49\t}\n50\t\n51\t/**\n52\t * Collect resolved DOM refs from within a host element.\n53\t * Throws if any single-ref element is missing.\n54\t */\n55\tfunction collectRefs (\n56\t    host:HTMLElement,\n57\t    defs:Record<string, RefDef>\n58\t):Record<string, Element|Element[]> {\n59\t    const result:Record<string, Element|Element[]> = {}\n60\t    const missing:string[] = []\n61\t    for (const [key, def] of Object.entries(defs)) {\n62\t        const sel = def.selector ?? `[data-ref=\"${key}\"]`\n63\t        if (def._microtag === 'ref:all') {\n64\t            result[key] = Array.from(host.querySelectorAll(sel))\n65\t        } else {\n66\t            const el = host.querySelector(sel)\n67\t            if (!el) {\n68\t                missing.push(key)\n69\t            } else {\n70\t                result[key] = el\n71\t            }\n72\t        }\n73\t    }\n74\t    if (missing.length > 0) {\n75\t        throw new Error(\n76\t            `${host.tagName}: missing refs: ${missing.join(', ')}`\n77\t        )\n78\t    }\n79\t    return result\n80\t}\n81\t\n82\t/**\n83\t * Create an HTMLElement subclass with the microtags lifecycle.\n84\t * The returned class has no Shadow DOM, tracks its own prop signals,\n85\t * and runs setup() on connect / cleanups a microtask after disconnect.\n86\t */\n87\texport function factory<Props extends FactoryProps = FactoryProps> (\n88\t    config:FactoryConfig<Props>\n89\t):typeof HTMLElement {\n90\t    const {\n91\t        props: propDefs,\n92\t        observedAttrNames,\n93\t        setup,\n94\t        refs: refDefs = {},\n95\t        contexts: ctxDefs = {},\n96\t        formAssociated: isFormAssociated,\n97\t    } = config\n98\t\n99\t    class MicrotagElement extends HTMLElementBase {\n100\t        static get observedAttributes () { return observedAttrNames }\n101\t\n102\t        _props:Record<string, Signal<unknown>> = {}\n103\t        // Per prop: the external signal assigned to the accessor, if any.\n104\t        _bound:Record<string, Signal<Signal<unknown>|undefined>> = {}\n105\t        _cleanups:(() => void)[] = []\n106\t        // Connected and set up, not yet torn down.\n107\t        _live = false\n108\t        _internals:ElementInternals|undefined\n109\t        _fh:FormLifecycleHandlers|undefined\n110\t        _fp:[unknown, string]|undefined\n111\t\n112\t        constructor () {\n113\t            super()\n114\t            if (isFormAssociated) {\n115\t                this._internals = this.attachInternals()\n116\t            }\n117\t            for (const [name, coercer] of Object.entries(propDefs)) {\n118\t                const own = signal(coercer(null))\n119\t                const bound = signal<Signal<unknown>|undefined>(undefined)\n120\t                this._bound[name] = bound\n121\t                // Reads go through the bound signal when one is set,\n122\t                // so setup's prop signal tracks it. A bound prop is\n123\t                // owned by the parent, so writing it here throws.\n124\t                this._props[name] = ((...args:unknown[]) => {\n125\t                    const ext = bound()\n126\t                    if (!args.length) return ext ? ext() : own()\n127\t                    if (ext) {\n128\t                        throw new Error(`${this.localName}: prop \"${name}\"` +\n129\t                            ' is bound and read-only; emit an event instead')\n130\t                    }\n131\t                    own(args[0])\n132\t                }) as Signal<unknown>\n133\t                // Pick up a property set before the upgrade; it\n134\t                // shadows the prototype accessor until removed.\n135\t                if (Object.prototype.hasOwnProperty.call(this, name)) {\n136\t                    const pre = (this as any)[name]\n137\t                    delete (this as any)[name]\n138\t                    ;(this as any)[name] = pre\n139\t                }\n140\t            }\n141\t        }\n142\t\n143\t        connectedCallback () {\n144\t            // Back before the queued teardown ran: this was a move.\n145\t            if (this._live) return\n146\t            this._live = true\n147\t            // Start a fresh cleanup scope for each connection cycle.\n148\t            this._cleanups = []\n149\t\n150\t            // Hydrate prop signals from attributes; preserve any\n151\t            // programmatically-set value when the attribute is absent.\n152\t            for (const [name, coercer] of Object.entries(propDefs)) {\n153\t                const attrVal = this.getAttribute(name)\n154\t                if (attrVal !== null && !this._bound[name]()) {\n155\t                    (this._props[name] as Signal<unknown>)(coercer(attrVal))\n156\t                }\n157\t            }\n158\t\n159\t            const cleanups = this._cleanups\n160\t            const props = this._props as PropsSignals<Props>\n161\t\n162\t            // Reactive Proxy: reading a key inside a ctx.effect creates\n163\t            // a subscription to the provider's alien-signals signal.\n164\t            const contexts = new Proxy({} as Record<string, unknown>, {\n165\t                get: (_target, key) => {\n166\t                    if (typeof key !== 'string') return undefined\n167\t                    const token = ctxDefs[key]\n168\t                    if (!token) return undefined\n169\t                    const sig = resolveContextSignal(this, token)\n170\t                    return sig ? sig() : undefined\n171\t                },\n172\t                has: (_target, key) => {\n173\t                    if (typeof key !== 'string') return false\n174\t                    return key in ctxDefs\n175\t                },\n176\t            })\n177\t\n178\t            let setupRan = false\n179\t            // Tracks pending-context cancel functions so they are\n180\t            // removed from the global registry when setup runs or\n181\t            // when the element disconnects.\n182\t            const cancelCallbacks:(() => void)[] = []\n183\t\n184\t            const tryRunSetup = ():void => {\n185\t                if (setupRan) return\n186\t                for (const token of Object.values(ctxDefs)) {\n187\t                    if (!resolveContextSignal(this, token)) return\n188\t                }\n189\t                setupRan = true\n190\t                for (const cancel of cancelCallbacks) cancel()\n191\t                cancelCallbacks.length = 0\n192\t\n193\t                // An empty host with a kept render link is filled from\n194\t                // its current props before refs resolve (ADR-011).\n195\t                // Comments count as content: region markers from a\n196\t                // templater or the server must survive.\n197\t                const rp = (this.constructor as any).renderParts\n198\t                if (rp && !this.innerHTML.trim()) {\n199\t                    const v:any = {}\n200\t                    for (const k in propDefs) v[k] = (this as any)[k]\n201\t                    this.innerHTML = rp(v).html\n202\t                }\n203\t\n204\t                const refs = collectRefs(this, refDefs)\n205\t                const ctx = makeSetupContext(\n206\t                    this, props, refs, contexts, cleanups,\n207\t                    this._internals\n208\t                )\n209\t                setup(ctx)\n210\t            }\n211\t\n212\t            // Deferred variant: skip if element was disconnected before\n213\t            // the context became available.\n214\t            const tryRunSetupIfConnected = ():void => {\n215\t                if (!this.isConnected) return\n216\t                tryRunSetup()\n217\t            }\n218\t\n219\t            // Register pending listeners for any missing contexts.\n220\t            for (const token of Object.values(ctxDefs)) {\n221\t                if (!resolveContextSignal(this, token)) {\n222\t                    const cancel = onContextAvailable(\n223\t                        token.id, tryRunSetupIfConnected\n224\t                    )\n225\t                    cancelCallbacks.push(cancel)\n226\t                    // Also cancel on disconnect so we don't leak.\n227\t                    cleanups.push(cancel)\n228\t                }\n229\t            }\n230\t\n231\t            tryRunSetup()\n232\t        }\n233\t\n234\t        attributeChangedCallback (\n235\t            name:string,\n236\t            _old:string|null,\n237\t            next:string|null\n238\t        ) {\n239\t            const coercer = propDefs[name]\n240\t            if (\n241\t                coercer !== undefined &&\n242\t                this._props[name] !== undefined &&\n243\t                !this._bound[name]()\n244\t            ) {\n245\t                (this._props[name] as Signal<unknown>)(coercer(next))\n246\t            }\n247\t        }\n248\t\n249\t        // A DOM move (`moveBefore`) keeps the host set up\n250\t        connectedMoveCallback () {}\n251\t\n252\t        // Teardown waits a microtask, so a host removed and re-inserted\n253\t        // in the same tick (`insertBefore` without `moveBefore`) keeps\n254\t        // its setup.\n255\t        disconnectedCallback () {\n256\t            queueMicrotask(() => {\n257\t                if (this.isConnected || !this._live) return\n258\t                this._live = false\n259\t                this._fh = undefined\n260\t                // Snapshot and clear BEFORE running so re-entrant calls\n261\t                // are safe and the array is empty after this throws.\n262\t                const fns = this._cleanups\n263\t                this._cleanups = []\n264\t                runAll(fns)\n265\t            })\n266\t        }\n267\t    }\n268\t\n269\t    if (isFormAssociated) {\n270\t        Object.defineProperty(MicrotagElement, 'formAssociated', {\n271\t            value: true,\n272\t        })\n273\t        const p = MicrotagElement.prototype as any\n274\t        p.formResetCallback = function () {\n275\t            this._fh?.reset?.()\n276\t        }\n277\t        p.formDisabledCallback = function (d:boolean) {\n278\t            this._fh?.disabled?.(d)\n279\t        }\n280\t        p.formAssociatedCallback = function (\n281\t            f:HTMLFormElement|null\n282\t        ) {\n283\t            this._fh?.associated?.(f)\n284\t        }\n285\t        p.formStateRestoreCallback = function (\n286\t            s:unknown, m:string\n287\t        ) {\n288\t            if (this._fh?.restore) {\n289\t                this._fh.restore(s as FormData|string|null, m)\n290\t            } else {\n291\t                this._fp = [s, m]\n292\t            }\n293\t        }\n294\t    }\n295\t\n296\t    // One accessor per prop. A function value is taken to be a signal\n297\t    // and bound; anything else unbinds and writes the prop.\n298\t    for (const name of Object.keys(propDefs)) {\n299\t        Object.defineProperty(MicrotagElement.prototype, name, {\n300\t            get (this:MicrotagElement) { return this._props[name]() },\n301\t            set (this:MicrotagElement, v:unknown) {\n302\t                if (typeof v === 'function') {\n303\t                    this._bound[name](v as Signal<unknown>)\n304\t                } else {\n305\t                    this._bound[name](undefined)\n306\t                    this._props[name](v)\n307\t                }\n308\t            },\n309\t            configurable: true,\n310\t        })\n311\t    }\n312\t\n313\t    return MicrotagElement\n314\t}\n315\t\n316\t/**\n317\t * Bind a signal (or computed) to a declared prop of a host, so the prop\n318\t * reads through to it. Same as assigning the signal to the accessor,\n319\t * but typed: the signal's value must match the prop's type.\n320\t */\n321\texport const bindProp = <\n322\t    H extends HTMLElement,\n323\t    K extends Exclude<keyof H, keyof HTMLElement>,\n324\t> (host:H, name:K, source:() => H[K]):void => {\n325\t    (host as any)[name] = source\n326\t}\n327\t"}]},"parent_tool_use_id":"toolu_014UPCKmnimWAFbX