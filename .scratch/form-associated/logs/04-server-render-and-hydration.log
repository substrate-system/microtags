{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AVU8eRKWyryX8oK4VYEyx3","type":"tool_result","content":"820\t})\n821\t\n822\t// The browser templater has its own `Markup` class, so it stands in\n823\t// for a second copy of the package.\n824\timport { html as bhtml, raw as braw } from '../src/htm.browser.js'\n825\t\n826\ttest('html SSR: markup from another copy is not escaped', t => {\n827\t    const Keep = define('ssr-other-copy')\n828\t        .render(({ children }) => html`<p>${raw(String(children))}</p>`)\n829\t        .setup(() => {})\n830\t    const cases:[string, unknown, unknown][] = [\n831\t        ['child', bhtml`<i>a</i>`, html`<i>a</i>`],\n832\t        ['raw child', braw('<b>x</b>'), raw('<b>x</b>')],\n833\t        ['region', () => bhtml`<i>a</i>`, () => html`<i>a</i>`],\n834\t        ['list', [bhtml`<i>a</i>`], [html`<i>a</i>`]],\n835\t    ]\n836\t    for (const [name, other, same] of cases) {\n837\t        t.equal(\n838\t            String(html`<div>${other}</div>`),\n839\t            String(html`<div>${same}</div>`),\n840\t            `${name} renders as with one copy`\n841\t        )\n842\t    }\n843\t    t.equal(\n844\t        String(html`<${Keep}>${bhtml`<i>a</i>`}</${Keep}>`),\n845\t        String(html`<${Keep}>${html`<i>a</i>`}</${Keep}>`),\n846\t        'component children render as with one copy'\n847\t    )\n848\t    t.equal(\n849\t        String(html`${bhtml`<i>a</i>`}`),\n850\t        String(html`<i>a</i>`),\n851\t        'a lone hole renders as with one copy'\n852\t    )\n853\t})\n854\t\n855\ttest('html SSR: server markup in the other copy is not escaped', t => {\n856\t    t.equal(\n857\t        String(bhtml`<div>${html`<i>a</i>`}</div>`),\n858\t        String(bhtml`<div>${bhtml`<i>a</i>`}</div>`),\n859\t        'nested server markup is HTML'\n860\t    )\n861\t})\n862\t\n863\ttest('parity table: server output matches the expected HTML', t => {\n864\t    for (const c of parityCases) {\n865\t        t.equal(\n866\t            stripMarkers(String(c.input(html))),\n867\t            c.expected,\n868\t            c.name\n869\t        )\n870\t    }\n871\t})\n872\t"}]},"parent_tool_use_id":null,"session_id":"6cc07e3d-f14d-4f74-8232-b688abdf9fde","uuid":"f9104cc9-887e-4658-9ae1-167e934dd38e","timestamp":"2026-11-24T09:59:07.055Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/microtags.form-associated-04-server-render-and-hydration/test/ssr.ts","content":"})\n\n// The browser templater has its own `Markup` class, so it stands in\n// for a second copy of the package.\nimport { html as bhtml, raw as braw } from '../src/htm.browser.js'\n\ntest('html SSR: markup from another copy is not escaped', t => {\n    const Keep = define('ssr-other-copy')\n        .render(({ children }) => html`<p>${raw(String(children))}</p>`)\n        .setup(() => {})\n    const cases:[string, unknown, unknown][] = [\n        ['child', bhtml`<i>a</i>`, html`<i>a</i>`],\n        ['raw child', braw('<b>x</b>'), raw('<b>x</b>')],\n        ['region', () => bhtml`<i>a</i>`, () => html`<i>a</i>`],\n        ['list', [bhtml`<i>a</i>`], [html`<i>a</i>`]],\n    ]\n    for (const [name, other, same] of cases) {\n        t.equal(\n            String(html`<div>${other}</div>`),\n            String(html`<div>${same}</div>`),\n            `${name} renders as with one copy`\n        )\n    }\n    t.equal(\n        String(html`<${Keep}>${bhtml`<i>a</i>`}</${Keep}>`),\n        String(html`<${Keep}>${html`<i>a</i>`}</${Keep}>`),\n        'component children render as with one copy'\n    )\n    t.equal(\n        String(html`${bhtml`<i>a</i>`}`),\n        String(html`<i>a</i>`),\n        'a lone hole renders as with one copy'\n    )\n})\n\ntest('html SSR: server markup in the other copy is not escaped', t => {\n    t.equal(\n        String(bhtml`<div>${html`<i>a</i>`}</div>`),\n        String(bhtml`<div>${bhtml`<i>a</i>`}</div>`),\n        'nested server markup is HTML'\n    )\n})\n\ntest('parity table: server output matches the expected HTML', t => {\n    for (const c of parityCases) {\n        t.equal(\n            stripMarkers(String(c.input(html))),\n            c.expected,\n            c.name\n        )\n    }\n})\n","numLines":53,"startLine":820,"totalLines":872}},"tool_result_meta":[{"id":"toolu_01AVU8eRKWyryX8oK4VYEyx3","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
