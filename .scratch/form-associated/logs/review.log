w CustomEvent(nameOrEvent, {\n59\t                    bubbles: true,\n60\t                    ...options,\n61\t                    detail,\n62\t                })\n63\t            return host.dispatchEvent(event)\n64\t        },\n65\t\n66\t        effect (fn) {\n67\t            const dispose = effect(fn)\n68\t            cleanups.push(dispose)\n69\t        },\n70\t\n71\t        bind<T> (\n72\t            source:Signal<T>,\n73\t            control:Element,\n74\t            opts?:BindOptions\n75\t        ) {\n76\t            const input = control instanceof HTMLInputElement ?\n77\t                control :\n78\t                undefined\n79\t            let prop = 'value'\n80\t            let autoEvent = 'change'\n81\t            if (input?.type === 'checkbox') {\n82\t                prop = 'checked'\n83\t            } else if (input?.type === 'number' ||\n84\t                input?.type === 'range') {\n85\t                prop = 'valueAsNumber'\n86\t                autoEvent = 'input'\n87\t            } else if (input || control instanceof HTMLTextAreaElement) {\n88\t                autoEvent = 'input'\n89\t            }\n90\t\n91\t            const boundProp = opts?.prop ?? prop\n92\t            const event = opts ? opts.event : autoEvent\n93\t            const el = control as unknown as Record<string, unknown>\n94\t\n95\t            if (event) {\n96\t                const handler = () => {\n97\t                    const writable = source as Signal<unknown>\n98\t                    writable(el[boundProp])\n99\t                }\n100\t                control.addEventListener(event, handler)\n101\t                cleanups.push(() => {\n102\t                    control.removeEventListener(event, handler)\n103\t                })\n104\t            }\n105\t\n106\t            const dispose = effect(() => {\n107\t                el[boundProp] = source()\n108\t            })\n109\t            cleanups.push(dispose)\n110\t        },\n111\t\n112\t        onCleanup (fn) {\n113