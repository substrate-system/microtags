._internals as ElementInternals\n812\t+    internals.setValidity({})\n813\t+    t.ok(host!.matches(':valid'), 'host matches :valid after clear')\n814\t+    t.equal(form.checkValidity(), true,\n815\t+        'form.checkValidity returns true after clear')\n816\t+    form.remove()\n817\t+})\n818\t+\n819\t+test('formAssociated: host matches :disabled in fieldset', t => {\n820\t+    const form = document.createElement('form')\n821\t+    const tag = 'fa-disabled-' + Math.random().toString(36).slice(2, 8)\n822\t+    form.innerHTML = `<fieldset disabled><${tag} name=\"d\"></${tag}></fieldset>`\n823\t+    document.body.appendChild(form)\n824\t+\n825\t+    define(tag)\n826\t+        .formAssociated()\n827\t+        .setup(() => {})\n828\t+\n829\t+    const host = form.querySelector(tag)!\n830\t+    t.ok(host.matches(':disabled'),\n831\t+        'host matches :disabled inside disabled fieldset')\n832\t+    form.remove()\n833\t+})\n834\t+\n835\t+test('formAssociated: ctx.internals.form is the enclosing form', t => {\n836\t+    const form = document.createElement('form')\n837\t+    const tag = 'fa-form-' + Math.random().toString(36).slice(2, 8)\n838\t+    form.innerHTML = `<${tag} name=\"f\"></${tag}>`\n839\t+    document.body.appendChild(form)\n840\t+\n841\t+    let internals:ElementInternals|undefined\n842\t+    define(tag)\n843\t+        .formAssociated()\n844\t+        .setup(ctx => {\n845\t+            internals = ctx.internals\n846\t+        })\n847\t+\n848\t+    t.equal(internals!.form, form,\n849\t+        'internals.form points to the enclosing form')\n850\t+    form.remove()\n851\t+})\n852\t+\n853\t+test('formAssociated: internals attached once, survives reconnect', async t => {\n854\t+    const form = document.createElement('form')\n855\t+    const tag = 'fa-reconnect-' + Math.random().toString(36).slice(2, 8)\n856\t+    form.innerHTML = `<${tag} name=\"r\"></${tag}>`\n857\t+    document.body.appendChild(form)\n858\t+\n859\t+    let setupCount = 0\n860\t+    let lastInternals:ElementInternals|undefined\n861\t+    define(tag)\n862\t+        .formAssociated()\n863\t+        .setup(ctx => {\n864\t+            setupCount++\n865\t+            if (lastInternals) {\n866\t+                // same object each time\n867\t+                if (ctx.internals !== lastInternals) {\n868\t+                    throw new Error('internals changed between setups')\n869\t+                }\n870\t+            }\n871\t+            lastInternals = ctx.internals\n872\t+            ctx.internals.setFormValue('v' + setupCount)\n873\t+        })\n874\t+\n875\t+    const host = form.querySelector(tag)!\n876\t+    t.equal(setupCount, 1, 'setup ran once')\n877\t+\n878\t+    // same-tick move: keeps setup\n879\t+    const other = document.createElement('div')\n880\t+    document.body.appendChild(other)\n881\t+    other.appendChild(host)\n882\t+    form.appendChild(host)\n883\t+    t.equal(setupCount, 1, 'move did not re-run setup')\n884\t+\n885\t+    // full teardown + reconnect\n886\t+    host.remove()\n887\t+    await Promise.resolve()\n888\t+    form.appendChild(host)\n889\t+    t.equal(setupCount, 2, 'reconnect re-ran setup')\n890\t+    t.ok(lastInternals, 'internals exist')\n891\t+\n892\t+    const data = new FormData(form)\n893\t+    t.equal(data.get('r'), 'v2', 'value updated after reconnect')\n894\t+    form.remove()\n895\t+    other.remove()\n896\t+})\n897\t+\n898\t+test('formAssociated: composes with withProps, withRefs, withContexts, render', t => {\n899\t+    const form = document.createElement('form')\n900\t+    const tag = 'fa-compose-' + Math.random().toString(36).slice(2, 8)\n901\t+    form.innerHTML = `<${tag} name=\"c\" count=\"7\"><span data-ref=\"out\">hi</span></${tag}>`\n902\t+    document.body.appendChild(form)\n903\t+\n904\t+    let gotRef = false\n905\t+    let gotProp = false\n906\t+    define(tag)\n907\t+        .withProps(p => ({ count: p.number() }))\n908\t+        .withRefs(r => ({ out: r.one('span') }))\n909\t+        .formAssociated()\n910\t+        .setup(ctx => {\n911\t+            gotProp = ctx.props.count() === 7\n912\t+            gotRef = ctx.refs.out instanceof HTMLSpanElement\n913\t+            ctx.internals.setFormValue(String(ctx.props.count()))\n914\t+        })\n915\t+\n916\t+    t.ok(gotProp, 'props resolved')\n917\t+    t.ok(gotRef, 'refs resolved')\n918\t+    const data = new FormData(form)\n919\t+    t.equal(data.get('c'), '7', 'form value set from prop')\n920\t+    form.remove()\n921\t+})\n922\t+\n923\t+test('formAssociated: component without it stays unchanged', t => {\n924\t+    const form = document.createElement('form')\n925\t+    const tag = 'fa-none-' + Math.random().toString(36).slice(2, 8)\n926\t+    form.innerHTML = `<${tag} name=\"n\"></${tag}>`\n927\t+    document.body.appendChild(form)\n928\t+\n929\t+    define(tag).setup(() => {})\n930\t+\n931\t+    const data = new FormData(form)\n932\t+    t.equal(data.get('n'), null,\n933\t+        'non-form-associated host does not appear in FormData')\n934\t+\n935\t+    const host = form.querySelector(tag)!\n936\t+    t.equal(host.matches(':disabled'), false,\n937\t+        'non-form-associated host does not match :disabled')\n938\t+    form.remove()\n939\t+})\n940\t+\n941\t+// -- form lifecycle handlers --\n942\t+\n943\t+test('formLifecycle: form.reset() calls reset handler', t => {\n944\t+    const form = document.createElement('form')\n945\t+    const tag = 'fl-reset-' + Math.random().toString(36).slice(2, 8)\n946\t+    form.innerHTML = `<${tag} name=\"v\"></${tag}>`\n947\t+    document.body.appendChild(form)\n948\t+\n949\t+    let resetCalled = false\n950\t+    define(tag)\n951\t+        .formAssociated()\n952\t+        .setup(ctx => {\n953\t+            ctx.internals.setFormValue('hello')\n954\t+            ctx.form({\n955\t+                reset: () => {\n956\t+                    resetCalled = true\n957\t+                    ctx.internals.setFormValue('default')\n958\t+                },\n959\t+            })\n960\t+        })\n961\t+\n962\t+    const before = new FormData(form)\n963\t+    t.equal(before.get('v'), 'hello', 'value before reset')\n964\t+    t.equal(resetCalled, false, 'not called before reset')\n965\t+    form.reset()\n966\t+    t.equal(resetCalled, true, 'reset handler called')\n967\t+    const after = new FormData(form)\n968\t+    t.equal(after.get('v'), 'default',\n969\t+        'FormData shows default after reset')\n970\t+    form.remove()\n971\t+})\n972\t+\n973\t+test('formLifecycle: fieldset disabled calls disabled handler',\n974\t+    t => {\n975\t+        const form = document.createElement('form')\n976\t+        const tag = 'fl-dis-' +\n977\t+            Math.random().toString(36).slice(2, 8)\n978\t+        form.innerHTML = `<fieldset><${tag} name=\"d\"></${tag}>`\n979\t+            + '</fieldset>'\n980\t+        document.body.appendChild(form)\n981\t+\n982\t+        const calls:boolean[] = []\n983\t+        define(tag)\n984\t+            .formAssociated()\n985\t+            .setup(ctx => {\n986\t+                ctx.form({\n987\t+                    disabled: (d) => { calls.push(d) },\n988\t+                })\n989\t+            })\n990\t+\n991\t+        const fs = form.querySelector('fieldset')!\n992\t+        fs.disabled = true\n993\t+        t.deepEqual(calls, [true], 'disabled(true) called')\n994\t+        fs.disabled = false\n995\t+        t.deepEqual(calls, [true, false],\n996\t+            'disabled(false) called')\n997\t+        form.remove()\n998\t+    })\n999\t+\n1000\t+test('formLifecycle: associated handler on form move', t => {\n1001\t+    const form = document.createElement('form')\n1002\t+    const tag = 'fl-assoc-' +\n1003\t+        Math.random().toString(36).slice(2, 8)\n1004\t+    const host = document.createElement(tag)\n1005\t+    host.setAttribute('name', 'a')\n1006\t+    document.body.appendChild(host)\n1007\t+    document.body.appendChild(form)\n1008\t+\n1009\t+    const calls:(HTMLFormElement|null)[] = []\n1010\t+    define(tag)\n1011\t+        .formAssociated()\n1012\t+        .setup(ctx => {\n1013\t+            ctx.form({\n1014\t+                associated: (f) => { calls.push(f) },\n1015\t+            })\n1016\t+        })\n1017\t+\n1018\t+    // The host is already in the DOM when defined, so the browser\n1019\t+    // may fire formAssociatedCallback with null during setup (not\n1020\t+    // in a form). Then moving it into a form fires with that form.\n1021\t+    form.appendChild(host)\n1022\t+    t.equal(calls[calls.length - 1], form,\n1023\t+        'associated called with form')\n1024\t+    document.body.appendChild(host)\n1025\t+    t.equal(calls[calls.length - 1], null,\n1026\t+        'associated called with null')\n1027\t+    host.remove()\n1028\t+    form.remove()\n1029\t+})\n1030\t+\n1031\t+test('formLifecycle: restore callback via direct call', t => {\n1032\t+    const form = document.createElement('form')\n1033\t+    const tag = 'fl-rest-' +\n1034\t+        Math.random().toString(36).slice(2, 8)\n1035\t+    form.innerHTML = `<${tag} name=\"r\"></${tag}>`\n1036\t+    document.body.appendChild(form)\n1037\t+\n1038\t+    let restored:[unknown, string]|null = null\n1039\t+    define(tag)\n1040\t+        .formAssociated()\n1041\t+        .setup(ctx => {\n1042\t+            ctx.form({\n1043\t+                restore: (state, mode) => {\n1044\t+                    restored = [state, mode]\n1045\t+                },\n1046\t+            })\n1047\t+        })\n1048\t+\n1049\t+    const host = form.querySelector(tag)! as any\n1050\t+    host.formStateRestoreCallback('saved', 'restore')\n1051\t+    t.deepEqual(restored, ['saved', 'restore'],\n1052\t+        'restore handler received state and mode')\n1053\t+    form.remove()\n1054\t+})\n1055\t+\n1056\t+test('formLifecycle: second ctx.form() replaces first', t => {\n1057\t+    const form = document.createElement('form')\n1058\t+    const tag = 'fl-repl-' +\n1059\t+        Math.random().toString(36).slice(2, 8)\n1060\t+    form.innerHTML = `<${tag} name=\"rp\"></${tag}>`\n1061\t+    document.body.appendChild(form)\n1062\t+\n1063\t+    let first = 0\n1064\t+    let second = 0\n1065\t+    define(tag)\n1066\t+        .formAssociated()\n1067\t+        .setup(ctx => {\n1068\t+            ctx.form({ reset: () => { first++ } })\n1069\t+            ctx.form({ reset: () => { second++ } })\n1070\t+        })\n1071\t+\n1072\t+    form.reset()\n1073\t+    t.equal(first, 0, 'first handler not called')\n1074\t+    t.equal(second, 1, 'second handler called')\n1075\t+    form.remove()\n1076\t+})\n1077\t+\n1078\t+test('formLifecycle: handlers dropped after teardown',\n1079\t+    async t => {\n1080\t+        const form = document.createElement('form')\n1081\t+        const tag = 'fl-tear-' +\n1082\t+            Math.random().toString(36).slice(2, 8)\n1083\t+        form.innerHTML = `<${tag} name=\"td\"></${tag}>`\n1084\t+        document.body.appendChild(form)\n1085\t+\n1086\t+        let resets = 0\n1087\t+        define(tag)\n1088\t+            .formAssociated()\n1089\t+            .setup(ctx => {\n1090\t+                ctx.form({ reset: () => { resets++ } })\n1091\t+            })\n1092\t+\n1093\t+        form.reset()\n1094\t+        t.equal(resets, 1, 'handler called while connected')\n1095\t+\n1096\t+        const host = form.querySelector(tag)!\n1097\t+        host.remove()\n1098\t+        await Promise.resolve()\n1099\t+\n1100\t+        // The host's teardown ran; calling the callback directly\n1101\t+        // should not call the old handler.\n1102\t+        ;(host as any).formResetCallback?.()\n1103\t+        t.equal(resets, 1, 'handler not called after teardown')\n1104\t+        form.remove()\n1105\t+    })\n1106\t+\n1107\t+test('formLifecycle: restore replayed when handler registers' +\n1108\t+    ' late', t => {\n1109\t+    const form = document.createElement('form')\n1110\t+    const tag = 'fl-replay-' +\n1111\t+        Math.random().toString(36).slice(2, 8)\n1112\t+    form.innerHTML = `<${tag} name=\"rpl\"></${tag}>`\n1113\t+    document.body.appendChild(form)\n1114\t+\n1115\t+    let restored:[unknown, string]|null = null\n1116\t+    const host = form.querySelector(tag)! as any\n1117\t+\n1118\t+    const token = createContext<number>()\n1119\t+\n1120\t+    define(tag)\n1121\t+        .formAssociated()\n1122\t+        .withContexts(() => ({ c: token }))\n1123\t+        .setup(ctx => {\n1124\t+            ctx.form({\n1125\t+                restore: (state, mode) => {\n1126\t+                    restored = [state, mode]\n1127\t+                },\n1128\t+            })\n1129\t+        })\n1130\t+\n1131\t+    // Setup has not run because the context is missing.\n1132\t+    host.formStateRestoreCallback('early', 'restore')\n1133\t+    t.equal(restored, null,\n1134\t+        'restore not delivered before setup')\n1135\t+\n1136\t+    // Provide the context so setup runs.\n1137\t+    provide(form, token, 42)\n1138\t+    t.deepEqual(restored, ['early', 'restore'],\n1139\t+        'pending restore replayed')\n1140\t+    form.remove()\n1141\t+})\n1142\t+\n1143\t+test('formLifecycle: early reset/disabled not replayed', t => {\n1144\t+    const form = document.createElement('form')\n1145\t+    const tag = 'fl-norepl-' +\n1146\t+        Math.random().toString(36).slice(2, 8)\n1147\t+    form.innerHTML = `<${tag} name=\"nr\"></${tag}>`\n1148\t+    document.body.appendChild(form)\n1149\t+\n1150\t+    const host = form.querySelector(tag)! as any\n1151\t+    const token = createContext<number>()\n1152\t+\n1153\t+    let resets = 0\n1154\t+    const disabledCalls:boolean[] = []\n1155\t+\n1156\t+    define(tag)\n1157\t+        .formAssociated()\n1158\t+        .withContexts(() => ({ c: token }))\n1159\t+        .setup(ctx => {\n1160\t+            ctx.form({\n1161\t+                reset: () => { resets++ },\n1162\t+                disabled: (d) => { disabledCalls.push(d) },\n1163\t+            })\n1164\t+        })\n1165\t+\n1166\t+    // Setup has not run (context missing). Fire callbacks early.\n1167\t+    host.formResetCallback()\n1168\t+    host.formDisabledCallback(true)\n1169\t+\n1170\t+    // Now provide the context so setup runs.\n1171\t+    provide(form, token, 1)\n1172\t+\n1173\t+    // The early reset and disabled should NOT have been replayed.\n1174\t+    t.equal(resets, 0,\n1175\t+        'early reset not replayed')\n1176\t+    t.deepEqual(disabledCalls, [],\n1177\t+        'early disabled not replayed')\n1178\t+    form.remove()\n1179\t+})\n1180\t+\n1181\t+// -- form-associated: server render and hydration --\n1182\t+\n1183\t+test('formAssociated SSR: static HTML upgrade contributes to FormData', t => {\n1184\t+    const tag = 'fa-ssr-upgrade-' +\n1185\t+        Math.random().toString(36).slice(2, 8)\n1186\t+    const form = document.createElement('form')\n1187\t+    form.innerHTML =\n1188\t+        `<${tag} name=\"rating\"><span>5</span></${tag}>`\n1189\t+    document.body.appendChild(form)\n1190\t+\n1191\t+    define(tag)\n1192\t+        .withProps(p => ({ val: p.string() }))\n1193\t+        .formAssociated()\n1194\t+        .render(({ props }) =>\n1195\t+            bhtml`<span>${props.val}</span>`)\n1196\t+        .setup(ctx => {\n1197\t+            ctx.internals.setFormValue('5')\n1198\t+        })\n1199\t+\n1200\t+    const data = new FormData(form)\n1201\t+    t.equal(data.get('rating'), '5',\n1202\t+        'upgraded host contributes to FormData')\n1203\t+    form.remove()\n1204\t+})\n1205\t+\n1206\t+test('formAssociated SSR: static HTML upgrade runs reset handler', t => {\n1207\t+    const tag = 'fa-ssr-reset-' +\n1208\t+        Math.random().toString(36).slice(2, 8)\n1209\t+    const form = document.createElement('form')\n1210\t+    form.innerHTML =\n1211\t+        `<${tag} name=\"r\"><span>x</span></${tag}>`\n1212\t+    document.body.appendChild(form)\n1213\t+\n1214\t+    let resets = 0\n1215\t+    let currentVal = 'edited'\n1216\t+    define(tag)\n1217\t+        .withProps(p => ({ val: p.string() }))\n1218\t+        .formAssociated()\n1219\t+        .render(({ props }) =>\n1220\t+            bhtml`<span>${props.val}</span>`)\n1221\t+        .setup(ctx => {\n1222\t+            ctx.internals.setFormValue(currentVal)\n1223\t+            ctx.form({\n1224\t+                reset () {\n1225\t+                    resets++\n1226\t+                    currentVal = 'default'\n1227\t+                    ctx.internals.setFormValue('default')\n1228\t+                },\n1229\t+            })\n1230\t+        })\n1231\t+\n1232\t+    t.equal(\n1233\t+        new FormData(form).get('r'), 'edited',\n1234\t+        'before reset, value is edited'\n1235\t+    )\n1236\t+\n1237\t+    form.reset()\n1238\t+    t.equal(resets, 1, 'reset handler called once')\n1239\t+    t.equal(\n1240\t+        new FormData(form).get('r'), 'default',\n1241\t+        'after reset, value is default'\n1242\t+    )\n1243\t+    form.remove()\n1244\t+})\n1245\t+\n1246\t+test('formAssociated SSR: mount adoption gets internals and FormData', t => {\n1247\t+    const tag = 'fa-ssr-adopt-' +\n1248\t+        Math.random().toString(36).slice(2, 8)\n1249\t+\n1250\t+    let gotInternals:ElementInternals|undefined\n1251\t+    const El = define(tag)\n1252\t+        .withProps(p => ({ val: p.string() }))\n1253\t+        .formAssociated()\n1254\t+        .render(({ props }) =>\n1255\t+            bhtml`<span>${props.val}</span>`)\n1256\t+        .setup(ctx => {\n1257\t+            gotInternals = ctx.internals\n1258\t+            ctx.internals.setFormValue(ctx.props.val())\n1259\t+        })\n1260\t+\n1261\t+    const form = document.createElement('form')\n1262\t+    form.innerHTML =\n1263\t+        `<${tag} name=\"adopted\" val=\"hi\">` +\n1264\t+        `<span>hi</span></${tag}>`\n1265\t+    document.body.appendChild(form)\n1266\t+    const host = form.querySelector(tag)!\n1267\t+\n1268\t+    const val = signal('hi')\n1269\t+    mount(form, bhtml`<${El} name=\"adopted\" val=${val} />`)\n1270\t+\n1271\t+    t.ok(gotInternals, 'ctx.internals is present')\n1272\t+    t.equal(\n1273\t+        new FormData(form).get('adopted'), 'hi',\n1274\t+        'adopted host contributes to FormData'\n1275\t+    )\n1276\t+\n1277\t+    t.equal(form.querySelector(tag), host,\n1278\t+        'same host node was adopted')\n1279\t+    form.remove()\n1280\t+})\n1281\t+\n1282\t+test('formAssociated SSR: empty host with render link gets internals and FormData', t => {\n1283\t+    const tag = 'fa-ssr-empty-' +\n1284\t+        Math.random().toString(36).slice(2, 8)\n1285\t+\n1286\t+    let gotInternals:ElementInternals|undefined\n1287\t+    define(tag)\n1288\t+        .withProps(p => ({ val: p.string() }))\n1289\t+        .formAssociated()\n1290\t+        .render(({ props }) =>\n1291\t+            bhtml`<span>${props.val}</span>`)\n1292\t+        .setup(ctx => {\n1293\t+            gotInternals = ctx.internals\n1294\t+            ctx.internals.setFormValue(ctx.props.val())\n1295\t+        })\n1296\t+\n1297\t+    const form = document.createElement('form')\n1298\t+    form.innerHTML = `<${tag} name=\"empty\" val=\"ok\"></${tag}>`\n1299\t+    document.body.appendChild(form)\n1300\t+\n1301\t+    const host = form.querySelector(tag)!\n1302\t+    t.ok(host.querySelector('span'),\n1303\t+        'empty host was filled from renderParts')\n1304\t+    t.ok(gotInternals,\n1305\t+        'ctx.internals is present on empty host')\n1306\t+    t.equal(\n1307\t+        new FormData(form).get('empty'), 'ok',\n1308\t+        'empty host contributes to FormData'\n1309\t+    )\n1310\t+    form.remove()\n1311\t+})\n1312\t+\n1313\t import './preact-browser.js'\n1314\tdiff --git a/test/preact-browser.ts b/test/preact-browser.ts\n1315\tindex 2ad99f1..5b292aa 100644\n1316\t--- a/test/preact-browser.ts\n1317\t+++ b/test/preact-browser.ts\n1318\t@@ -117,6 +117,32 @@ test('preact browser: a mapped callback is called on the event', t => {\n1319\t     client.remove()\n1320\t })\n1321\t \n1322\t+// -- form-associated: toPreact in a form --\n1323\t+\n1324\t+const FAEl = define('preact-fa-el')\n1325\t+    .withProps(p => ({ val: p.string() }))\n1326\t+    .formAssociated()\n1327\t+    .render(({ props }) => html`<span>${props.val}</span>`)\n1328\t+    .setup(ctx => {\n1329\t+        ctx.internals.setFormValue(ctx.props.val())\n1330\t+    })\n1331\t+\n1332\t+const FAC = toPreact(FAEl)\n1333\t+\n1334\t+test('preact browser: form-associated toPreact contributes to FormData', t => {\n1335\t+    const form = document.createElement('form')\n1336\t+    document.body.appendChild(form)\n1337\t+    render(h(FAC, { val: 'hello' }), form)\n1338\t+    const host = form.querySelector('preact-fa-el')!\n1339\t+    host.setAttribute('name', 'fa-preact')\n1340\t+    t.ok(host, 'the form-associated host was created')\n1341\t+    const data = new FormData(form)\n1342\t+    t.equal(data.get('fa-preact'), 'hello',\n1343\t+        'form-associated host contributes to FormData')\n1344\t+    render(null, form)\n1345\t+    form.remove()\n1346\t+})\n1347\t+\n1348\t test('preact browser: children throw, naming the tag', t => {\n1349\t     const div = container()\n1350\t     let err:Error|null = null\n1351\tdiff --git a/test/ssr.ts b/test/ssr.ts\n1352\tindex 208c922..44e7ecb 100644\n1353\t--- a/test/ssr.ts\n1354\t+++ b/test/ssr.ts\n1355\t@@ -869,3 +869,57 @@ test('parity table: server output matches the expected HTML', t => {\n1356\t         )\n1357\t     }\n1358\t })\n1359\t+\n1360\t+// -- form-associated: server render --\n1361\t+\n1362\t+test('SSR: formAssociated does not change render output', t => {\n1363\t+    const renderFn = ({ props }:any) =>\n1364\t+        `<input value=\"${props.val}\" />`\n1365\t+\n1366\t+    const Plain = define('ssr-fa-plain')\n1367\t+        .withProps(p => ({ val: p.string() }))\n1368\t+        .render(renderFn)\n1369\t+        .setup(() => {})\n1370\t+\n1371\t+    const FA = define('ssr-fa-opted')\n1372\t+        .withProps(p => ({ val: p.string() }))\n1373\t+        .formAssociated()\n1374\t+        .render(renderFn)\n1375\t+        .setup(() => {})\n1376\t+\n1377\t+    const plainOut = Plain.render({ val: 'hello' })\n1378\t+    const faOut = FA.render({ val: 'hello' })\n1379\t+\n1380\t+    // The only difference should be the host tag name\n1381\t+    const normalize = (s:string) =>\n1382\t+        s.replace(/ssr-fa-(plain|opted)/g, 'ssr-fa-X')\n1383\t+    t.equal(normalize(faOut), normalize(plainOut),\n1384\t+        'render output is identical apart from tag name')\n1385\t+})\n1386\t+\n1387\t+test('SSR: formAssociated does not change renderParts output', t => {\n1388\t+    const renderFn = ({ props }:any) =>\n1389\t+        `<span>${props.n}</span>`\n1390\t+\n1391\t+    const Plain = define('ssr-fa-parts-plain')\n1392\t+        .withProps(p => ({ n: p.number() }))\n1393\t+        .render(renderFn)\n1394\t+        .setup(() => {})\n1395\t+\n1396\t+    const FA = define('ssr-fa-parts-opted')\n1397\t+        .withProps(p => ({ n: p.number() }))\n1398\t+        .formAssociated()\n1399\t+        .render(renderFn)\n1400\t+        .setup(() => {})\n1401\t+\n1402\t+    const plainParts = Plain.renderParts({ n: 42 })\n1403\t+    const faParts = FA.renderParts({ n: 42 })\n1404\t+\n1405\t+    t.equal(\n1406\t+        JSON.stringify(plainParts.attrs),\n1407\t+        JSON.stringify(faParts.attrs),\n1408\t+        'attrs are identical'\n1409\t+    )\n1410\t+    t.equal(plainParts.html, faParts.html,\n1411\t+        'inner html is identical')\n1412\t+})\n1413\tdiff --git a/test/types.ts b/test/types.ts\n1414\tindex 9c34d68..3e5e570 100644\n1415\t--- a/test/types.ts\n1416\t+++ b/test/types.ts\n1417\t@@ -11,6 +11,7 @@ import type {\n1418\t     Signal as PublicSignal,\n1419\t     Serialized as PublicSerialized,\n1420\t     RenderParts as PublicRenderParts,\n1421\t+    FormLifecycleHandlers as PublicFormLifecycleHandlers,\n1422\t } from 'microtags'\n1423\t import { bindProp } from 'microtags'\n1424\t import { signal, computed } from 'alien-signals'\n1425\t@@ -231,6 +232,52 @@ type _serializedShallow = Expect<Equal<\n1426\t     }\n1427\t >>\n1428\t \n1429\t+// formAssociated: ctx.internals is ElementInternals after opt-in.\n1430\t+define('mt-fa-types')\n1431\t+    .formAssociated()\n1432\t+    .setup(ctx => {\n1433\t+        expectAssignable<ElementInternals>(ctx.internals)\n1434\t+    })\n1435\t+\n1436\t+// formAssociated: ctx.internals is a type error without opt-in.\n1437\t+define('mt-fa-no-types')\n1438\t+    // @ts-expect-error: internals not available without formAssociated\n1439\t+    .setup(ctx => { ctx.internals })\n1440\t+\n1441\t+// formAssociated: composes with all other links.\n1442\t+define('mt-fa-compose-types')\n1443\t+    .withProps(p => ({ count: p.number() }))\n1444\t+    .withRefs(r => ({ out: r.one() }))\n1445\t+    .formAssociated()\n1446\t+    .setup(ctx => {\n1447\t+        expectAssignable<ElementInternals>(ctx.internals)\n1448\t+        expectAssignable<number>(ctx.props.count())\n1449\t+        expectAssignable<HTMLElement>(ctx.refs.out)\n1450\t+    })\n1451\t+\n1452\t+// formAssociated: ctx.form exists after opt-in.\n1453\t+define('mt-fa-form-types')\n1454\t+    .formAssociated()\n1455\t+    .setup(ctx => {\n1456\t+        ctx.form({\n1457\t+            reset: () => {},\n1458\t+            disabled: (_d:boolean) => {},\n1459\t+            restore: (_s, _m) => {},\n1460\t+            associated: (_f) => {},\n1461\t+        })\n1462\t+    })\n1463\t+\n1464\t+// formAssociated: ctx.form is a type error without opt-in.\n1465\t+define('mt-fa-no-form-types')\n1466\t+    // @ts-expect-error: form not available without formAssociated\n1467\t+    .setup(ctx => { ctx.form })\n1468\t+\n1469\t+// FormLifecycleHandlers is importable from 'microtags'.\n1470\t+type _flhExists = Expect<Equal<\n1471\t+    keyof PublicFormLifecycleHandlers,\n1472\t+    'reset' | 'disabled' | 'restore' | 'associated'\n1473\t+>>\n1474\t+\n1475\t // microtags/preact: the adapter's props are typed from the class.\n1476\t const PreactEl = define('types-preact')\n1477\t     .withProps(p => ({ count: p.number(), label: p.string() }))\n1478\t"}]},"parent_tool_use_id":null,"session_id":"a0808bba-c587-4af5-a19f-1b79dafa6769","uuid":"c807b6ff-7747-4923-a30f-4807bd1b08b1","timestamp":"2026-11-24T10:10:06.128Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/.claude/projects/-Users-nick-code-microtags-review/a0808bba-c587-4af5-a19f-1b79dafa6769/tool-results/bqzhzehmg.txt","content":"diff --git a/.size-limit.js b/.size-limit.js\nindex 31b95f1..5491244 100644\n--- a/.size-limit.js\n+++ b/.size-limit.js\n@@ -8,9 +8,12 @@ export default [\n         // renderParts static; 4.06 kB with an empty host rendered\n         // through a kept render link (ADR-011); 4.03 kB with comments\n         // counted as content; 4.04 kB skipping define for a tag that\n-        // is already registered, rounded up to the next\n-        // 0.05 kB\n-        limit: '4.1 kB',\n+        // is already registered; 4.04 kB after builder config object\n+        // refactor (positional args -> single config); 4.09 kB with\n+        // form-associated custom element support (ADR-012); 4.23 kB\n+        // with form lifecycle handlers (ctx.form), rounded up to the\n+        // next 0.05 kB\n+        limit: '4.25 kB',\n     },\n     {\n         name: 'microtags/htm',\ndiff --git a/AGENTS.md b/AGENTS.md\nindex 5c16637..a15eb80 100644\n--- a/AGENTS.md\n+++ b/AGENTS.md\n@@ -518,6 +518,32 @@ tapout run, so tests for it capture the queued task with the\n `insertBefore` fallback in Chromium, set `moveBefore` to `undefined` on\n the parent instance.\n \n+### Form-associated components (`src/builders.ts`, `src/factory.ts`, ADR-012)\n+\n+`.formAssociated()` in the builder chain sets a `formAssociated` flag\n+on `BuilderConfig`. The factory reads it, defines `static\n+formAssociated = true` on the class (before `customElements.define`),\n+and calls `attachInternals()` once in the constructor. The\n+`ElementInternals` is stored on `_internals` and reused across\n+reconnect cycles. `makeSetupContext` receives it as an optional\n+parameter and attaches it to the context object only when present.\n+\n+The `ComponentBuilder` carries a `FormAssoc` type parameter\n+(default `false`). The setup callback's context type is intersected\n+with `FormAssociatedContext` when `FormAssoc` is `true`, so\n+`ctx.internals` is a type error without the opt-in.\n+\n+`ctx.form(handlers)` registers handlers for `formResetCallback`,\n+`formDisabledCallback`, `formStateRestoreCallback` and\n+`formAssociatedCallback`. Handlers are stored on instance properties\n+`_fh` (the handlers object) and `_fp` (a pending restore tuple).\n+The prototype callbacks are defined with `function` (not arrow) so\n+`this` refers to the host. Handlers are cleared in teardown by\n+setting `_fh = undefined`. A `restore` callback received before\n+`ctx.form()` is stored in `_fp` and replayed when the handler\n+registers; `reset`, `disabled` and `associated` are not replayed.\n+`FormLifecycleHandlers` is a public type export from `microtags`.\n+\n <!-- redeye:start -->\n ## Agent skills\n \ndiff --git a/CONTEXT.md b/CONTEXT.md\nindex 30424f0..be0661b 100644\n--- a/CONTEXT.md\n+++ b/CONTEXT.md\n@@ -25,7 +25,7 @@ _Avoid_: pipeline, config\n \n **Link**:\n One call in the builder chain: `withProps`, `withRefs`, `withContexts`,\n-or `render`. `setup` is the terminal link.\n+`formAssociated`, or `render`. `setup` is the terminal link.\n _Avoid_: step, method (in prose)\n \n **Prop**:\ndiff --git a/README.md b/README.md\nindex 640c4e4..5a39678 100644\n--- a/README.md\n+++ b/README.md\n@@ -51,6 +51,7 @@ This package adds some provisions for serverside rendering.\n   * [`builder.withRefs(fn)`](#builderwithrefsfn)\n   * [`builder.withContexts`](#builderwithcontexts)\n     + [`.withContexts` Example](#withcontexts-example)\n+  * [`builder.formAssociated()`](#builderformassociated)\n   * [`builder.render(fn, options?)`](#builderrenderfn-options)\n   * [`builder.setup(ctx)`](#buildersetupctx)\n     + [`ctx`](#ctx)\n@@ -556,11 +557,13 @@ The object returned by [`define`](#define). Includes methods:\n | `.withProps(fn)` | `ComponentBuilder` | Declare reactive attributes. See [Props](#props). |\n | `.withRefs(fn)` | `ComponentBuilder` | Declare DOM refs resolved once the element connects. See [Refs](#refs-1). |\n | `.withContexts(fn)` | `ComponentBuilder` | Consume context values published by an ancestor. See [`withContexts`](#withcontexts). |\n+| `.formAssociated()` | `ComponentBuilder` | Make hosts form-associated custom elements. See [`.formAssociated`](#builderformassociated). |\n | `.render(fn, opts?)` | `ComponentBuilder` | Attach a server-render function. See [`.render`](#builderrenderfn-options) below. Not to be confused with the DOM helper [`microtags/render`](#microtagsrender). |\n | `.setup(fn)` | `MicrotagElementClass` | Registers the custom element and returns its class. See [`setup`](#setup) below. |\n \n-Methods `withProps`, `withRefs`, and `withContexts` each return a new builder,\n-so they chain in any order; `setup` ends the chain by registering the element.\n+Methods `withProps`, `withRefs`, `withContexts` and `formAssociated` each\n+return a new builder, so they chain in any order; `setup` ends the chain by\n+registering the element.\n \n ---------------------------------------------------------\n \n@@ -778,6 +781,68 @@ define('themed-card')\n \n ---------------------------------------------------------\n \n+### `builder.formAssociated()`\n+\n+Make hosts of this component form-associated custom elements. The host\n+gets an `ElementInternals` object, available in setup as\n+`ctx.internals`. With it the component can call `setFormValue`,\n+`setValidity`, set ARIA defaults, and participate in the containing\n+form.\n+\n+```ts\n+class ComponentBuilder {\n+    formAssociated ():ComponentBuilder<\n+        Props, RefDefs, CtxDefs, true\n+    >\n+}\n+```\n+\n+A form-associated host:\n+\n+- contributes a value to `FormData` under its `name` attribute\n+- takes part in constraint validation (`:valid` / `:invalid`)\n+- follows `disabled` from an ancestor `<fieldset>`\n+- exposes `ctx.internals.form` as the enclosing form\n+\n+```ts\n+const RatingInput = define('rating-input')\n+    .withProps(p => ({ value: p.number() }))\n+    .formAssociated()\n+    .setup(ctx => {\n+        ctx.internals.role = 'slider'\n+        ctx.effect(() => {\n+            ctx.internals.setFormValue(\n+                String(ctx.props.value())\n+            )\n+        })\n+    })\n+```\n+\n+#### `ctx.form(handlers)`\n+\n+Register handlers for the form lifecycle callbacks. All four are\n+optional:\n+\n+```ts\n+ctx.form({\n+    reset () { /* form was reset */ },\n+    disabled (isDisabled) { /* fieldset toggled */ },\n+    restore (state, mode) { /* autocomplete / back-forward */ },\n+    associated (form) { /* moved into or out of a form */ },\n+})\n+```\n+\n+Calling `ctx.form()` again replaces the earlier handlers. Handlers\n+are dropped when the host tears down. A `restore` callback that fires\n+before setup has registered a handler is replayed once the handler is\n+set; `reset`, `disabled` and `associated` are not replayed because\n+their state is readable at setup time (`host.matches(':disabled')`,\n+`ctx.internals.form`).\n+\n+Components that do not call `.formAssociated()` behave exactly as\n+before and do not appear in `FormData`.\n+\n+---------------------------------------------------------\n \n ### `builder.render(fn, options?)`\n \ndiff --git a/docs/adr/ADR-012-form-associated-components.md b/docs/adr/ADR-012-form-associated-components.md\nnew file mode 100644\nindex 0000000..754293c\n--- /dev/null\n+++ b/docs/adr/ADR-012-form-associated-components.md\n@@ -0,0 +1,85 @@\n+# ADR-012: Form-associated custom elements\n+\n+**Date:** 2026-11-24\n+\n+**Status:** Accepted\n+\n+**Related:** [ADR-004][adr-004] (client size)\n+\n+## Context\n+\n+A component author who wants to build a form control (a custom input,\n+a rich text field, a rating widget) cannot make it a real form control\n+with microtags. The platform way is a form-associated custom element:\n+the class sets a static `formAssociated = true`, each host gets an\n+`ElementInternals` from `attachInternals()`, and the browser wires it\n+into the containing form for submission, validation, and disabled\n+state. Microtags calls `customElements.define` inside `setup()` with\n+no way to set the static first, and does not expose\n+`ElementInternals` to the setup callback.\n+\n+The first consumer is `markdown-area`, a `<textarea>` replacement.\n+\n+## Decision\n+\n+A new builder link, `.formAssociated()`, opts a component into the\n+platform's form-associated custom element behaviour. It takes no\n+arguments.\n+\n+- **Builder link.** `.formAssociated()` returns a new builder with an\n+  internal `formAssociated` flag. The flag propagates through all\n+  subsequent links. It composes with `withProps`, `withRefs`,\n+  `withContexts` and `render` in any order.\n+\n+- **Static.** The factory sets `static formAssociated = true` on the\n+  generated class before the builder calls `customElements.define`,\n+  so the browser reads it at define time.\n+\n+- **Internals.** A form-associated host calls `attachInternals()`\n+  once, in its constructor. The result is kept on the instance and\n+  reused across disconnect/reconnect cycles. Setup receives it as\n+  `ctx.internals`.\n+\n+- **Setup context.** For a form-associated component the setup context\n+  gains `internals:ElementInternals`. Components that did not opt in\n+  get a type error when they read `ctx.internals`.\n+\n+- **Form lifecycle callbacks.** The class installs\n+  `formResetCallback`, `formDisabledCallback`,\n+  `formStateRestoreCallback` and `formAssociatedCallback` on the\n+  prototype. Each forwards to handlers registered through the\n+  `ctx.form(handlers)` method. The `restore` callback is replayed\n+  when a handler is registered; the others are not (their state is\n+  readable from the host and `internals`). Calling `ctx.form()` again\n+  replaces the earlier handlers. Handlers are dropped on teardown.\n+\n+- **Server render.** `render-support` is unchanged: form association\n+  has no server-side meaning.\n+\n+- **Types.** `FormAssociatedContext` is a public type export from\n+  `microtags`, so declaration emit in consuming packages does not hit\n+  TS2883. The builder carries a `FormAssoc` type parameter that\n+  controls whether the setup context includes `internals`.\n+\n+## Size cost\n+\n+| Entry | Before | After | Delta |\n+|-------|--------|-------|-------|\n+| `microtags` (core, ticket 02) | 4.04 kB | 4.09 kB | +50 B |\n+| `microtags` (core, ticket 03) | 4.09 kB | 4.23 kB | +140 B |\n+\n+The ticket 02 delta (50 B) covers the `formAssociated` static, the\n+`attachInternals()` call in the constructor, and passing internals to\n+the setup context. The ticket 03 delta (140 B) adds four prototype\n+callbacks, `ctx.form()` with handler storage, and restore replay.\n+Both are under the 150 B-per-ticket target.\n+\n+## Consequences\n+\n+- Authors can build form controls that submit values, participate in\n+  constraint validation, follow `disabled` from ancestor fieldsets,\n+  and hear about form reset and state restore.\n+- Components that do not opt in pay no runtime cost and no API change.\n+- The core entry limit rises from 4.1 kB to 4.25 kB.\n+\n+[adr-004]: ADR-004-client-bundle-size-outranks-ergonomics.md\ndiff --git a/docs/adr/INDEX.md b/docs/adr/INDEX.md\nindex 374a97c..6dcaf45 100644\n--- a/docs/adr/INDEX.md\n+++ b/docs/adr/INDEX.md\n@@ -17,6 +17,7 @@ consume these and `CONTEXT.md` for the project glossary.\n | [ADR-009][adr-009] | Server render support loaded through the render link (amends ADR-005) | 2026-10-14 |\n | [ADR-010][adr-010] | Preact owns the host, the element owns its children | 2026-11-08 |\n | [ADR-011][adr-011] | Core renders an empty host with a kept render link (amends ADR-010) | 2026-11-10 |\n+| [ADR-012][adr-012] | Form-associated custom elements | 2026-11-24 |\n \n [adr-006]: ADR-006-hono-html-scaffold.md\n [adr-007]: ADR-007-client-templater.md\n@@ -24,3 +25,4 @@ consume these and `CONTEXT.md` for the project glossary.\n [adr-009]: ADR-009-server-render-support-through-render-link.md\n [adr-010]: ADR-010-preact-adapter-ownership-split.md\n [adr-011]: ADR-011-core-renders-empty-host.md\n+[adr-012]: ADR-012-form-associated-components.md\ndiff --git a/src/builders.ts b/src/builders.ts\nindex a9b1612..8a160d8 100644\n--- a/src/builders.ts\n+++ b/src/builders.ts\n@@ -6,6 +6,7 @@ import type {\n     PropType,\n     PropertyOnlyProp,\n     SetupContext,\n+    FormAssociatedContext,\n     Coercer,\n     RefDef,\n     SingleRefDef,\n@@ -204,46 +205,48 @@ export type MicrotagElementClass<\n  * Fluent builder that accumulates props/refs/contexts config\n  * before registering a custom element via `.setup()`.\n  */\n+interface BuilderConfig {\n+    tag:string\n+    coercers:Record<string, Coercer<unknown>>\n+    observed:string[]\n+    propNames:string[]\n+    propMetas:Record<string, PropMeta>\n+    refDefs:Record<string, RefDef>\n+    ctxDefs:Record<string, ContextToken<unknown>>\n+    renderFn?:RenderFn<any, any>\n+    formAssociated?:boolean\n+}\n+\n export class ComponentBuilder<\n     Props extends Record<string, PropDef> = Record<never, never>,\n     RefDefs extends Record<string, RefDef> = Record<never, never>,\n-    CtxDefs extends Record<string, ContextToken<unknown>> = Record<never, never>,\n+    CtxDefs extends Record<string, ContextToken<unknown>> = (\n+        Record<never, never>\n+    ),\n+    FormAssoc extends boolean = false,\n > {\n-    private readonly _coercers:Record<string, Coercer<unknown>>\n-    private readonly _observed:string[]\n-    private readonly _propNames:string[]\n-    private readonly _propMetas:Record<string, PropMeta>\n-    private readonly _refDefs:Record<string, RefDef>\n-    private readonly _ctxDefs:Record<string, Conte