p.formAssociatedCallback = function (\n+            f:HTMLFormElement|null\n+        ) {\n+            this._fh?.associated?.(f)\n+        }\n+        p.formStateRestoreCallback = function (\n+            s:unknown, m:string\n+        ) {\n+            if (this._fh?.restore) {\n+                this._fh.restore(s as FormData|string|null, m)\n+            } else {\n+                this._fp = [s, m]\n+            }\n+        }\n+    }\n+\n     // One accessor per prop. A function value is taken to be a signal\n     // and bound; anything else unbinds and writes the prop.\n     for (const name of Object.keys(propDefs)) {\ndiff --git a/src/index.ts b/src/index.ts\nindex 5fff686..0b6b5f1 100644\n--- a/src/index.ts\n+++ b/src/index.ts\n@@ -1,7 +1,13 @@\n export { peek, untracked } from './reactivity.js'\n export { define } from './builders.js'\n export { bindProp } from './factory.js'\n-export type { Serialized, Signal, TypedEvent } from './types.js'\n+export type {\n+    Serialized,\n+    Signal,\n+    TypedEvent,\n+    FormAssociatedContext,\n+    FormLifecycleHandlers,\n+} from './types.js'\n export type {\n     MicrotagElementClass,\n     MicrotagHost,\ndiff --git a/src/setup-context.ts b/src/setup-context.ts\nindex 902209a..399f2f8 100644\n--- a/src/setup-context.ts\n+++ b/src/setup-context.ts\n@@ -7,6 +7,7 @@ import type {\n     PropDef,\n     ContextToken,\n     BindOptions,\n+    FormLifecycleHandlers,\n } from './types.js'\n \n /**\n@@ -21,9 +22,10 @@ export function makeSetupContext<\n     props:PropsSignals<Props>,\n     refs:Record<string, Element | Element[]>,\n     contexts:Record<string, unknown>,\n-    cleanups:(() => void)[]\n+    cleanups:(() => void)[],\n+    internals?:ElementInternals\n ):SetupContext<Props, any, any> {\n-    return {\n+    const ctx:SetupContext<Props, any, any> = {\n         host,\n         props,\n         refs,\n@@ -116,4 +118,17 @@ export function makeSetupContext<\n             return sig ? sig() : undefined\n         },\n     