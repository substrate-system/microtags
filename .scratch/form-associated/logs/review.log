known>\n                    writable(el[boundProp])\n                }\n                control.addEventListener(event, handler)\n                cleanups.push(() => {\n                    control.removeEventListener(event, handler)\n                })\n            }\n\n            const dispose = effect(() => {\n                el[boundProp] = source()\n            })\n            cleanups.push(dispose)\n        },\n\n        onCleanup (fn) {\n            cleanups.push(fn)\n        },\n\n        consume<T> (token:ContextToken<T>):T | undefined {\n            const sig = resolveContextSignal(host, token)\n            return sig ? sig() : undefined\n        },\n    }\n    if (internals) {\n        const el = host as any\n        ;(ctx as any).internals = internals\n        ;(ctx as any).form = (h:FormLifecycleHandlers) => {\n            el._fh = h\n            if (el._fp && h.restore) {\n                const [s, m] = el._fp\n                el._fp = undefined\n                h.restore(s as FormData|string|null, m)\n            }\n        }\n    }\n    return ctx\n}\n","numLines":135,"startLine":1,"totalLines":135}},"tool_result_meta":[{"id":"toolu_01N3ECaJX1s5zTZqAiikLh3v","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
