\n+            value: Object.freeze([...c.propNames]),\n             enumerable: true,\n         })\n \n-        if (this._renderFn) {\n+        if (c.renderFn) {\n             const rec:RenderRecord = {\n-                t: this.tagName,\n-                m: this._propMetas,\n+                t: c.tag,\n+                m: c.propMetas,\n                 r: Object.freeze({ ...refNames }),\n-                f: this._renderFn,\n+                f: c.renderFn,\n             }\n             // One helper per registry key, so both statics share the\n             // lookup and the error.\n@@ -403,9 +404,9 @@ export class ComponentBuilder<\n         // keeps its first class, since define would throw.\n         if (\n             typeof customElements !== 'undefined' &&\n-            !customElements.get(this.tagName)\n+            !customElements.get(c.tag)\n         ) {\n-            customElements.define(this.tagName, El)\n+            customElements.define(c.tag, El)\n         }\n         return El as unknown as MicrotagElementClass<Props, RefDefs>\n     }\ndiff --git a/src/factory.ts b/src/factory.ts\nindex c5dbe6e..0031d5a 100644\n--- a/src/factory.ts\n+++ b/src/factory.ts\n@@ -12,6 +12,7 @@ import type {\n     Coercer,\n     ContextToken,\n     RefDef,\n+    FormLifecycleHandlers,\n } from './types.js'\n \n /**\n@@ -41,6 +42,8 @@ export interface FactoryConfig<Props extends FactoryProps = FactoryProps> {\n     refs?:Record<string, RefDef>\n     /** Context tokens keyed by name. */\n     contexts?:Record<string, ContextToken<unknown>>\n+    /** Make the host a form-associated custom element. */\n+    formAssociated?:boolean\n     /** Setup callback receiving the component context. */\n     setup:(ctx:SetupContext<Props, any, any>) => void\n }\n@@ -90,6 +93,7 @@ export function factory<Props extends FactoryProps = FactoryProps> (\n         setup,\n         refs: refDefs = {},\n         contexts: ctxDefs = {},\n+        formAssociated: isFormAssociated,\n     } = config\